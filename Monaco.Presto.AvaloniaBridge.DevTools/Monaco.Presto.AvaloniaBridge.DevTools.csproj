<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Monaco.Presto.AvaloniaBridge.DevTools</RootNamespace>
    <PackageTags>animation;devtools;inspector;avalonia;animejs</PackageTags>
    <Description>An in-app inspector for Monaco.Presto on Avalonia: freeze, step and slow the engine and watch what it runs.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Monaco.Presto.AvaloniaBridge\Monaco.Presto.AvaloniaBridge.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Monaco.Presto.AvaloniaBridge.Tests" />
  </ItemGroup>

</Project>
