<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Monaco.Presto.AvaloniaBridge.Lottie</RootNamespace>
    <PackageTags>animation;lottie;skottie;avalonia;animejs</PackageTags>
    <Description>Lottie playback for Monaco.Presto on Avalonia, drawn through SkiaSharp.Skottie.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="SkiaSharp.Skottie" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Monaco.Presto.AvaloniaBridge\Monaco.Presto.AvaloniaBridge.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Monaco.Presto.AvaloniaBridge.Tests" />
  </ItemGroup>

</Project>
