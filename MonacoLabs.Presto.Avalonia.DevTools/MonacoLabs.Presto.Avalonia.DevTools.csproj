<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MonacoLabs.Presto.DevTools</RootNamespace>
    <PackageTags>animation;devtools;inspector;avalonia;animejs</PackageTags>
    <Description>An in-app inspector for MonacoLabs.Presto on Avalonia: freeze, step and slow the engine and watch what it runs.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MonacoLabs.Presto.Avalonia\MonacoLabs.Presto.Avalonia.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MonacoLabs.Presto.Avalonia.Tests" />
  </ItemGroup>

</Project>
