<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MonacoLabs.Presto.Lottie</RootNamespace>
    <PackageTags>animation;lottie;skottie;avalonia;animejs</PackageTags>
    <Description>Lottie playback for MonacoLabs.Presto on Avalonia, drawn through SkiaSharp.Skottie.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="SkiaSharp.Skottie" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MonacoLabs.Presto.Avalonia\MonacoLabs.Presto.Avalonia.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MonacoLabs.Presto.Avalonia.Tests" />
  </ItemGroup>

</Project>
