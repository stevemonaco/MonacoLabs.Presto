<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <TargetFramework>net11.0-browser</TargetFramework>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Browser" />
    <!-- Lifts Lottie's transitive Skottie to the SkiaSharp 4 that Avalonia.Browser resolves here (Directory.Packages.props). -->
    <PackageReference Include="SkiaSharp.Skottie" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PrestoGallery\PrestoGallery.csproj" />
  </ItemGroup>

  <Import Project="..\..\BrowserDownloadSizes.targets" />
</Project>
