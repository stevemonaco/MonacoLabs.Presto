<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <!-- SkiaSharp's WASM natives predate .NET 11's Emscripten 6 (undefined saveSetjmp at link). -->
    <TargetFramework>net10.0-browser</TargetFramework>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Browser" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PrestoGallery\PrestoGallery.csproj" />
  </ItemGroup>

  <Import Project="..\..\BrowserDownloadSizes.targets" />
</Project>
