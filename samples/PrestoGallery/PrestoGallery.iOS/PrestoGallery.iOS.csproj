<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>13.0</SupportedOSPlatformVersion>
    <!-- Publish only: on Windows the RC2 iOS SDK fails a plain build with PublishAot set (missing linked\Link.semaphore). -->
    <PublishAot Condition="'$(_IsPublishing)' == 'true'">true</PublishAot>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.iOS" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PrestoGallery\PrestoGallery.csproj" />
  </ItemGroup>
</Project>
