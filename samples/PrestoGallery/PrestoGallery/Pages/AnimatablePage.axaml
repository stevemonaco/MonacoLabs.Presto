<showcase:ShowcasePage xmlns="https://github.com/avaloniaui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:showcase="clr-namespace:PrestoGallery.Showcase"
                       xmlns:vm="clr-namespace:PrestoGallery.ViewModels"
                       mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="600"
                       x:Class="PrestoGallery.Pages.AnimatablePage">
    <showcase:ShowcasePage.Styles>
        <!-- A circle would hide the Rotate the animatable writes. -->
        <Style Selector="Border.dot">
            <Setter Property="CornerRadius" Value="3" />
        </Style>
    </showcase:ShowcasePage.Styles>

    <ScrollViewer>
        <StackPanel Spacing="12">
            <Border x:Name="ParticleStage" Classes="stage" Height="330" PointerMoved="MoveParticles">
                <UniformGrid x:Name="Particles" Rows="11" Columns="11" Width="242" Height="242"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <showcase:CodePanel Code="{x:Static showcase:Snippets.AnimatableParticles}" />

            <TextBlock Classes="caption" TextWrapping="Wrap"
                       Text="Move the pointer over the grid. One animatable drives all 121 dots: their X and Y durations come from a center-out stagger of 50 ms per grid step, so the middle dot is written straight through, the edges take 250 ms and the corners about 350 ms, each settling on outElastic(.3, 1.4). Rotate is registered with Duration = 0 and so is never animated — the bridge's Rotate shorthand is in degrees, so the angle to the cursor goes through Utils.RadToDeg." />

            <Border x:Name="FollowerStage" Classes="stage" MinHeight="0" Height="150" PointerMoved="MoveFollower">
                <Border x:Name="Follower" Classes="dot" Width="28" Height="28" CornerRadius="14"
                        HorizontalAlignment="Center" />
            </Border>

            <showcase:CodePanel Code="{x:Static showcase:Snippets.AnimatableFollower}" />

            <TextBlock Classes="caption" TextWrapping="Wrap"
                       Text="The same API with one duration for both axes: every pointer move re-aims a 500 ms Out(3) tween from wherever the dot currently is. Set takes its own duration and ease when a single move should differ, and Revert drops the animation-priority values and leaves later Set calls as no-ops." />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Set(&quot;X&quot;, -140, 1200, &quot;inOutQuad&quot;)" Click="SetExplicit" />
                <Button Content="Fling()" Click="FlingFollower" />
                <Button Content="Revert()" Click="RevertFollower" />
            </StackPanel>

            <showcase:CodePanel Code="{x:Static showcase:Snippets.AnimatableFling}" />

            <TextBlock Classes="caption" TextWrapping="Wrap"
                       Text="Press Set, then Fling while the dot moves: Fling measures the running tween's velocity and coasts from it, bouncing off the stage edge." />

            <Border Classes="stage" MinHeight="0" Height="150">
                <Border x:Name="Ball" Classes="dot" Width="28" Height="28" CornerRadius="14"
                        HorizontalAlignment="Left" VerticalAlignment="Bottom" />
            </Border>

            <Button Content="Toss" Click="Toss" />

            <showcase:CodePanel x:Name="TossCode" Code="{x:Static showcase:Snippets.AnimatableToss}" />

            <TextBlock Classes="caption" TextWrapping="Wrap"
                       Text="A Projectile to-value flies from a launch velocity under constant acceleration, resolved in closed form when the tween starts, the way Inertia is. Launch splits the throw into X and Y with gravity on Y only, and a duration of twice the time to the top brings the ball back down to the floor it left. Each Toss starts again from the corner." />

            <Border x:Name="MomentumStage" Classes="stage" MinHeight="0" Height="150" PointerMoved="MoveMomentum">
                <Grid RowDefinitions="*,*">
                    <Border x:Name="MomentumDot" Classes="dot" Width="28" Height="28" CornerRadius="14"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Border x:Name="RestDot" Grid.Row="1" Classes="dot" Width="28" Height="28" CornerRadius="14" Opacity=".45"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <showcase:CodePanel Code="{x:Static showcase:Snippets.AnimatableSprings}" />

            <TextBlock Classes="caption" TextWrapping="Wrap"
                       Text="Flick the pointer left and right across the stage. Both dots follow it on the same spring, but only the top one keeps its momentum: PreserveVelocity starts each retargeted spring with the velocity the dot already has, so it swings through the turn the way a thrown weight would. The faded dot starts every new spring from rest and stops dead each time the pointer changes direction. PreserveVelocity is opt-in." />
            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Classes="caption" VerticalAlignment="Center" Text="A spring chase that is thrown on release, and springs compared with tweens:" />
                <HyperlinkButton x:DataType="vm:MainViewModel" Padding="0" FontSize="12" VerticalAlignment="Center"
                                 Content="Springs" Command="{Binding OpenCommand}" CommandParameter="Springs" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</showcase:ShowcasePage>
