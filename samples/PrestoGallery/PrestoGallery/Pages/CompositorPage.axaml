<showcase:ShowcasePage xmlns="https://github.com/avaloniaui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:presto="https://github.com/stevemonaco/MonacoLabs.Presto"
                       xmlns:showcase="clr-namespace:PrestoGallery.Showcase"
                       mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="640"
                       x:Class="PrestoGallery.Pages.CompositorPage">
    <showcase:ShowcasePage.Styles>
        <Style Selector="Border.orbit">
            <Setter Property="Background" Value="{x:Static showcase:Palette.Background}" />
            <Setter Property="BorderBrush" Value="{x:Static showcase:Palette.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="StackPanel.specimen > Panel">
            <Setter Property="Height" Value="64" />
        </Style>
        <Style Selector="StackPanel.specimen > TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="StackPanel.lane">
            <Setter Property="Spacing" Value="6" />
            <Setter Property="Width" Value="200" />
        </Style>
        <Style Selector="StackPanel.lane > TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Border.lane">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="8,0" />
        </Style>
        <Style Selector="Border.dot">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="{x:Static showcase:Palette.Aqua}" />
        </Style>
        <Style Selector="Border.dot.unfit">
            <Setter Property="Background" Value="{x:Static showcase:Palette.Coral}" />
        </Style>
    </showcase:ShowcasePage.Styles>

    <StackPanel Spacing="16">
        <Border Classes="stage">
            <StackPanel Spacing="28" HorizontalAlignment="Center">
                <WrapPanel ItemSpacing="32" LineSpacing="6" HorizontalAlignment="Center">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="eyebrow showcase" Text="RENDER THREAD" />
                        <Border Classes="orbit">
                            <presto:CompositorCanvas x:Name="Orbit" Width="200" Height="200" />
                        </Border>
                        <TextBlock Classes="caption" Text="CompositorScene, its own engine" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Classes="eyebrow showcase" Text="UI THREAD" />
                        <Border Classes="orbit">
                            <Canvas x:Name="UiOrbit" Width="200" Height="200" />
                        </Border>
                        <showcase:FpsMeter />
                    </StackPanel>
                </WrapPanel>

                <WrapPanel ItemSpacing="28" LineSpacing="6" HorizontalAlignment="Center">
                    <StackPanel Classes="specimen" Spacing="6">
                        <Panel>
                            <Button x:Name="PulseButton" Classes="specimen" Content="Button" />
                        </Panel>
                        <TextBlock Classes="caption" Text="Scale" />
                    </StackPanel>

                    <StackPanel Classes="specimen" Spacing="6">
                        <Panel>
                            <Border x:Name="BobCard" Classes="specimen">
                                <StackPanel>
                                    <TextBlock Text="Card" FontWeight="SemiBold" />
                                    <TextBlock Classes="caption" Text="text rides along" />
                                </StackPanel>
                            </Border>
                        </Panel>
                        <TextBlock Classes="caption" Text="Y" />
                    </StackPanel>

                    <StackPanel Classes="specimen" Spacing="6">
                        <Panel>
                            <PathIcon x:Name="Gear" Data="{StaticResource GearIcon}" Width="40" Height="40"
                                      Foreground="{x:Static showcase:Palette.AccentBright}" />
                        </Panel>
                        <TextBlock Classes="caption" Text="Rotate" />
                    </StackPanel>

                    <StackPanel Classes="specimen" Spacing="6">
                        <Panel>
                            <ToggleSwitch x:Name="BreatheToggle" IsChecked="True" OnContent="On" OffContent="Off"
                                          VerticalAlignment="Center" />
                        </Panel>
                        <TextBlock Classes="caption" Text="Opacity" />
                    </StackPanel>

                    <StackPanel Classes="specimen" Spacing="6">
                        <Panel>
                            <ProgressBar IsIndeterminate="True" Width="96" VerticalAlignment="Center" />
                        </Panel>
                        <TextBlock Classes="caption" Text="ProgressBar, UI thread" />
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </Border>

        <WrapPanel ItemSpacing="8" LineSpacing="8" HorizontalAlignment="Left">
            <Button Classes="accent" Content="Freeze UI thread for 2 s" Click="Freeze" />
            <Button Content="Pause" Click="PauseMotions" />
            <Button Content="Resume" Click="ResumeMotions" />
            <Button Content="Reverse" Click="ReverseMotions" />
            <TextBlock Classes="caption" Text="speed" VerticalAlignment="Center" />
            <Slider Width="120" Minimum="0.25" Maximum="3" Value="1"
                    VerticalAlignment="Center" ValueChanged="SpeedChanged" />
        </WrapPanel>

        <TextBlock Text="Choosing the thread" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,0" />
        <TextBlock Classes="caption" TextWrapping="Wrap"
                   Text="One builder fits the compositor and one adds Blur, which it lacks. Each plays under the three AnimationThread modes; freeze the UI thread and only the render-thread dots keep moving." />
        <Border Classes="stage">
            <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Center">
                <Grid x:Name="ThreadGrid" ColumnDefinitions="Auto,Auto,Auto,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="20" RowSpacing="12">
                    <TextBlock Grid.Column="1" Classes="eyebrow showcase" Text="UIThread" />
                    <TextBlock Grid.Column="2" Classes="eyebrow showcase" Text="Compositor" />
                    <TextBlock Grid.Column="3" Classes="eyebrow showcase" Text="PreferCompositor" />
                    <TextBlock Grid.Row="1" Classes="caption" Margin="0,10,0,0" Text="X · fits" />
                    <TextBlock Grid.Row="2" x:Name="UnfitLabel" Classes="caption" Margin="0,10,0,0" />
                </Grid>
            </Viewbox>
        </Border>
        <showcase:CodePanel x:Name="ThreadCode" />
    </StackPanel>
</showcase:ShowcasePage>
