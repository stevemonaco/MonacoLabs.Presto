<showcase:ShowcasePage xmlns="https://github.com/avaloniaui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:showcase="clr-namespace:PrestoGallery.Showcase"
                       mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="600"
                       x:Class="PrestoGallery.Pages.KeyframesPage">
    <ScrollViewer>
        <StackPanel Spacing="12">
            <StackPanel Spacing="4">
                <showcase:CodePanel x:Name="PerPropertyCode" />
                <Border Classes="demo">
                    <Button x:Name="PerPropertyButton" Classes="specimen">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource PlayIcon}" />
                            <TextBlock Text="Play" />
                        </StackPanel>
                    </Button>
                </Border>
            </StackPanel>

            <StackPanel Spacing="4">
                <showcase:CodePanel x:Name="ArrayCode" />
                <Border Classes="demo">
                    <ToggleSwitch x:Name="ArrayToggle" IsChecked="True" HorizontalAlignment="Left" VerticalAlignment="Center" />
                </Border>
            </StackPanel>

            <StackPanel Spacing="4">
                <showcase:CodePanel x:Name="PercentCode" />
                <Border Classes="demo">
                    <Button x:Name="PercentButton" Classes="specimen">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource StarIcon}" />
                            <TextBlock Text="Star" />
                        </StackPanel>
                    </Button>
                </Border>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Classes="caption" Text="Four evenly spaced frames, played linearly and with PlaybackEase = Eases.InOutQuad" />
                <showcase:CodePanel x:Name="MarchCode" />
                <Border Classes="demo" Height="120">
                    <StackPanel Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="LinearButton" Classes="specimen" Content="linear" Padding="10,3" />
                        <Button x:Name="EasedButton" Classes="specimen" Content="InOutQuad" Padding="10,3" Background="#f5c542" Foreground="#0b0e14" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Button Content="Replay" Click="Replay" HorizontalAlignment="Left" />
        </StackPanel>
    </ScrollViewer>
</showcase:ShowcasePage>
