<showcase:ShowcasePage xmlns="https://github.com/avaloniaui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:presto="https://github.com/stevemonaco/MonacoLabs.Presto"
                       xmlns:showcase="using:PrestoGallery.Showcase"
                       xmlns:local="using:PrestoGallery.Pages"
                       mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="450"
                       x:Class="PrestoGallery.Pages.LayoutPage">
    <showcase:ShowcasePage.Resources>
        <DataTemplate x:Key="ShortView">
            <TextBlock presto:Presence.Exit="{presto:Fade}" presto:Presence.Enter="{presto:Fade}" Text="Saved." />
        </DataTemplate>
        <DataTemplate x:Key="ParagraphView">
            <TextBlock presto:Presence.Exit="{presto:Fade}" presto:Presence.Enter="{presto:Fade}" Width="260" TextWrapping="Wrap"
                       Text="The box eases from the size it is drawn at to the size of whatever it holds now. The old view fades out as a ghost clipped to the old box, and this one fades in, laid out at its final width from the first frame." />
        </DataTemplate>
        <DataTemplate x:Key="IconsView">
            <UniformGrid presto:Presence.Exit="{presto:Fade}" presto:Presence.Enter="{presto:Fade}" Columns="3">
                <PathIcon Data="{StaticResource HeartIcon}" />
                <PathIcon Data="{StaticResource StarIcon}" />
                <PathIcon Data="{StaticResource PlayIcon}" />
                <PathIcon Data="{StaticResource StarIcon}" />
                <PathIcon Data="{StaticResource PlayIcon}" />
                <PathIcon Data="{StaticResource HeartIcon}" />
            </UniformGrid>
        </DataTemplate>
    </showcase:ShowcasePage.Resources>

    <showcase:ShowcasePage.Styles>
        <Style Selector="Border.card">
            <Setter Property="Width" Value="96" />
            <Setter Property="Height" Value="68" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Background" Value="{DynamicResource SystemAccentColorLight1}" />
            <Setter Property="TextElement.Foreground" Value="#101010" />
        </Style>
        <Style Selector="Border.card PathIcon">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Foreground" Value="#101010" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="Border.card TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Border.surface">
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Background" Value="{x:Static showcase:Palette.SurfaceHigh}" />
            <Setter Property="BoxShadow" Value="0 6 18 0 #80000000" />
        </Style>
        <Style Selector="Border.surface UniformGrid PathIcon">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="10" />
            <Setter Property="Foreground" Value="{x:Static showcase:Palette.AccentBright}" />
        </Style>
        <Style Selector="Border.frame">
            <Setter Property="Padding" Value="12" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{x:Static showcase:Palette.Border}" />
            <Setter Property="Background" Value="{x:Static showcase:Palette.Surface}" />
        </Style>
        <Style Selector="Border.tag">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="CornerRadius" Value="16" />
        </Style>
        <Style Selector="Border.tag TextBlock">
            <Setter Property="Foreground" Value="#101010" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.tile">
            <Setter Property="Height" Value="64" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="Border.tile TextBlock">
            <Setter Property="Foreground" Value="#101010" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.card TextBlock.number">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Opacity" Value="0.6" />
        </Style>
    </showcase:ShowcasePage.Styles>

    <StackPanel Spacing="16">
        <Border Classes="stage">
            <StackPanel Spacing="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <WrapPanel x:Name="Cards" MaxWidth="420" ItemWidth="104" ItemHeight="76">
                    <Border x:Name="XamlCard" Classes="card" Background="{DynamicResource SystemAccentColorLight3}"
                            presto:Animate.Layout="{presto:Reflow}">
                        <Grid RowDefinitions="*,Auto">
                            <PathIcon Data="{StaticResource StarIcon}" />
                            <TextBlock Grid.Row="1" Text="XAML" />
                        </Grid>
                    </Border>
                </WrapPanel>

                <WrapPanel ItemSpacing="24" LineSpacing="6" HorizontalAlignment="Center">
                    <Border x:Name="GrowBox" Width="120" Height="56" CornerRadius="6"
                            Background="{DynamicResource SystemAccentColorDark1}" />
                    <Border x:Name="AvatarCard" Width="150" Height="56" CornerRadius="10"
                            Background="{x:Static showcase:Palette.AccentPale}">
                        <WrapPanel ItemSpacing="10" LineSpacing="6" Margin="10,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Ellipse x:Name="Avatar" Width="32" Height="32" Fill="{x:Static showcase:Palette.Coral}" />
                            <TextBlock Text="Ada Lovelace" Foreground="#101010" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </WrapPanel>
                    </Border>
                    <WrapPanel ItemSpacing="12" LineSpacing="6">
                        <Border x:Name="SlotA" Width="76" Height="76" CornerRadius="6" BorderThickness="1"
                                BorderBrush="{DynamicResource SystemAccentColorLight2}" />
                        <Border x:Name="SlotB" Width="76" Height="76" CornerRadius="6" BorderThickness="1"
                                BorderBrush="{DynamicResource SystemAccentColorLight2}" />
                    </WrapPanel>
                </WrapPanel>
            </StackPanel>
        </Border>

        <WrapPanel ItemSpacing="8" LineSpacing="8">
            <Button Content="Shuffle" Click="Shuffle" />
            <Button Content="Add" Click="Add" />
            <Button Content="Remove" Click="RemoveCard" />
            <Button Content="Grow panel" Click="Grow" />
            <Button Content="Move between containers" Click="MoveShared" />
            <Button Content="Next view" Click="NextView" />
            <Button Content="Freeze UI thread for 2 s" Click="Freeze" />
            <WrapPanel ItemSpacing="8" LineSpacing="6">
                <TextBlock Classes="caption" Text="slow" VerticalAlignment="Center" />
                <ToggleSwitch x:Name="Slow" VerticalAlignment="Center" IsCheckedChanged="Rearm" />
            </WrapPanel>
            <WrapPanel ItemSpacing="8" LineSpacing="6">
                <TextBlock Classes="caption" Text="uncorrected avatar" VerticalAlignment="Center" />
                <ToggleSwitch x:Name="Uncorrected" VerticalAlignment="Center" IsCheckedChanged="Rearm" />
            </WrapPanel>
        </WrapPanel>

        <Border Classes="stage">
            <StackPanel Spacing="20" VerticalAlignment="Center">
                <StackPanel Spacing="8">
                    <TextBlock Classes="caption" Text="FlexPanel: tags wrap, justify and grow" HorizontalAlignment="Center" TextWrapping="Wrap" />
                    <Border x:Name="FlexFrame" Classes="frame" MaxWidth="{x:Static local:LayoutPage.WideFrame}">
                        <FlexPanel x:Name="Tags" Wrap="Wrap" ColumnSpacing="8" RowSpacing="8" AlignItems="Center" />
                    </Border>
                </StackPanel>
                <StackPanel Spacing="8">
                    <TextBlock Classes="caption" Text="WrapPanel.ItemsAlignment: tiles justify or stretch to fill each line" HorizontalAlignment="Center" TextWrapping="Wrap" />
                    <Border x:Name="WrapFrame" Classes="frame" MaxWidth="{x:Static local:LayoutPage.WideFrame}">
                        <WrapPanel x:Name="Tiles" ItemSpacing="8" LineSpacing="8" ItemWidth="88" ItemsAlignment="Justify" />
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>

        <WrapPanel ItemSpacing="8" LineSpacing="8">
            <ComboBox x:Name="JustifyBox" Width="170" SelectionChanged="JustifySelected" />
            <ComboBox x:Name="AlignmentBox" Width="150" SelectionChanged="AlignmentSelected" />
            <Button Content="Add tag" Click="AddTagClicked" />
            <Button Content="Remove tag" Click="RemoveTag" />
            <Button Content="Shuffle tiles" Click="ShuffleTiles" />
            <Button Content="Resize panels" Click="ResizePanels" />
            <WrapPanel ItemSpacing="8" LineSpacing="6">
                <TextBlock Classes="caption" Text="grow the first tag" VerticalAlignment="Center" />
                <ToggleSwitch x:Name="GrowTag" VerticalAlignment="Center" IsCheckedChanged="GrowFirstTag" />
            </WrapPanel>
        </WrapPanel>

        <Border Classes="stage">
            <WrapPanel ItemSpacing="24" LineSpacing="6" HorizontalAlignment="Center" VerticalAlignment="Top">
                <Border x:Name="Faq" Classes="surface" Width="300">
                    <StackPanel Spacing="10">
                        <ToggleButton x:Name="FaqToggle" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                      Content="Why doesn't this card stretch?" />
                        <TextBlock x:Name="FaqAnswer" IsVisible="{Binding #FaqToggle.IsChecked}" TextWrapping="Wrap"
                                   Foreground="{x:Static showcase:Palette.InkDim}"
                                   Text="Animate.ContentSize eases the card's real height on the UI thread and clips what it holds meanwhile. Nothing is scaled, so the corners and the shadow stay true, and the answer is laid out at its final width from the first frame, so it never rewraps." />
                    </StackPanel>
                </Border>
                <Border x:Name="SwapHost" Classes="surface" HorizontalAlignment="Left" />
            </WrapPanel>
        </Border>

        <TextBlock Classes="caption" TextWrapping="Wrap"
                   Text="Every card was handed to AnimateLayout when it was created, so a Shuffle, an Add or a Remove moves it in one layout pass and the pixels ease after it. This is FLIP played on the compositor: where the card was and where layout has just put it are measured on the UI thread, the difference is written to the composition Translation so the frame still renders it where it was, and the render thread eases that back to zero. Bounds is already right throughout, which is why a card is clicked where layout put it rather than where it is drawn. The panel grows under LayoutAnimateMode.PositionAndSize, which inverts the size onto the composition scale about the top left corner — its content scales with it. The avatar card beside it grows under PositionAndSizeCorrected, which counter-scales its direct children on the render thread so the avatar stays round and the name unstretched; its corner radius still scales, since radius is not a composition property. Switch it to plain PositionAndSize to compare. The FAQ card and the swapping panel below take the other road: Animate.ContentSize eases their real layout size on the UI thread and clips meanwhile, so corners, shadow and text stay true and the text never rewraps, at the cost of a layout pass per frame. Next view swaps the panel's content: the old view fades out as a ghost, the new one fades in, and the box resizes in between. Moving between containers is AnimateSharedElement: the square is measured in the window before it is reparented and eased from there into whatever slot its new parent gives it. The paler card is armed from XAML instead, with presto:Animate.Layout=&quot;{presto:Reflow}&quot;, so it moves with the others at the token duration whatever the slow switch says. Freezing sleeps the dispatcher for two seconds; start a slow move first and it keeps easing throughout, because nothing but the first measurement needs the UI thread. The tags and tiles take the same AnimateLayout under PositionAndSizeCorrected, so a tag that grows or a tile that stretches keeps its label true: Avalonia's FlexPanel and WrapPanel.ItemsAlignment need nothing of their own, since a layout transition reads only where the panel arranged each child. Switching justify-content or items alignment, adding or removing a tag, shuffling the tiles and resizing the frames are all one layout pass each; new tags pop in and removed ones pop out through Presence.Enter and Presence.Exit, and Resize panels eases the frames' MaxWidth on the UI thread while their children chase each reflow on the compositor." />
    </StackPanel>
</showcase:ShowcasePage>
