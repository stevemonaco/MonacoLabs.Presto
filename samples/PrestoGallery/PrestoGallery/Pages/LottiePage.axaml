<showcase:ShowcasePage xmlns="https://github.com/avaloniaui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:presto="https://github.com/stevemonaco/MonacoLabs.Presto"
                       xmlns:showcase="clr-namespace:PrestoGallery.Showcase"
                       mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="1800"
                       x:Class="PrestoGallery.Pages.LottiePage">
    <StackPanel Spacing="12">
        <TextBlock Classes="caption" Text="A spinner looped from XAML alone" />
        <Border Classes="stage" MinHeight="0">
            <!-- snippet: LottieSpinner -->
            <presto:LottieView Composition="avares://PrestoGallery/Assets/Lottie/spinner.json" Width="120" Height="120"
                               presto:Animate.OnAttached="{presto:PlayLottie}" />
            <!-- /snippet -->
        </Border>
        <showcase:CodeTabs x:Name="SpinnerCode" SelectedLanguage="Xaml" Xaml="{x:Static showcase:Snippets.LottieSpinner}" />

        <TextBlock Classes="caption" TextWrapping="Wrap"
                   Text="The markers in the JSON are named segments: a button per marker plays it on the left icon, and hovering the right icon plays its hover segment" />
        <Border Classes="stage" MinHeight="0">
            <WrapPanel ItemSpacing="24" LineSpacing="6">
                <presto:LottieView x:Name="Toggle" Composition="avares://PrestoGallery/Assets/Lottie/toggle.json" Width="120" Height="120" />
                <!-- snippet: LottieHover -->
                <presto:LottieView x:Name="HoverIcon" Composition="avares://PrestoGallery/Assets/Lottie/toggle.json" Width="120" Height="120"
                                   presto:Motion.Hover="{presto:PlayLottie Segment=hover, Loop=False}" />
                <!-- /snippet -->
                <StackPanel Spacing="8" VerticalAlignment="Center">
                    <StackPanel x:Name="MarkerButtons" Orientation="Horizontal" Spacing="8" />
                    <TextBlock x:Name="MarkerList" Classes="caption" />
                </StackPanel>
            </WrapPanel>
        </Border>
        <showcase:CodeTabs x:Name="MarkerCode" SelectedLanguage="CSharp" Xaml="{x:Static showcase:Snippets.LottieHover}" />

        <TextBlock Classes="caption" TextWrapping="Wrap"
                   Text="Play(loop: true) at the speed and in the direction picked; the scrub slider is bound two-way to Progress and pauses playback while dragged, and the filters are inherited from PrestoImageBase" />
        <Border Classes="stage" MinHeight="0">
            <Grid ColumnDefinitions="*,280" ColumnSpacing="24">
                <presto:LottieView x:Name="Player" Composition="avares://PrestoGallery/Assets/Lottie/spinner.json" Height="240" />
                <StackPanel Grid.Column="1" Spacing="2">
                    <!-- snippet: LottieScrub -->
                    <TextBlock Classes="caption" Text="{Binding #Player.Frame, StringFormat='Frame {0:0.00} of 60'}" />
                    <Slider x:Name="Scrub" Minimum="0" Maximum="1" Value="{Binding #Player.Progress, Mode=TwoWay}" />
                    <!-- /snippet -->
                    <TextBlock Classes="caption" Text="{Binding #SpeedSlider.Value, StringFormat='Speed {0:0.##}×'}" />
                    <Slider x:Name="SpeedSlider" Minimum="0.25" Maximum="3" Value="1" TickFrequency="0.25" IsSnapToTickEnabled="True"
                            ValueChanged="PlaybackChanged" />
                    <ToggleSwitch x:Name="ReverseToggle" OnContent="Reverse" OffContent="Forward" IsCheckedChanged="PlaybackChanged" />
                    <!-- snippet: LottieFilters -->
                    <TextBlock Classes="caption" Text="{Binding #Player.HueRotate, StringFormat='HueRotate {0:0}°'}" />
                    <Slider Minimum="0" Maximum="360" Value="{Binding #Player.HueRotate, Mode=TwoWay}" />
                    <TextBlock Classes="caption" Text="{Binding #Player.Grayscale, StringFormat='Grayscale {0:0.00}'}" />
                    <Slider Minimum="0" Maximum="1" Value="{Binding #Player.Grayscale, Mode=TwoWay}" />
                    <!-- /snippet -->
                </StackPanel>
            </Grid>
        </Border>
        <showcase:CodeTabs x:Name="PlayerCode" SelectedLanguage="CSharp" Xaml="{x:Static showcase:Snippets.LottieScrub}" />
        <showcase:CodeTabs x:Name="FilterCode" SelectedLanguage="Xaml" Xaml="{x:Static showcase:Snippets.LottieFilters}" />

        <TextBlock Classes="caption" TextWrapping="Wrap"
                   Text="A timeline plays the on segment and slides the label in on the same clock, alternating on loop" />
        <Border Classes="stage" MinHeight="0">
            <WrapPanel ItemSpacing="16" LineSpacing="6">
                <presto:LottieView x:Name="Switch" Composition="avares://PrestoGallery/Assets/Lottie/toggle.json" Width="80" Height="80" />
                <TextBlock x:Name="SwitchLabel" Text="Notifications on" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            </WrapPanel>
        </Border>
        <showcase:CodeTabs x:Name="TimelineCode" SelectedLanguage="CSharp" />

        <TextBlock Classes="caption" TextWrapping="Wrap"
                   Text="RenderThread draws and plays the spinner on the render thread: turn it on, then freeze the UI thread and the spinner keeps turning (not in the browser, which renders on the UI thread)" />
        <Border Classes="stage" MinHeight="0">
            <WrapPanel ItemSpacing="24" LineSpacing="6">
                <presto:LottieView x:Name="RenderSpinner" Composition="avares://PrestoGallery/Assets/Lottie/spinner.json" Width="120" Height="120" />
                <StackPanel Spacing="8" VerticalAlignment="Center">
                    <ToggleSwitch x:Name="RenderToggle" OnContent="Render thread" OffContent="UI thread" IsCheckedChanged="RenderThreadChanged" />
                    <Button Classes="accent" Content="Freeze UI thread for 2 s" Click="FreezeClicked" />
                </StackPanel>
            </WrapPanel>
        </Border>
        <showcase:CodeTabs x:Name="RenderThreadCode" SelectedLanguage="CSharp" />
    </StackPanel>
</showcase:ShowcasePage>
