<showcase:ShowcasePage xmlns="https://github.com/avaloniaui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:showcase="clr-namespace:PrestoGallery.Showcase"
                       mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="600"
                       x:Class="PrestoGallery.Pages.PlaybackSettingsPage">
    <ScrollViewer>
        <StackPanel Spacing="12">
            <Border Classes="stage" MinHeight="140" Padding="16">
                <Button x:Name="ClickButton" Classes="specimen" Padding="14,8" Click="Clicked">
                    <TextBlock x:Name="ClickText" Text="Click me · 0" />
                </Button>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="Play" Click="Play" />
                <Button Content="Pause" Click="Pause" />
                <Button Content="Restart" Click="Restart" />
                <TextBlock x:Name="StatusText" Classes="readout" FontSize="16" VerticalAlignment="Center" Text="0% · iteration 0" />
            </StackPanel>

            <Grid ColumnDefinitions="*,24,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="0" RowSpacing="12">
                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                    <TextBlock Classes="caption" Text="{Binding #DurationSlider.Value, StringFormat='Duration {0:0} ms'}" />
                    <Slider x:Name="DurationSlider" Minimum="200" Maximum="3000" Value="1400" ValueChanged="SettingChanged" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2" Spacing="2">
                    <TextBlock Classes="caption" Text="{Binding #DelaySlider.Value, StringFormat='Delay {0:0} ms'}" />
                    <Slider x:Name="DelaySlider" Minimum="0" Maximum="1000" Value="0" ValueChanged="SettingChanged" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2">
                    <TextBlock Classes="caption" Text="{Binding #LoopSlider.Value, StringFormat='Loop {0:0} extra iterations'}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Slider x:Name="LoopSlider" Width="180" Minimum="0" Maximum="5" Value="2"
                                TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SettingChanged" />
                        <CheckBox x:Name="InfiniteCheck" Content="Infinite" IsChecked="True"
                                  VerticalAlignment="Center" IsCheckedChanged="ToggleChanged" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="2" Spacing="2">
                    <TextBlock Classes="caption" Text="{Binding #LoopDelaySlider.Value, StringFormat='Loop delay {0:0} ms'}" />
                    <Slider x:Name="LoopDelaySlider" Minimum="0" Maximum="800" Value="0" ValueChanged="SettingChanged" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Spacing="2">
                    <TextBlock Classes="caption" Text="{Binding #FrameRateSlider.Value, StringFormat='Frame rate {0:0} fps'}" />
                    <Slider x:Name="FrameRateSlider" Minimum="5" Maximum="120" Value="60" ValueChanged="FrameRateChanged" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="2" Spacing="2">
                    <TextBlock Classes="caption" Text="{Binding #PlaybackRateSlider.Value, StringFormat='Playback rate {0:0.00}x'}" />
                    <Slider x:Name="PlaybackRateSlider" Minimum="0.1" Maximum="3" Value="1" ValueChanged="PlaybackRateChanged" />
                </StackPanel>

                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="24">
                    <CheckBox x:Name="AlternateCheck" Content="Alternate" IsChecked="True" IsCheckedChanged="ToggleChanged" />
                    <CheckBox x:Name="ReversedCheck" Content="Reversed" IsCheckedChanged="ToggleChanged" />
                    <CheckBox x:Name="AutoplayCheck" Content="Autoplay" IsChecked="True" IsCheckedChanged="ToggleChanged" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</showcase:ShowcasePage>