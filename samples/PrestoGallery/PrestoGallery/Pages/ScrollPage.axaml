<showcase:ShowcasePage xmlns="https://github.com/avaloniaui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:showcase="clr-namespace:PrestoGallery.Showcase"
                       xmlns:presto="https://github.com/stevemonaco/MonacoLabs.Presto"
                       mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="600"
                       x:Class="PrestoGallery.Pages.ScrollPage">
    <showcase:ShowcasePage.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#18808080" />
            <Setter Property="BorderBrush" Value="#40808080" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style Selector="Border.spacer">
            <Setter Property="Height" Value="240" />
        </Style>

        <Style Selector="TextBlock.value">
            <Setter Property="FontFamily" Value="Consolas,Menlo,monospace" />
            <Setter Property="FontSize" Value="15" />
        </Style>

        <Style Selector="ItemsControl.rows > ContentPresenter">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="BorderBrush" Value="#40808080" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>

        <Style Selector="ItemsControl.chips > ContentPresenter">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Background" Value="{x:Static showcase:Palette.AccentDeep}" />
        </Style>

        <Style Selector="Border.shadow">
            <Setter Property="Height" Value="18" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="Border.shadow.top">
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="#CC0B0E14" />
                    <GradientStop Offset="1" Color="#000B0E14" />
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="Border.shadow.bottom">
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,100%" EndPoint="0%,0%">
                    <GradientStop Offset="0" Color="#CC0B0E14" />
                    <GradientStop Offset="1" Color="#000B0E14" />
                </LinearGradientBrush>
            </Setter>
        </Style>
    </showcase:ShowcasePage.Styles>

    <Grid RowDefinitions="Auto,*">
        <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,10">
            <Grid ColumnDefinitions="Auto,80,Auto,80,Auto,90,Auto,*" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Classes="mono" Text="Progress" />
                <TextBlock Grid.Column="1" x:Name="ProgressText" Classes="value" Text="—" />
                <TextBlock Grid.Column="2" Classes="mono" Text="Velocity" />
                <TextBlock Grid.Column="3" x:Name="VelocityText" Classes="value" Text="—" />
                <TextBlock Grid.Column="4" Classes="mono" Text="Direction" />
                <TextBlock Grid.Column="5" x:Name="DirectionText" Classes="value" Text="—" />
                <TextBlock Grid.Column="6" Classes="mono" Text="Thresholds" />
                <TextBlock Grid.Column="7" x:Name="StateText" Classes="value" Text="ThresholdCard out of view" />
            </Grid>
            <WrapPanel ItemSpacing="8" LineSpacing="8">
                <Button Content="Back to top" Click="BackToTop" />
                <Button Content="Default thresholds" Tag="{Binding #RevealCard}" Click="JumpTo" />
                <Button Content="Named thresholds" Tag="{Binding #ThresholdCard}" Click="JumpTo" />
                <Button Content="Scrubbed timeline" Tag="{Binding #SyncCard}" Click="JumpTo" />
                <Button Content="Edge cues" Tag="{Binding #EdgeCard}" Click="JumpTo" />
            </WrapPanel>
            <showcase:CodePanel Header="Jumps" IsExpanded="False" Code="{x:Static showcase:Snippets.ScrollJumps}" />
        </StackPanel>

        <ScrollViewer x:Name="Scroller" Grid.Row="1">
            <StackPanel Spacing="16" Margin="0,0,16,16">
                <TextBlock Classes="caption" TextWrapping="Wrap"
                           Text="Scroll this panel. The readout above follows the third card's observer; velocity and direction are shared by every observer of the same ScrollViewer." />

                <Border Classes="spacer" />

                <Border x:Name="RevealCard" Classes="card">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Default thresholds" FontSize="18" />
                        <TextBlock Classes="caption" TextWrapping="Wrap"
                                   Text="Presence.Reveal with no RevealThreshold: the card is held hidden until its top reaches the bottom of the viewport, an observer's default &quot;end start&quot; enter threshold, and then fades up once." />
                        <showcase:CodePanel Code="{x:Static showcase:Snippets.ScrollReveal}" />
                    </StackPanel>
                </Border>

                <Border Classes="spacer" />

                <Border x:Name="ThresholdCard" Classes="card">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Named thresholds" FontSize="18" />
                        <TextBlock Classes="caption" TextWrapping="Wrap"
                                   Text="Enters 120 units before the bottom edge reaches its top, and leaves when the top edge reaches its center." />
                        <showcase:CodePanel Code="{x:Static showcase:Snippets.ScrollThreshold}" />
                    </StackPanel>
                </Border>

                <Border Classes="spacer" />

                <Border x:Name="SyncCard" Classes="card">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Scrubbed timeline" FontSize="18" />
                        <showcase:CodePanel Code="{x:Static showcase:Snippets.ScrollScrub}" />
                        <Canvas Height="44" ClipToBounds="True">
                            <Border x:Name="Rider" Width="32" Height="32" CornerRadius="6" Background="#f5c542" Canvas.Top="6" />
                        </Canvas>
                    </StackPanel>
                </Border>

                <Border Classes="spacer" />

                <Border x:Name="EdgeCard" Classes="card">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Edge cues" FontSize="18" />
                        <TextBlock Classes="caption" TextWrapping="Wrap"
                                   Text="Scroll.CueFor fades each shadow in as content passes its edge of the list, and Scroll.FadeEdges masks the chip row's ends only while more chips lie past them." />
                        <!-- snippet: ScrollEdgeCues -->
                        <Panel Height="200">
                            <ScrollViewer x:Name="EdgeList">
                                <ItemsControl x:Name="EdgeRows" Classes="rows" />
                            </ScrollViewer>
                            <Border Classes="shadow top" presto:Scroll.CueFor="{Binding #EdgeList}" />
                            <Border Classes="shadow bottom" presto:Scroll.CueFor="{Binding #EdgeList}" presto:Scroll.CueEdge="Bottom" />
                        </Panel>
                        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                      presto:Scroll.FadeEdges="24">
                            <ItemsControl x:Name="EdgeChips" Classes="chips">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                        <!-- /snippet -->
                        <showcase:CodePanel Language="Xaml" Code="{x:Static showcase:Snippets.ScrollEdgeCues}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="mono" Text="Remaining" />
                            <TextBlock x:Name="RemainingText" Classes="value" Text="—" />
                        </StackPanel>
                        <showcase:CodePanel Code="{x:Static showcase:Snippets.ScrollRemaining}" />
                    </StackPanel>
                </Border>

                <Border Classes="spacer" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</showcase:ShowcasePage>
