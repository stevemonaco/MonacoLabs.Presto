<showcase:ShowcasePage xmlns="https://github.com/avaloniaui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:showcase="clr-namespace:PrestoGallery.Showcase"
                       mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="600"
                       x:Class="PrestoGallery.Pages.ShapesPage">
    <showcase:ShowcasePage.Resources>
        <StreamGeometry x:Key="CircleGeometry">M 210,20 A 55,55 0 0 1 210,130 A 55,55 0 0 1 210,20 Z</StreamGeometry>
        <StreamGeometry x:Key="StarGeometry">M 210,20 L 222.93,57.2 L 262.31,58 L 230.92,81.8 L 242.33,119.5 L 210,97 L 177.67,119.5 L 189.08,81.8 L 157.69,58 L 197.07,57.2 Z</StreamGeometry>
    </showcase:ShowcasePage.Resources>

    <StackPanel Spacing="12">
        <showcase:CodePanel x:Name="DrawCode" />
        <showcase:CodePanel x:Name="DrawBuilderCode" Header="Builder form" />

        <Border Classes="stage compact" HorizontalAlignment="Left">
            <Viewbox StretchDirection="DownOnly">
                <Canvas Width="420" Height="150">
                    <Path x:Name="SignaturePath" Stretch="None"
                          Stroke="#4c8dff" StrokeThickness="6" StrokeLineCap="Round"
                          Data="M 10,110 C 60,10 110,150 160,80 S 250,0 300,70 S 380,140 410,50" />
                </Canvas>
            </Viewbox>
        </Border>

        <showcase:CodePanel Code="{x:Static showcase:Snippets.ShapesRider}" />

        <Border Classes="stage compact" HorizontalAlignment="Left">
            <Viewbox StretchDirection="DownOnly">
                <Canvas Width="420" Height="150">
                    <Path x:Name="TrackPath" Stretch="None"
                          Stroke="#60808080" StrokeThickness="2" StrokeDashArray="3,3"
                          Data="M 30,75 C 90,-5 150,155 210,75 S 330,-5 390,75" />
                    <Border x:Name="Rider" Width="28" Height="12" CornerRadius="3" Background="#f5c542"
                            Canvas.Left="-14" Canvas.Top="-6" />
                </Canvas>
            </Viewbox>
        </Border>

        <TextBlock Classes="caption" TextWrapping="Wrap"
                   Text="The motion path values are points of the path's own geometry, so the rider sits at the canvas origin and is moved from there." />

        <showcase:CodePanel Code="{x:Static showcase:Snippets.ShapesSpline}" />

        <Border Classes="stage compact" HorizontalAlignment="Left">
            <Viewbox StretchDirection="DownOnly">
                <Canvas Width="420" Height="150">
                    <Path x:Name="TrackSpline" Stretch="None"
                          Stroke="#60808080" StrokeThickness="2" StrokeDashArray="3,3" />
                    <Border x:Name="SplineRider" Width="12" Height="28" CornerRadius="3" Background="#4c8dff"
                            Canvas.Left="-6" Canvas.Top="-14" />
                </Canvas>
            </Viewbox>
        </Border>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="caption" VerticalAlignment="Center" Text="Curviness" />
            <Slider x:Name="CurvinessSlider" Width="200" Minimum="0" Maximum="2" Value="1"
                    ValueChanged="OnCurvinessChanged" />
            <TextBlock Classes="caption" VerticalAlignment="Center"
                       Text="{Binding #CurvinessSlider.Value, StringFormat={}{0:0.00}}" />
        </StackPanel>

        <Border Classes="stage compact" HorizontalAlignment="Left">
            <Viewbox StretchDirection="DownOnly">
                <Canvas Width="420" Height="150">
                    <Path x:Name="MorphPath" Stretch="None"
                          Fill="#334c8dff" Stroke="#4c8dff" StrokeThickness="3"
                          Data="{StaticResource CircleGeometry}" />
                </Canvas>
            </Viewbox>
        </Border>

        <Button Content="Morph" Click="OnMorph" HorizontalAlignment="Left" />

        <showcase:CodePanel x:Name="MorphCode" IsVisible="False" />
        <showcase:CodePanel x:Name="MorphBuilderCode" Header="Builder form" IsVisible="False" />
    </StackPanel>
</showcase:ShowcasePage>
