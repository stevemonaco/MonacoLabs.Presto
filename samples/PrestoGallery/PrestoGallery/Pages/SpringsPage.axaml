<showcase:ShowcasePage xmlns="https://github.com/avaloniaui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:presto="https://github.com/stevemonaco/MonacoLabs.Presto"
                       xmlns:showcase="clr-namespace:PrestoGallery.Showcase"
                       xmlns:local="using:PrestoGallery.Pages"
                       xmlns:vm="clr-namespace:PrestoGallery.ViewModels"
                       mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="900"
                       x:Class="PrestoGallery.Pages.SpringsPage">
    <StackPanel Spacing="12">
        <TextBlock Text="Spring lab" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Classes="caption" TextWrapping="Wrap"
                   Text="One Spring drives the weight, the plot and the code. Set it physically (stiffness, damping, mass, velocity) or the way a designer would (bounce and a perceived duration): each pair is derived from the other, so moving one side moves the other. Mass and velocity only exist physically, and setting bounce or duration puts them back to 1 and 0." />

        <WrapPanel ItemSpacing="16" LineSpacing="8">
            <Border Classes="stage compact">
                <Canvas Width="120" Height="300">
                    <Line StartPoint="20,10" EndPoint="100,10" Stroke="#808080" StrokeThickness="3" />
                    <Polyline x:Name="Coil" Stroke="#a0a0a0" StrokeThickness="2" StrokeJoin="Round" />
                    <Border x:Name="Weight" Width="48" Height="36" Canvas.Left="36" Canvas.Top="40"
                            CornerRadius="6" Background="#4c8dff" />
                </Canvas>
            </Border>

            <Border Classes="stage compact">
                <Viewbox StretchDirection="DownOnly">
                    <Canvas x:Name="PlotCanvas" Width="440" Height="300">
                        <Line x:Name="ZeroLine" Stroke="#60808080" StrokeThickness="1" StrokeDashArray="4,4" />
                        <Line x:Name="OneLine" Stroke="#60808080" StrokeThickness="1" StrokeDashArray="4,4" />
                        <Line x:Name="PerceivedLine" Stroke="#f5c542" StrokeThickness="1.5" />
                        <Line x:Name="SettlingLine" Stroke="#2dd4bf" StrokeThickness="1.5" />
                        <TextBlock x:Name="PerceivedLabel" Classes="caption" Foreground="#f5c542" Canvas.Top="0"
                                   Text="Duration · OnComplete" />
                        <TextBlock x:Name="SettlingLabel" Classes="caption" Foreground="#2dd4bf" Canvas.Bottom="0"
                                   Text="SettlingDuration · the animation ends" />
                        <Polyline x:Name="Curve" Stroke="#4c8dff" StrokeThickness="2" />
                    </Canvas>
                </Viewbox>
            </Border>
        </WrapPanel>

        <showcase:SplitPanel Widths="*,*" Spacing="24" MaxWidth="640" HorizontalAlignment="Left">
            <StackPanel Spacing="2">
                <TextBlock Classes="mono" Text="Physical" FontWeight="SemiBold" />
                <TextBlock Classes="caption" Text="{Binding #StiffnessSlider.Value, StringFormat='Stiffness {0:0.#}'}" />
                <Slider x:Name="StiffnessSlider" Minimum="1" Maximum="1000" ValueChanged="StiffnessChanged" />
                <TextBlock Classes="caption" Text="{Binding #DampingSlider.Value, StringFormat='Damping {0:0.#}'}" />
                <Slider x:Name="DampingSlider" Minimum="0.1" Maximum="100" ValueChanged="DampingChanged" />
                <TextBlock Classes="caption" Text="{Binding #MassSlider.Value, StringFormat='Mass {0:0.#}'}" />
                <Slider x:Name="MassSlider" Minimum="1" Maximum="20" ValueChanged="MassChanged" />
                <TextBlock Classes="caption" Text="{Binding #VelocitySlider.Value, StringFormat='Velocity {0:0.#}'}" />
                <Slider x:Name="VelocitySlider" Minimum="-50" Maximum="50" ValueChanged="VelocityChanged" />
            </StackPanel>

            <StackPanel Spacing="2">
                <TextBlock Classes="mono" Text="Designer" FontWeight="SemiBold" />
                <TextBlock Classes="caption" Text="{Binding #BounceSlider.Value, StringFormat='Bounce {0:0.00}'}" />
                <Slider x:Name="BounceSlider" Minimum="-1" Maximum="1" ValueChanged="BounceChanged" />
                <TextBlock Classes="caption" Text="{Binding #DurationSlider.Value, StringFormat='Duration {0:0} ms'}" />
                <Slider x:Name="DurationSlider" Minimum="100" Maximum="3000" ValueChanged="DurationChanged" />
            </StackPanel>
        </showcase:SplitPanel>

        <WrapPanel ItemSpacing="16" LineSpacing="8">
            <Button x:Name="DropButton" Content="Drop the weight" Click="DropWeight" />
            <TextBlock x:Name="RatioText" Classes="mono" VerticalAlignment="Center" />
            <TextBlock x:Name="SettlingText" Classes="mono" VerticalAlignment="Center" />
            <TextBlock x:Name="DurationText" Classes="mono" VerticalAlignment="Center" />
        </WrapPanel>

        <showcase:CodePanel x:Name="LabCode" />

        <TextBlock Text="Three regimes" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,0" />
        <TextBlock Classes="caption" TextWrapping="Wrap"
                   Text="Three springs with the same stiffness and mass race to the line, their damping picked for a ratio of 0.3, 1 and 2. Below 1 the spring overshoots and rings; at 1 it arrives as fast as it can without overshooting; above 1 it creeps in." />
        <showcase:SplitPanel Widths="Auto,*" Spacing="16" Breakpoint="680">
            <Border Classes="stage compact">
                <Viewbox StretchDirection="DownOnly">
                    <Canvas Width="460" Height="132">
                        <Line StartPoint="0,22" EndPoint="460,22" Stroke="#30808080" StrokeThickness="1" />
                        <Line StartPoint="0,66" EndPoint="460,66" Stroke="#30808080" StrokeThickness="1" />
                        <Line StartPoint="0,110" EndPoint="460,110" Stroke="#30808080" StrokeThickness="1" />
                        <Line StartPoint="312,0" EndPoint="312,132" Stroke="{x:Static showcase:Palette.Amber}" StrokeThickness="1.5" />
                        <Border x:Name="UnderDot" Width="24" Height="24" CornerRadius="12" Canvas.Top="10"
                                Background="{x:Static showcase:Palette.Coral}" />
                        <Border x:Name="CriticalDot" Width="24" Height="24" CornerRadius="12" Canvas.Top="54"
                                Background="{x:Static showcase:Palette.Aqua}" />
                        <Border x:Name="OverDot" Width="24" Height="24" CornerRadius="12" Canvas.Top="98"
                                Background="{x:Static showcase:Palette.Violet}" />
                    </Canvas>
                </Viewbox>
            </Border>
            <Grid RowDefinitions="44,44,44">
                <TextBlock x:Name="UnderCaption" Classes="caption" VerticalAlignment="Center" />
                <TextBlock Grid.Row="1" x:Name="CriticalCaption" Classes="caption" VerticalAlignment="Center" />
                <TextBlock Grid.Row="2" x:Name="OverCaption" Classes="caption" VerticalAlignment="Center" />
            </Grid>
        </showcase:SplitPanel>
        <Button x:Name="RaceButton" Content="Race" Click="RaceClicked" />
        <showcase:CodePanel x:Name="RegimesCode" />

        <TextBlock Text="Continuous velocity" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,0" />
        <TextBlock Classes="caption" TextWrapping="Wrap"
                   Text="Click the stage, then click again before the pucks arrive. The blue puck starts a new 600 ms tween on every click, so its velocity jumps to the new tween's; the aqua one follows a MotionValue through a spring, which keeps its position and velocity when the target moves. The trace plots each one's horizontal velocity over the last three seconds." />
        <WrapPanel ItemSpacing="4" LineSpacing="8">
            <TextBlock Classes="caption" VerticalAlignment="Center" Text="More retargeting:" />
            <HyperlinkButton x:DataType="vm:MainViewModel" Padding="0" FontSize="12" VerticalAlignment="Center"
                             Content="Interruption lab" Command="{Binding OpenCommand}" CommandParameter="Interruption lab" />
            <TextBlock Classes="caption" VerticalAlignment="Center" Text="compares composition modes, and" />
            <HyperlinkButton x:DataType="vm:MainViewModel" Padding="0" FontSize="12" VerticalAlignment="Center"
                             Content="Animatable" Command="{Binding OpenCommand}" CommandParameter="Animatable" />
            <TextBlock Classes="caption" VerticalAlignment="Center" Text="carries velocity into a spring retarget." />
        </WrapPanel>
        <Border Classes="stage compact" HorizontalAlignment="Left">
            <Viewbox StretchDirection="DownOnly">
                <Canvas x:Name="VelocityStage" Width="640" Height="220" Background="Transparent" ClipToBounds="True"
                        PointerPressed="VelocityStagePressed">
                    <Border x:Name="TweenPuck" Width="28" Height="28" CornerRadius="14" Canvas.Left="306" Canvas.Top="96"
                            Background="{x:Static showcase:Palette.Accent}" Opacity="0.85" />
                    <Border x:Name="SpringPuck" Width="28" Height="28" CornerRadius="14" Canvas.Left="306" Canvas.Top="96"
                            Background="{x:Static showcase:Palette.Aqua}" Opacity="0.85" />
                </Canvas>
            </Viewbox>
        </Border>
        <Border Classes="stage compact" HorizontalAlignment="Left">
            <Viewbox StretchDirection="DownOnly">
                <Canvas x:Name="TraceCanvas" Width="640" Height="120">
                    <Line StartPoint="0,60" EndPoint="640,60" Stroke="#60808080" StrokeThickness="1" StrokeDashArray="4,4" />
                    <Polyline x:Name="TweenTrace" Stroke="{x:Static showcase:Palette.Accent}" StrokeThickness="2" />
                    <Polyline x:Name="SpringTrace" Stroke="{x:Static showcase:Palette.Aqua}" StrokeThickness="2" />
                    <TextBlock Classes="caption" Canvas.Left="4" Canvas.Top="0" Text="velocity X · px/ms · last 3 s" />
                </Canvas>
            </Viewbox>
        </Border>
        <showcase:CodePanel x:Name="VelocityCode" />

        <TextBlock Text="Throw it" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,0" />
        <TextBlock Classes="caption" TextWrapping="Wrap"
                   Text="Drag the puck and let go mid-swing. While held, a stiff spring chases the pointer; on release the pointer's velocity becomes the starting velocity of a looser spring back to the rest point. The arrow shows that velocity, and the guide lines through the rest point show how far the throw carries it past." />
        <Border Classes="stage compact" HorizontalAlignment="Left">
            <Viewbox StretchDirection="DownOnly">
                <Canvas x:Name="ThrowStage" Width="640" Height="260" ClipToBounds="True">
                    <Line StartPoint="0,130" EndPoint="640,130" Stroke="#60808080" StrokeThickness="1" StrokeDashArray="4,4" />
                    <Line StartPoint="320,0" EndPoint="320,260" Stroke="#60808080" StrokeThickness="1" StrokeDashArray="4,4" />
                    <Ellipse Width="40" Height="40" Canvas.Left="300" Canvas.Top="110"
                             Stroke="{x:Static showcase:Palette.Amber}" StrokeThickness="1.5" />
                    <Polyline x:Name="ThrowArrow" Stroke="{x:Static showcase:Palette.Coral}" StrokeThickness="2"
                              StrokeJoin="Round" StrokeLineCap="Round" />
                    <Border x:Name="ThrowPuck" Width="32" Height="32" CornerRadius="16" Canvas.Left="304" Canvas.Top="114"
                            Background="{x:Static showcase:Palette.Accent}" Cursor="Hand"
                            PointerPressed="ThrowPressed" PointerMoved="ThrowMoved" PointerReleased="ThrowReleased" />
                </Canvas>
            </Viewbox>
        </Border>
        <TextBlock x:Name="ThrowText" Classes="mono" Text="Release velocity · drag and let go" />
        <showcase:CodePanel x:Name="ThrowCode" />

        <TextBlock Text="Ease or follower" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,0" />
        <TextBlock Classes="caption" TextWrapping="Wrap"
                   Text="The same spring, two ways. On the left it is the Ease of a staggered animation to a fixed line; on the right each dot follows a MotionValue through it, and the slider moves that target while the dots are still on their way. A fixed target means an ease; a target that can move means a follower." />
        <WrapPanel ItemSpacing="16" LineSpacing="16">
            <StackPanel Spacing="8">
                <Border Classes="stage compact">
                    <Panel Width="280" Height="200">
                        <Line StartPoint="0,172" EndPoint="280,172" Stroke="{x:Static showcase:Palette.Amber}" StrokeThickness="1.5" />
                        <StackPanel x:Name="EaseRow" Orientation="Horizontal" Spacing="20" Margin="20,12" VerticalAlignment="Top" />
                    </Panel>
                </Border>
                <Button x:Name="EaseRowButton" Content="Play the ease" Click="EaseRowClicked" />
            </StackPanel>
            <StackPanel Spacing="8">
                <Border Classes="stage compact">
                    <Panel Width="280" Height="200">
                        <Line x:Name="FollowerTargetLine" StartPoint="0,22" EndPoint="280,22"
                              Stroke="{x:Static showcase:Palette.Amber}" StrokeThickness="1.5" />
                        <StackPanel x:Name="FollowerRow" Orientation="Horizontal" Spacing="20" Margin="20,12" VerticalAlignment="Top" />
                    </Panel>
                </Border>
                <Slider x:Name="FollowerTargetSlider" Minimum="0" Maximum="150" ValueChanged="FollowerTargetChanged" />
            </StackPanel>
        </WrapPanel>
        <showcase:CodePanel x:Name="EaseFollowerCode" />

        <TextBlock Text="Presets in real UI" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,0" />
        <TextBlock Classes="caption" TextWrapping="Wrap"
                   Text="The four Springs presets on the controls they suit, each labelled with the one it uses. A toggle wants Stiff, so the thumb lands without wobble; a tab indicator Snappy; a badge Bouncy, so the pop reads. The sheet is pure XAML: {presto:Follow} takes a preset name or &quot;bounce,duration&quot;, here Gentle for the scrim and 0.2,400 for the panel." />
        <WrapPanel ItemSpacing="16" LineSpacing="16">
            <StackPanel Spacing="6">
                <Border Classes="stage compact">
                    <Panel Width="200" Height="140">
                        <Border x:Name="ToggleTrack" Width="56" Height="30" CornerRadius="15" Cursor="Hand"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Background="{x:Static showcase:Palette.SurfaceHigh}" PointerPressed="ToggleClicked">
                            <Border x:Name="ToggleThumb" Width="22" Height="22" CornerRadius="11" Margin="4,0"
                                    HorizontalAlignment="Left" Background="{x:Static showcase:Palette.Ink}" />
                        </Border>
                    </Panel>
                </Border>
                <TextBlock Classes="mono" Text="Springs.Stiff · toggle thumb" />
            </StackPanel>

            <StackPanel Spacing="6">
                <Border Classes="stage compact">
                    <Panel Width="200" Height="140">
                        <StackPanel Width="192" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel x:Name="Tabs" Orientation="Horizontal">
                                <Button Width="64" Padding="0,5" Background="Transparent" HorizontalContentAlignment="Center" Content="Inbox" Click="TabClicked" />
                                <Button Width="64" Padding="0,5" Background="Transparent" HorizontalContentAlignment="Center" Content="Sent" Click="TabClicked" />
                                <Button Width="64" Padding="0,5" Background="Transparent" HorizontalContentAlignment="Center" Content="Drafts" Click="TabClicked" />
                            </StackPanel>
                            <Border x:Name="TabIndicator" Width="64" Height="3" CornerRadius="1.5" HorizontalAlignment="Left"
                                    Background="{x:Static showcase:Palette.Accent}" />
                        </StackPanel>
                    </Panel>
                </Border>
                <TextBlock Classes="mono" Text="Springs.Snappy · tab indicator" />
            </StackPanel>

            <StackPanel Spacing="6">
                <Border Classes="stage compact">
                    <Panel Width="200" Height="140">
                        <Panel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button x:Name="BadgeButton" Content="New message" Margin="0,10,10,0" Click="BadgeClicked" />
                            <Border x:Name="Badge" MinWidth="22" Height="22" CornerRadius="11" Padding="6,0" IsHitTestVisible="False"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Background="{x:Static showcase:Palette.Coral}">
                                <TextBlock x:Name="BadgeCount" Text="1" FontSize="12" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Panel>
                    </Panel>
                </Border>
                <TextBlock Classes="mono" Text="Springs.Bouncy · badge pop" />
            </StackPanel>

            <StackPanel Spacing="6">
                <Border Classes="stage compact">
                    <Canvas Width="200" Height="140" ClipToBounds="True">
                        <Button x:Name="SheetButton" Canvas.Left="12" Canvas.Top="12" Content="Open sheet" Click="SheetClicked" />
                        <!-- snippet: SpringPresetSheet -->
                        <Border x:Name="Scrim" Width="200" Height="140" IsHitTestVisible="False" Background="Black"
                                Opacity="{presto:Follow {Binding $parent[local:SpringsPage].ScrimOpacity}, Spring=Gentle}" />
                        <Border x:Name="Sheet" Width="200" Height="100" CornerRadius="12,12,0,0"
                                Background="{x:Static showcase:Palette.AccentDim}"
                                Canvas.Top="{presto:Follow {Binding $parent[local:SpringsPage].SheetTop}, Spring='0.2,400'}" />
                        <!-- /snippet -->
                    </Canvas>
                </Border>
                <TextBlock Classes="mono" Text="Gentle · &quot;0.2,400&quot; · sheet" />
            </StackPanel>
        </WrapPanel>
        <showcase:CodeTabs x:Name="PresetsCode" SelectedLanguage="Xaml" Xaml="{x:Static showcase:Snippets.SpringPresetSheet}" />

        <TextBlock Text="Chained springs" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,0" />
        <TextBlock Classes="caption" TextWrapping="Wrap"
                   Text="Move the pointer over the stage. The first dot follows the pointer through a spring and every later dot follows the one ahead of it, so each link adds its own lag and the tail swings. The picker swaps the spring on every link at once, mid-motion: a soft rope, a bouncy jelly or a stiff rod. Without the pointer the tail comes to rest." />
        <ComboBox x:Name="ChainPicker" Width="160" SelectedIndex="0" SelectionChanged="ChainPickerChanged">
            <ComboBoxItem Content="Rope" />
            <ComboBoxItem Content="Jelly" />
            <ComboBoxItem Content="Rod" />
        </ComboBox>
        <Border Classes="stage compact" HorizontalAlignment="Left">
            <Viewbox StretchDirection="DownOnly">
                <Canvas x:Name="ChainStage" Width="640" Height="260" Background="Transparent" ClipToBounds="True"
                        PointerMoved="ChainMoved" />
            </Viewbox>
        </Border>
        <showcase:CodePanel x:Name="ChainCode" />
    </StackPanel>
</showcase:ShowcasePage>
