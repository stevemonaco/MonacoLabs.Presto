<showcase:ShowcasePage xmlns="https://github.com/avaloniaui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:showcase="clr-namespace:PrestoGallery.Showcase"
                       mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="600"
                       x:Class="PrestoGallery.Pages.TimelinePage">
    <ScrollViewer>
        <StackPanel Spacing="12">
            <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
                <TextBlock Grid.Row="0" Grid.Column="0" Classes="mono" VerticalAlignment="Center" Text="0" />
                <Border Grid.Row="0" Grid.Column="1" Classes="demo lane">
                    <Button x:Name="AbsoluteButton" Classes="specimen" Content="Button" />
                </Border>

                <TextBlock Grid.Row="1" Grid.Column="0" Classes="mono" VerticalAlignment="Center" Text="appended" />
                <Border Grid.Row="1" Grid.Column="1" Classes="demo lane">
                    <ToggleSwitch x:Name="AppendToggle" IsChecked="True" />
                </Border>

                <TextBlock Grid.Row="2" Grid.Column="0" Classes="mono" VerticalAlignment="Center" Text="&quot;-=400&quot;" />
                <Border Grid.Row="2" Grid.Column="1" Classes="demo lane">
                    <Slider x:Name="RelativeSlider" Width="140" Maximum="100" Value="40" />
                </Border>

                <TextBlock Grid.Row="3" Grid.Column="0" Classes="mono" VerticalAlignment="Center" Text="&quot;&lt;&quot;" />
                <Border Grid.Row="3" Grid.Column="1" Classes="demo lane">
                    <TextBox x:Name="PreviousEndTextBox" Width="140" Text="Type here" />
                </Border>

                <TextBlock Grid.Row="4" Grid.Column="0" Classes="mono" VerticalAlignment="Center" Text="&quot;&lt;&lt;&quot;" />
                <Border Grid.Row="4" Grid.Column="1" Classes="demo lane">
                    <CheckBox x:Name="PreviousStartCheck" Content="CheckBox" IsChecked="True" />
                </Border>

                <TextBlock Grid.Row="5" Grid.Column="0" Classes="mono" VerticalAlignment="Center" Text="&quot;flash&quot;" />
                <Border Grid.Row="5" Grid.Column="1" Classes="demo lane">
                    <Button x:Name="LabelButton" Classes="specimen" Background="#f5c542" Foreground="#101010">
                        <PathIcon Data="{StaticResource StarIcon}" />
                    </Button>
                </Border>

                <TextBlock Grid.Row="6" Grid.Column="0" Classes="mono" VerticalAlignment="Center" Text="0" />
                <Border Grid.Row="6" Grid.Column="1" Classes="demo lane">
                    <Button x:Name="SyncedButton" Classes="specimen" Content="Synced" />
                </Border>

                <TextBlock Grid.Row="7" Grid.Column="0" Classes="mono" VerticalAlignment="Center" Text="20" />
                <Border Grid.Row="7" Grid.Column="1" Classes="demo lane">
                    <TextBlock x:Name="TimerChildText" Classes="readout" FontSize="18" VerticalAlignment="Center" Text="0" />
                </Border>

                <TextBlock Grid.Row="8" Grid.Column="0" Classes="mono" VerticalAlignment="Center" Text="&quot;flash&quot;" />
                <Border Grid.Row="8" Grid.Column="1" Classes="demo lane">
                    <TextBlock x:Name="CallText" Classes="readout" FontSize="18" VerticalAlignment="Center" Text="0 hits" />
                </Border>
            </Grid>

            <StackPanel Spacing="2">
                <TextBlock Classes="caption" Text="Scrub — the slider is the timeline's Progress" />
                <Slider x:Name="ScrubSlider" Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Play" Click="Play" />
                <Button Content="Pause" Click="Pause" />
                <Button Content="Restart" Click="Restart" />
                <Button Content="Reverse" Click="Reverse" />
                <TextBlock x:Name="ReadoutText" Classes="mono" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>

            <showcase:CodePanel x:Name="Code" />
        </StackPanel>
    </ScrollViewer>
</showcase:ShowcasePage>
