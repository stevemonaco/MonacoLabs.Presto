<showcase:ShowcasePage xmlns="https://github.com/avaloniaui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:showcase="clr-namespace:PrestoGallery.Showcase"
                       xmlns:presto="https://github.com/stevemonaco/MonacoLabs.Presto"
                       xmlns:local="using:PrestoGallery.Showcase.Pages"
                       mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="760"
                       x:Class="PrestoGallery.Showcase.Pages.ActivityFeedPage"
                       x:DataType="local:ActivityFeedViewModel">
    <showcase:ShowcasePage.DataContext>
        <local:ActivityFeedViewModel />
    </showcase:ShowcasePage.DataContext>

    <showcase:ShowcasePage.Styles>
        <Style Selector="Border.stage">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style Selector="ListBox.feed">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.feed ListBoxItem">
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="ListBox.feed ListBoxItem /template/ ContentPresenter#PART_ContentPresenter,
                         ListBox.feed ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                         ListBox.feed ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter,
                         ListBox.feed ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="TextBlock.day">
            <Setter Property="Margin" Value="4,18,0,6" />
        </Style>
        <Style Selector="Border.event, Border.skeleton">
            <Setter Property="Height" Value="60" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{x:Static showcase:Palette.SurfaceHigh}" />
        </Style>
        <Style Selector="Border.event">
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="BorderBrush" Value="{x:Static showcase:Palette.Border}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.kind">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>
        <Style Selector="Border.event TextBlock.title">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{x:Static showcase:Palette.Ink}" />
        </Style>
        <Style Selector="Border.unread">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="{x:Static showcase:Palette.Coral}" />
        </Style>

        <Style Selector="Button.pill">
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="14,4" />
            <Setter Property="Background" Value="{x:Static showcase:Palette.Accent}" />
            <Setter Property="Foreground" Value="{x:Static showcase:Palette.Background}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </showcase:ShowcasePage.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
        <Border Grid.Row="0" Classes="rail showcase">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                <TextBlock Classes="eyebrow showcase" Text="ACTIVITY" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Classes="caption" Text="Unread" VerticalAlignment="Center" />
                    <Border x:Name="Badge" Classes="badge showcase"
                            presto:Animate.Watch="{Binding UnreadCount}" presto:Animate.OnChanged="{StaticResource BadgePop}">
                        <TextBlock Text="{Binding UnreadCount}" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Classes="rail showcase">
            <WrapPanel ItemSpacing="16" LineSpacing="8">
                <ComboBox x:Name="RevealBox" Width="130" VerticalAlignment="Center" SelectionChanged="RevealChanged">
                    <ComboBoxItem>Reveal off</ComboBoxItem>
                    <ComboBoxItem>Reveal once</ComboBoxItem>
                    <ComboBoxItem>Every time</ComboBoxItem>
                </ComboBox>
                <ToggleSwitch x:Name="UseOnAttached" OnContent="Use OnAttached" OffContent="Use OnAttached"
                              VerticalAlignment="Center" IsCheckedChanged="RevealChanged" />
                <TextBlock Classes="caption" VerticalAlignment="Center" Text="{Binding InitialPlayed, StringFormat='Initial {0}'}" />
                <TextBlock Classes="caption" VerticalAlignment="Center" Text="{Binding RevealPlayed, StringFormat='Reveal {0}'}" />
                <TextBlock Classes="caption" VerticalAlignment="Center" Text="{Binding EnterPlayed, StringFormat='Enter {0}'}" />
                <TextBlock Classes="caption" VerticalAlignment="Center" Text="{Binding ExitPlayed, StringFormat='Exit {0}'}" />
                <TextBlock Classes="caption" VerticalAlignment="Center" Text="{Binding AttachedPlayed, StringFormat='OnAttached {0}'}" />
                <TextBlock Classes="caption" VerticalAlignment="Center" Text="{Binding ChangedPlayed, StringFormat='OnChanged {0}'}" />
            </WrapPanel>
        </Border>

        <Border Grid.Row="2" Classes="stage">
            <Panel>
                <!-- snippet: ActivityFeedRows -->
                <ListBox x:Name="Feed" Classes="feed" ItemsSource="{Binding Items}"
                         presto:Animate.ItemLayout="{presto:Reflow}" presto:Presence.ScrollAnchor="True">
                    <ListBox.DataTemplates>
                        <!-- snippet-skip -->
                        <DataTemplate x:DataType="local:DayHeader">
                            <TextBlock Classes="eyebrow showcase day" Text="{Binding Label}"
                                       presto:Presence.Initial="{StaticResource RowInitial}"
                                       presto:Presence.Reveal="{DynamicResource RowReveal}"
                                       presto:Presence.RevealOnce="{DynamicResource RevealOnce}"
                                       presto:Animate.OnAttached="{DynamicResource RowAttached}" />
                        </DataTemplate>
                        <!-- /snippet-skip -->
                        <DataTemplate x:DataType="local:ActivityEvent">
                            <Border Classes="event"
                                    presto:Presence.Initial="{StaticResource RowInitial}"
                                    presto:Presence.Reveal="{DynamicResource RowReveal}"
                                    presto:Presence.RevealOnce="{DynamicResource RevealOnce}"
                                    presto:Animate.OnAttached="{DynamicResource RowAttached}"
                                    presto:Presence.Enter="{StaticResource RowEnter}"
                                    presto:Presence.Exit="{StaticResource RowExit}">
                                <!-- snippet-skip -->
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="12">
                                    <Border Classes="kind" Background="{Binding Tint}" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Classes="title" Text="{Binding Title}" />
                                        <TextBlock Classes="caption" Text="{Binding Byline}" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Classes="unread" IsVisible="{Binding Unread}" />
                                    <TextBlock Grid.Column="3" Classes="caption" Text="{Binding Clock}" VerticalAlignment="Center" />
                                    <Button Grid.Column="4" Content="Dismiss" Click="DismissClicked" VerticalAlignment="Center" />
                                </Grid>
                                <!-- /snippet-skip -->
                            </Border>
                        </DataTemplate>
                        <DataTemplate x:DataType="local:SkeletonRow">
                            <Border Classes="skeleton" presto:Animate.OnAttached="{StaticResource SkeletonShimmer}" />
                        </DataTemplate>
                    </ListBox.DataTemplates>
                </ListBox>
                <!-- /snippet -->

                <ContentControl x:Name="PillHost" Content="{Binding Unseen}"
                                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0">
                    <ContentControl.ContentTemplate>
                        <DataTemplate x:DataType="x:Int32">
                            <Button Classes="pill" Content="{Binding StringFormat='{}{0} new above'}" Click="PillClicked"
                                    presto:Presence.Arrive="{presto:Fade Direction=Down}"
                                    presto:Presence.Exit="{presto:Fade}" />
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </Panel>
        </Border>

        <showcase:CodePanel Grid.Row="3" Header="How it's built" IsExpanded="False"
                            Language="Xaml" Code="{x:Static showcase:Snippets.ActivityFeedRows}" />
    </Grid>
</showcase:ShowcasePage>
