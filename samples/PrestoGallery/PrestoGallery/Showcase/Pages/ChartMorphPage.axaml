<showcase:ShowcasePage xmlns="https://github.com/avaloniaui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:showcase="clr-namespace:PrestoGallery.Showcase"
                       xmlns:presto="https://github.com/stevemonaco/MonacoLabs.Presto"
                       xmlns:local="using:PrestoGallery.Showcase.Pages"
                       mc:Ignorable="d" d:DesignWidth="712" d:DesignHeight="440"
                       x:Class="PrestoGallery.Showcase.Pages.ChartMorphPage">
    <showcase:ShowcasePage.Styles>
        <Style Selector="TabStripItem">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,0" />
        </Style>
        <Style Selector="Canvas#Ticks TextBlock, Canvas#Categories TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{x:Static showcase:Palette.InkDim}" />
        </Style>
        <Style Selector="Path.point">
            <Setter Property="presto:Motion.States">
                <presto:MotionStates>
                    <presto:MotionState When=":pointerover" Motion="{x:Static local:ChartMorphPage.Lift}" Leave="{x:Static local:ChartMorphPage.Drop}" />
                </presto:MotionStates>
            </Setter>
        </Style>
    </showcase:ShowcasePage.Styles>

    <DockPanel>
        <showcase:CodePanel DockPanel.Dock="Bottom" x:Name="HowCode" Header="How it's built" IsExpanded="False" Margin="0,10,0,0" />

        <Border DockPanel.Dock="Top" Classes="rail showcase" Margin="0,0,0,10">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Shuffle" Click="ShuffleClicked" />
                <TabStrip x:Name="Views" SelectedIndex="0" SelectionChanged="ViewChanged">
                    <TabStrip.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </TabStrip.ItemsPanel>
                    <TabStripItem Content="Bars" />
                    <TabStripItem Content="Donut" />
                    <TabStripItem Content="Scatter" />
                    <TabStripItem Content="Line" />
                </TabStrip>
            </DockPanel>
        </Border>

        <Border Classes="stage" Padding="14">
            <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid ColumnDefinitions="40,Auto" RowDefinitions="Auto,Auto,Auto">
                    <TextBlock Grid.ColumnSpan="2" x:Name="Unit" Classes="caption" Margin="0,0,0,10" Text="k visits" />
                    <Canvas Grid.Row="1" x:Name="Ticks" />
                    <Canvas Grid.Row="1" Grid.Column="1" x:Name="Plot" Width="600" Height="280">
                        <Canvas x:Name="Axes" IsHitTestVisible="False" />
                        <Path x:Name="LineStroke" Stroke="{x:Static showcase:Palette.InkDim}" StrokeThickness="2.5"
                              StrokeJoin="Round" StrokeLineCap="Round" IsHitTestVisible="False" />
                        <Border x:Name="Tip" Width="200" Padding="8,4" CornerRadius="6" BorderThickness="1" Opacity="0"
                                IsHitTestVisible="False" Background="{x:Static showcase:Palette.SurfaceHigh}"
                                BorderBrush="{x:Static showcase:Palette.Border}">
                            <TextBlock x:Name="TipText" FontSize="12" HorizontalAlignment="Center"
                                       Foreground="{x:Static showcase:Palette.Ink}" />
                        </Border>
                    </Canvas>
                    <Canvas Grid.Row="2" Grid.Column="1" x:Name="Categories" Height="24" />
                </Grid>
            </Viewbox>
        </Border>
    </DockPanel>
</showcase:ShowcasePage>
