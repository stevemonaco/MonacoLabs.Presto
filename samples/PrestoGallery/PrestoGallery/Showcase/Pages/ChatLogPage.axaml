<showcase:ShowcasePage xmlns="https://github.com/avaloniaui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:showcase="clr-namespace:PrestoGallery.Showcase"
                       xmlns:presto="https://github.com/stevemonaco/MonacoLabs.Presto"
                       xmlns:local="using:PrestoGallery.Showcase.Pages"
                       mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="760"
                       x:Class="PrestoGallery.Showcase.Pages.ChatLogPage" FillsViewport="True"
                       x:DataType="local:ChatLogViewModel">
    <showcase:ShowcasePage.DataContext>
        <local:ChatLogViewModel />
    </showcase:ShowcasePage.DataContext>

    <showcase:ShowcasePage.Styles>
        <Style Selector="Border.stage">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style Selector="ListBox.log">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.log ListBoxItem">
            <Setter Property="Padding" Value="16,4" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="ListBox.log ListBoxItem /template/ ContentPresenter#PART_ContentPresenter,
                         ListBox.log ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                         ListBox.log ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter,
                         ListBox.log ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Border.bubble">
            <Setter Property="MaxWidth" Value="460" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="{x:Static showcase:Palette.SurfaceHigh}" />
        </Style>
        <Style Selector="Border.bubble.mine">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Background" Value="{x:Static showcase:Palette.AccentDim}" />
        </Style>
        <Style Selector="Border.bubble TextBlock.text">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{x:Static showcase:Palette.Ink}" />
        </Style>

        <Style Selector="Button.pill">
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="14,4" />
            <Setter Property="Background" Value="{x:Static showcase:Palette.Accent}" />
            <Setter Property="Foreground" Value="{x:Static showcase:Palette.Background}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </showcase:ShowcasePage.Styles>

    <Grid RowDefinitions="*,Auto,Auto" RowSpacing="10">
        <Border Grid.Row="0" Classes="stage">
            <Panel>
                <!-- snippet: ChatLogList -->
                <ListBox x:Name="Log" Classes="log" ItemsSource="{Binding Messages}">
                    <ListBox.Styles>
                        <Style Selector="ListBox /template/ ScrollViewer#PART_ScrollViewer">
                            <Setter Property="presto:Scroll.StickToEnd" Value="True" />
                        </Style>
                        <Style Selector="Border.bubble">
                            <Setter Property="presto:Presence.Enter" Value="{presto:Fade Direction=Right, Distance=16}" />
                        </Style>
                        <Style Selector="Border.bubble.mine">
                            <Setter Property="presto:Presence.Enter" Value="{presto:Fade Direction=Left, Distance=16}" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="local:ChatMessage">
                            <Border Classes="bubble" Classes.mine="{Binding Mine}">
                                <!-- snippet-skip -->
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="caption" Text="{Binding Author}" />
                                    <TextBlock Classes="text" Text="{Binding Text}" />
                                </StackPanel>
                                <!-- /snippet-skip -->
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button x:Name="JumpPill" Classes="pill" Content="Jump to newest" Click="JumpToNewest"
                        IsVisible="{Binding Behind}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12"
                        presto:Presence.HideMode="Ghost"
                        presto:Presence.Enter="{presto:Fade Direction=Up}"
                        presto:Presence.Exit="{presto:Fade}" />
                <!-- /snippet -->
            </Panel>
        </Border>

        <Border Grid.Row="1" Classes="rail showcase">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <TextBox x:Name="Draft" PlaceholderText="Message" />
                <Button Grid.Column="1" Content="Send" IsDefault="True" Click="SendClicked" />
            </Grid>
        </Border>

        <showcase:CodePanel Grid.Row="2" Header="How it's built" IsExpanded="False"
                            Language="Xaml" Code="{x:Static showcase:Snippets.ChatLogList}" />
    </Grid>
</showcase:ShowcasePage>
