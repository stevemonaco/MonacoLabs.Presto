<showcase:ShowcasePage xmlns="https://github.com/avaloniaui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:showcase="clr-namespace:PrestoGallery.Showcase"
                       mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
                       x:Class="PrestoGallery.Showcase.Pages.ConnectedNavPage"
                       Focusable="True">
    <showcase:ShowcasePage.Styles>
        <Style Selector="TextBlock.city">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{x:Static showcase:Palette.Ink}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="TextBlock.city.hero">
            <Setter Property="FontSize" Value="30" />
        </Style>
        <Style Selector="TextBlock.title">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{x:Static showcase:Palette.Ink}" />
        </Style>
        <Style Selector="TextBlock.blurb">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{x:Static showcase:Palette.InkDim}" />
        </Style>
        <Style Selector="Border.fact">
            <Setter Property="Background" Value="{x:Static showcase:Palette.SurfaceHigh}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>
        <Style Selector="Border.fact > TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{x:Static showcase:Palette.Ink}" />
        </Style>
    </showcase:ShowcasePage.Styles>

    <StackPanel Spacing="12">
        <StackPanel Orientation="Horizontal" Spacing="24">
            <ToggleSwitch x:Name="SlowMotion" OnContent="Slow motion" OffContent="Slow motion" />
            <ToggleSwitch x:Name="JamUi" OnContent="Block the UI thread for 1.5 s on navigation"
                          OffContent="Block the UI thread for 1.5 s on navigation" />
        </StackPanel>
        <Border x:Name="Stage" Width="712" Height="440" Padding="16" CornerRadius="12" HorizontalAlignment="Left"
                Background="{x:Static showcase:Palette.Surface}">
            <Border x:Name="Host" />
        </Border>
        <showcase:CodePanel x:Name="HowCode" Header="How it's built" IsExpanded="False" MaxHeight="280" />
    </StackPanel>
</showcase:ShowcasePage>
