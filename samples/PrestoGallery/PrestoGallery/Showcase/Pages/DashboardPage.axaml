<showcase:ShowcasePage xmlns="https://github.com/avaloniaui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:showcase="clr-namespace:PrestoGallery.Showcase"
                       mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="860"
                       x:Class="PrestoGallery.Showcase.Pages.DashboardPage">
    <showcase:ShowcasePage.Styles>
        <Style Selector="Border.stage">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="14" />
        </Style>
        <Style Selector="Border.card.showcase">
            <Setter Property="Width" Value="NaN" />
        </Style>
        <Style Selector="TextBlock.readout">
            <Setter Property="FontSize" Value="30" />
        </Style>
        <Style Selector="UniformGrid#Tiles">
            <Setter Property="Columns" Value="4" />
        </Style>
        <ContainerQuery Name="page" Query="max-width:599">
            <Style Selector="UniformGrid#Tiles">
                <Setter Property="Columns" Value="2" />
            </Style>
        </ContainerQuery>
    </showcase:ShowcasePage.Styles>

    <Grid Container.Name="page" Container.Sizing="Width" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
        <Border Grid.Row="0" Classes="rail showcase">
            <WrapPanel ItemSpacing="12" LineSpacing="8">
                <Button x:Name="NewData" Content="New data" Click="PushRound" />
                <ToggleSwitch x:Name="Live" VerticalAlignment="Center"
                              OffContent="live off" OnContent="live · 800 ms" IsCheckedChanged="LiveChanged" />
                <TextBlock x:Name="FeedText" Classes="mono" Margin="0"
                           VerticalAlignment="Center" Text="round 0 · feed 0 ms" />
            </WrapPanel>
        </Border>

        <UniformGrid Grid.Row="1" x:Name="Tiles" ColumnSpacing="10" RowSpacing="10" />

        <showcase:SplitPanel Grid.Row="2" Widths="*,250" Spacing="10">
            <StackPanel Spacing="10">
                <Border Classes="stage" Height="222">
                    <Grid RowDefinitions="Auto,*">
                        <TextBlock Grid.Row="0" Classes="eyebrow showcase" Text="THROUGHPUT BY CHANNEL" />
                        <Viewbox StretchDirection="DownOnly" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                            <StackPanel x:Name="BarField" Orientation="Horizontal" Spacing="14" />
                        </Viewbox>
                    </Grid>
                </Border>

                <Border Classes="stage" Height="148">
                    <Grid RowDefinitions="Auto,*">
                        <TextBlock Grid.Row="0" Classes="eyebrow showcase" Text="SESSIONS, LAST HOUR" />
                        <Viewbox StretchDirection="DownOnly" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                            <Canvas x:Name="Plot" Width="600" Height="96">
                                <Path x:Name="Spark" Stretch="None" StrokeThickness="3"
                                      Stroke="{x:Static showcase:Palette.Aqua}"
                                      StrokeLineCap="Round" StrokeJoin="Round" />
                            </Canvas>
                        </Viewbox>
                    </Grid>
                </Border>
            </StackPanel>

            <Border Classes="stage">
                <StackPanel Spacing="10">
                    <TextBlock Classes="eyebrow showcase" Text="MIX" />
                    <Canvas x:Name="DonutStage" Width="180" Height="180" HorizontalAlignment="Center" />
                    <StackPanel x:Name="Legend" Spacing="6" />
                </StackPanel>
            </Border>
        </showcase:SplitPanel>

        <showcase:TransportBar Grid.Row="3" x:Name="Bar" />

        <showcase:CodePanel Grid.Row="4" x:Name="HowCode" Header="How it's built" IsExpanded="False" />
    </Grid>
</showcase:ShowcasePage>
