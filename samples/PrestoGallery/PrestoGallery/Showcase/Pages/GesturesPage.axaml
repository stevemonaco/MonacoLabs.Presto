<showcase:ShowcasePage xmlns="https://github.com/avaloniaui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:showcase="clr-namespace:PrestoGallery.Showcase"
                       xmlns:presto="https://github.com/stevemonaco/MonacoLabs.Presto"
                       mc:Ignorable="d" d:DesignWidth="712" d:DesignHeight="440"
                       x:Class="PrestoGallery.Showcase.Pages.GesturesPage">
    <showcase:ShowcasePage.Resources>
        <StreamGeometry x:Key="ArchiveIcon">M1,2 L15,2 L15,6 L1,6 Z M2,7 L14,7 L14,15 L2,15 Z M5.5,9 L10.5,9 L10.5,10.5 L5.5,10.5 Z</StreamGeometry>
        <StreamGeometry x:Key="DeleteIcon">M5.5,1 L10.5,1 L10.5,3 L14.5,3 L14.5,5 L1.5,5 L1.5,3 L5.5,3 Z M2.5,6 L13.5,6 L12.5,15 L3.5,15 Z</StreamGeometry>
    </showcase:ShowcasePage.Resources>
    <showcase:ShowcasePage.Styles>
        <Style Selector="Border.panel TextBlock.mono">
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="Border.row">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Background" Value="{x:Static showcase:Palette.SurfaceHigh}" />
        </Style>
        <Style Selector="Border.row TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{x:Static showcase:Palette.Ink}" />
        </Style>
        <Style Selector="Border.row TextBlock.caption">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{x:Static showcase:Palette.InkDim}" />
        </Style>
        <Style Selector="Button.swipe">
            <Setter Property="Width" Value="56" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.swipe PathIcon">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
        </Style>
        <Style Selector="Button.swipe /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{x:Static showcase:Palette.Background}" />
        </Style>
        <Style Selector="Button.archive /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{x:Static showcase:Palette.Aqua}" />
        </Style>
        <Style Selector="Button.delete /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{x:Static showcase:Palette.Coral}" />
        </Style>
        <Style Selector="UniformGrid#Tiles">
            <Setter Property="Columns" Value="4" />
        </Style>
        <Style Selector="UniformGrid#Tiles > Border">
            <Setter Property="Height" Value="420" />
        </Style>
        <ContainerQuery Name="page" Query="max-width:639">
            <Style Selector="UniformGrid#Tiles">
                <Setter Property="Columns" Value="2" />
            </Style>
        </ContainerQuery>
        <ContainerQuery Name="page" Query="max-width:399">
            <Style Selector="UniformGrid#Tiles">
                <Setter Property="Columns" Value="1" />
            </Style>
        </ContainerQuery>
    </showcase:ShowcasePage.Styles>

    <StackPanel Container.Name="page" Container.Sizing="Width" Spacing="12">
        <UniformGrid x:Name="Tiles" ColumnSpacing="12" RowSpacing="12">
            <Border Classes="panel showcase">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock DockPanel.Dock="Right" x:Name="PullVelocity" Classes="mono" Text="0.00" />
                        <TextBlock Classes="eyebrow showcase" Text="PULL TO REFRESH" />
                    </DockPanel>
                    <Border Background="{x:Static showcase:Palette.Surface}">
                        <!-- snippet: GesturesPull -->
                        <presto:PullToRefresh x:Name="Puller" Foreground="{x:Static showcase:Palette.AccentBright}">
                            <StackPanel x:Name="Feed" Spacing="4" Background="{x:Static showcase:Palette.Surface}" />
                        </presto:PullToRefresh>
                        <!-- /snippet -->
                    </Border>
                </DockPanel>
            </Border>

            <Border Classes="panel showcase">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,10" Classes="eyebrow showcase" Text="SWIPE TO DISMISS" />
                    <Button DockPanel.Dock="Bottom" x:Name="UndoButton" Classes="specimen" Content="Undo"
                            IsEnabled="False" Click="UndoClicked" />
                    <ItemsControl x:Name="Inbox" ClipToBounds="True" />
                </DockPanel>
            </Border>

            <Border Classes="panel showcase">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock DockPanel.Dock="Right" x:Name="CurtainVelocity" Classes="mono" Text="0.00" />
                        <TextBlock Classes="eyebrow showcase" Text="CURTAIN" />
                    </DockPanel>
                    <Panel x:Name="CurtainStage" ClipToBounds="True">
                        <StackPanel x:Name="Home" Spacing="4" Margin="0,36,0,0">
                            <TextBlock Text="09:41" FontSize="40" FontWeight="Light" HorizontalAlignment="Center"
                                       Foreground="{x:Static showcase:Palette.Ink}" />
                        </StackPanel>
                        <!-- snippet: GesturesCurtainSheet -->
                        <presto:Sheet x:Name="Curtain" Edge="Top" Detents="28,0.5,1" Scrim="#990B0E14">
                            <Border Background="{x:Static showcase:Palette.AccentDeep}" CornerRadius="0,0,10,10"
                                    Margin="0,-40,0,0">
                                <DockPanel>
                                    <Border x:Name="Handle" DockPanel.Dock="Bottom" Height="28" Background="Transparent"
                                            Cursor="Hand">
                                        <Border Width="36" Height="4" CornerRadius="2"
                                                Background="{x:Static showcase:Palette.AccentBright}" />
                                    </Border>
                                    <StackPanel x:Name="Notifications" Spacing="4" Margin="8,0" VerticalAlignment="Bottom">
                                        <TextBlock Classes="eyebrow showcase" Text="NOTIFICATIONS" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </presto:Sheet>
                        <!-- /snippet -->
                    </Panel>
                </DockPanel>
            </Border>

            <Border Classes="panel showcase">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock DockPanel.Dock="Right" x:Name="SheetVelocity" Classes="mono" Text="0.00" />
                        <TextBlock Classes="eyebrow showcase" Text="BOTTOM SHEET" />
                    </DockPanel>
                    <Panel ClipToBounds="True">
                        <TextBlock Text="Flick it" FontSize="28" FontWeight="Light" Margin="0,36,0,0"
                                   HorizontalAlignment="Center" Foreground="{x:Static showcase:Palette.InkDim}" />
                        <presto:Sheet x:Name="QueueSheet" Detents="52,1">
                            <Border Background="{x:Static showcase:Palette.AccentDeep}" CornerRadius="10,10,0,0"
                                    Margin="0,24,0,0">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Height="28" Background="Transparent" Cursor="Hand">
                                        <Border Width="36" Height="4" CornerRadius="2"
                                                Background="{x:Static showcase:Palette.AccentBright}" />
                                    </Border>
                                    <StackPanel x:Name="Queue" Spacing="4" Margin="8,0">
                                        <TextBlock Classes="eyebrow showcase" Text="UP NEXT" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </presto:Sheet>
                    </Panel>
                </DockPanel>
            </Border>
        </UniformGrid>

        <Border Height="320" Classes="panel showcase">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock DockPanel.Dock="Right" x:Name="CardProgress" Classes="mono" Text="0.00" />
                    <TextBlock Classes="eyebrow showcase" Text="DRAG TO OPEN" />
                </DockPanel>
                <Border x:Name="OpenCard" Width="300" Height="64" VerticalAlignment="Top" CornerRadius="10"
                        ClipToBounds="True" Background="{x:Static showcase:Palette.AccentDeep}">
                    <DockPanel>
                        <Panel x:Name="CardHandle" DockPanel.Dock="Bottom" Height="28" Background="Transparent"
                               Cursor="Hand">
                            <Border Width="36" Height="4" CornerRadius="2"
                                    Background="{x:Static showcase:Palette.AccentBright}" />
                            <Border x:Name="CardProxy" IsHitTestVisible="False" />
                        </Panel>
                        <TextBlock DockPanel.Dock="Top" Margin="10,14,10,8" Classes="eyebrow showcase" Text="RECENTLY PLAYED" />
                        <StackPanel x:Name="CardRows" Spacing="4" Margin="8,0" ClipToBounds="True" />
                    </DockPanel>
                </Border>
            </DockPanel>
        </Border>

        <Border MinHeight="220" Classes="panel showcase">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Margin="0,0,0,10" Classes="eyebrow showcase" Text="TRAILS" />
                <showcase:SplitPanel Widths="*,280" Spacing="12" Breakpoint="560">
                    <Canvas x:Name="TrailStage" ClipToBounds="True" Background="{x:Static showcase:Palette.Surface}" />
                    <Grid x:Name="ResistStage" RowDefinitions="*,*" Background="{x:Static showcase:Palette.Surface}">
                        <Border x:Name="Knob" Width="24" Height="24" CornerRadius="12" BorderThickness="2" Cursor="Hand"
                                BorderBrush="{x:Static showcase:Palette.AccentBright}" Background="Transparent" />
                        <Border Grid.Row="1" Width="184" Height="4" CornerRadius="2" Background="{x:Static showcase:Palette.SurfaceHigh}" />
                        <Border Grid.Row="1" x:Name="Indicator" Width="24" Height="24" CornerRadius="12"
                                Background="{x:Static showcase:Palette.AccentBright}" />
                    </Grid>
                </showcase:SplitPanel>
            </DockPanel>
        </Border>

        <showcase:CodePanel x:Name="HowCode" Header="How it's built" IsExpanded="False" />
    </StackPanel>
</showcase:ShowcasePage>
