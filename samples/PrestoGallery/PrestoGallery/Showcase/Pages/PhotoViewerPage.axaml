<showcase:ShowcasePage xmlns="https://github.com/avaloniaui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:presto="https://github.com/stevemonaco/MonacoLabs.Presto"
                       xmlns:showcase="clr-namespace:PrestoGallery.Showcase"
                       mc:Ignorable="d" d:DesignWidth="712" d:DesignHeight="440"
                       x:Class="PrestoGallery.Showcase.Pages.PhotoViewerPage" FillsViewport="True">
    <DockPanel>
        <WrapPanel ItemSpacing="16" LineSpacing="4" DockPanel.Dock="Top" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="eyebrow showcase" Text="SCALE" VerticalAlignment="Center" />
                <TextBlock Width="60" x:Name="ScaleText" Classes="mono" Text="1.00" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="eyebrow showcase" Text="ROTATION" VerticalAlignment="Center" />
                <TextBlock Width="60" x:Name="RotationText" Classes="mono" Text="0.0" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="eyebrow showcase" Text="RELEASE PX/MS" VerticalAlignment="Center" />
                <TextBlock Width="60" x:Name="VelocityText" Classes="mono" Text="0.00" VerticalAlignment="Center" />
            </StackPanel>
            <Button x:Name="ResetButton" Classes="specimen" Content="Reset" Click="ResetClicked" />
        </WrapPanel>

        <showcase:CodePanel DockPanel.Dock="Bottom" Header="How it's built" IsExpanded="False" MaxHeight="280" Margin="0,12,0,0"
                            Code="{x:Static showcase:Snippets.PhotoViewerTransformable}" />

        <ListBox DockPanel.Dock="Bottom" x:Name="Filmstrip" Margin="0,10,0,0" HorizontalAlignment="Center"
                 Background="Transparent" SelectedIndex="{Binding #Photos.SelectedIndex, Mode=TwoWay}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="6" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>

        <Panel>
            <presto:FilteredImage x:Name="Backdrop" Stretch="UniformToFill" Brightness="0.35" SourceTransition="Dissolve 700" />
            <Carousel x:Name="Photos" ClipToBounds="True" IsSwipeEnabled="True" SelectionChanged="PhotoChanged"
                      PageTransition="{presto:PageSlide Edge=Right}" />
        </Panel>
    </DockPanel>
</showcase:ShowcasePage>
