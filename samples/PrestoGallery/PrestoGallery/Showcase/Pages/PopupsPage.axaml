<showcase:ShowcasePage xmlns="https://github.com/avaloniaui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:showcase="clr-namespace:PrestoGallery.Showcase"
                       xmlns:presto="https://github.com/stevemonaco/MonacoLabs.Presto"
                       mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="760"
                       x:Class="PrestoGallery.Showcase.Pages.PopupsPage">
    <showcase:ShowcasePage.Resources>
        <StreamGeometry x:Key="NewIcon">M3,1 L9,1 L13,5 L13,15 L3,15 Z M9,1 L9,5 L13,5</StreamGeometry>
        <StreamGeometry x:Key="FolderIcon">M1,3 L6,3 L8,5 L15,5 L15,14 L1,14 Z</StreamGeometry>
        <StreamGeometry x:Key="SaveIcon">M2,1 L12,1 L15,4 L15,15 L2,15 Z M5,1 L5,5 L11,5 L11,1 M5,15 L5,10 L12,10 L12,15</StreamGeometry>
        <StreamGeometry x:Key="ExportIcon">M8,10 L8,1 M4.5,4.5 L8,1 L11.5,4.5 M2,9 L2,15 L14,15 L14,9</StreamGeometry>
        <StreamGeometry x:Key="RenameIcon">M2,14 L2,11 L11,2 L14,5 L5,14 Z</StreamGeometry>
        <StreamGeometry x:Key="DuplicateIcon">M5,5 L14,5 L14,14 L5,14 Z M2,11 L2,2 L11,2</StreamGeometry>
        <StreamGeometry x:Key="TrashIcon">M2,4 L14,4 M6,4 L6,2 L10,2 L10,4 M3.5,4 L4.5,15 L11.5,15 L12.5,4</StreamGeometry>
        <StreamGeometry x:Key="SparkIcon">M8,1 L9.6,6.4 L15,8 L9.6,9.6 L8,15 L6.4,9.6 L1,8 L6.4,6.4 Z</StreamGeometry>
    </showcase:ShowcasePage.Resources>

    <showcase:ShowcasePage.Styles>
        <Style Selector="Border.toolbar">
            <Setter Property="Background" Value="{x:Static showcase:Palette.SurfaceHigh}" />
            <Setter Property="BorderBrush" Value="{x:Static showcase:Palette.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8" />
        </Style>
        <Style Selector="Border.tile">
            <Setter Property="Width" Value="150" />
            <Setter Property="Height" Value="96" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{x:Static showcase:Palette.Border}" />
            <Setter Property="Background" Value="{x:Static showcase:Palette.SurfaceHigh}" />
            <Setter Property="presto:Motion.Hover" Value="{presto:Lift}" />
        </Style>
        <Style Selector="Border.avatar">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="CornerRadius" Value="17" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="{x:Static showcase:Palette.Surface}" />
            <Setter Property="Margin" Value="0,0,-8,0" />
        </Style>
        <Style Selector="Border.avatar > TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{x:Static showcase:Palette.Background}" />
        </Style>
        <Style Selector="Ellipse.dot">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="MenuItem.danger">
            <Setter Property="Foreground" Value="{x:Static showcase:Palette.Coral}" />
        </Style>

        <!-- snippet: PopupsStyles -->
        <!-- Every presenter scales and slides out of its anchor; the Share flyout sets its own, which wins. -->
        <Style Selector="MenuFlyoutPresenter, ContextMenu, ToolTip, ComboBox /template/ Popup#PART_Popup">
            <Setter Property="presto:Popover.Open" Value="{presto:Popover}" />
            <Setter Property="presto:Popover.Close" Value="{presto:Popover Out=True}" />
        </Style>
        <!-- Their rows arrive with every open, a beat after the presenter and one after another. -->
        <Style Selector="MenuFlyoutPresenter > MenuItem, ContextMenu > MenuItem, ComboBoxItem">
            <Setter Property="presto:Presence.Arrive" Value="{presto:Fade Direction=Right, Distance=10, Delay=40, Stagger=32, Ease=outCubic}" />
        </Style>
        <Style Selector="Border.avatar">
            <Setter Property="presto:Presence.Arrive" Value="{presto:Pop Scale=0.4, Delay=90, Stagger=55, Ease=outBack}" />
        </Style>
        <Style Selector="StackPanel.tip > TextBlock">
            <Setter Property="presto:Presence.Arrive" Value="{presto:Fade Direction=Up, Distance=6, Delay=60, Stagger=50}" />
        </Style>
        <!-- /snippet -->
    </showcase:ShowcasePage.Styles>

    <Grid RowDefinitions="*,Auto" RowSpacing="10">
        <Border Grid.Row="0" Classes="stage">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="28">
                <Border Classes="toolbar" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button x:Name="MenuButton" Classes="specimen" Content="File">
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                    <MenuItem Header="New sketch" InputGesture="Ctrl+N">
                                        <MenuItem.Icon><PathIcon Data="{StaticResource NewIcon}" /></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Open…" InputGesture="Ctrl+O">
                                        <MenuItem.Icon><PathIcon Data="{StaticResource FolderIcon}" /></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Save" InputGesture="Ctrl+S">
                                        <MenuItem.Icon><PathIcon Data="{StaticResource SaveIcon}" /></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Export as PNG" InputGesture="Ctrl+E">
                                        <MenuItem.Icon><PathIcon Data="{StaticResource ExportIcon}" /></MenuItem.Icon>
                                    </MenuItem>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>

                        <Button x:Name="ShareButton" Classes="specimen" Content="Share">
                            <Button.Flyout>
                                <Flyout Placement="Bottom"
                                        presto:Popover.Open="{presto:Popover Distance=18, Scale=0.85, Duration=360, Ease=outBack}"
                                        presto:Popover.Close="{presto:Popover Distance=10}">
                                    <StackPanel Width="250" Spacing="12">
                                        <TextBlock Text="Share “Aurora”" FontWeight="SemiBold" />
                                        <StackPanel Orientation="Horizontal">
                                            <Border Classes="avatar" Background="{x:Static showcase:Palette.Accent}"><TextBlock Text="AK" /></Border>
                                            <Border Classes="avatar" Background="{x:Static showcase:Palette.Aqua}"><TextBlock Text="MS" /></Border>
                                            <Border Classes="avatar" Background="{x:Static showcase:Palette.Amber}"><TextBlock Text="JL" /></Border>
                                            <Border Classes="avatar" Background="{x:Static showcase:Palette.Rose}"><TextBlock Text="+3" /></Border>
                                        </StackPanel>
                                        <TextBlock Classes="caption" TextWrapping="Wrap" Text="Six people can edit. Anyone with the link can view." />
                                        <showcase:CodePanel Code="presto.dev/s/aurora" Padding="10,6" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <ComboBox x:Name="Picker" SelectedIndex="0" Width="150" VerticalAlignment="Center">
                            <ComboBoxItem>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse Classes="dot" Fill="{x:Static showcase:Palette.Lime}" />
                                    <TextBlock Text="Online" />
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse Classes="dot" Fill="{x:Static showcase:Palette.Amber}" />
                                    <TextBlock Text="Away" />
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse Classes="dot" Fill="{x:Static showcase:Palette.Coral}" />
                                    <TextBlock Text="Busy" />
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse Classes="dot" Fill="{x:Static showcase:Palette.InkDim}" />
                                    <TextBlock Text="Invisible" />
                                </StackPanel>
                            </ComboBoxItem>
                        </ComboBox>

                        <Button x:Name="TipButton" Classes="specimen" Padding="10,8">
                            <PathIcon Data="{StaticResource SparkIcon}" Width="16" Height="16" />
                            <ToolTip.Tip>
                                <StackPanel Classes="tip" Spacing="4" MaxWidth="220">
                                    <TextBlock Text="A rich tooltip" FontWeight="SemiBold" />
                                    <TextBlock TextWrapping="Wrap" Foreground="{x:Static showcase:Palette.InkDim}" Text="Only here to show one: its lines rise in turn. The button itself does nothing." />
                                    <TextBlock FontFamily="Consolas,Menlo,monospace" FontSize="11" Foreground="{x:Static showcase:Palette.AccentBright}" Text="ToolTip.Tip + Popover" />
                                </StackPanel>
                            </ToolTip.Tip>
                        </Button>
                    </StackPanel>
                </Border>

                <StackPanel Spacing="10" HorizontalAlignment="Center">
                    <TextBlock Classes="caption" HorizontalAlignment="Center" Text="Right-click a sketch" />
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <StackPanel.Styles>
                            <Style Selector="Border.tile">
                                <!-- A template, so each tile gets a menu of its own. -->
                                <Setter Property="ContextMenu">
                                    <Template>
                                        <ContextMenu>
                                            <MenuItem Header="Rename" InputGesture="F2">
                                                <MenuItem.Icon><PathIcon Data="{StaticResource RenameIcon}" /></MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Duplicate" InputGesture="Ctrl+D">
                                                <MenuItem.Icon><PathIcon Data="{StaticResource DuplicateIcon}" /></MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Share…">
                                                <MenuItem.Icon><PathIcon Data="{StaticResource ExportIcon}" /></MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Classes="danger" Header="Delete" InputGesture="Delete">
                                                <MenuItem.Icon><PathIcon Data="{StaticResource TrashIcon}" Foreground="{x:Static showcase:Palette.Coral}" /></MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Template>
                                </Setter>
                            </Style>
                        </StackPanel.Styles>
                        <Border x:Name="ContextTarget" Classes="tile">
                            <StackPanel Spacing="4" VerticalAlignment="Bottom">
                                <Border Height="4" Width="40" HorizontalAlignment="Left" CornerRadius="2" Background="{x:Static showcase:Palette.Accent}" />
                                <TextBlock Text="Aurora" FontWeight="SemiBold" />
                                <TextBlock Classes="caption" Text="Edited 2 min ago" />
                            </StackPanel>
                        </Border>
                        <Border Classes="tile">
                            <StackPanel Spacing="4" VerticalAlignment="Bottom">
                                <Border Height="4" Width="40" HorizontalAlignment="Left" CornerRadius="2" Background="{x:Static showcase:Palette.Aqua}" />
                                <TextBlock Text="Tide pools" FontWeight="SemiBold" />
                                <TextBlock Classes="caption" Text="Edited yesterday" />
                            </StackPanel>
                        </Border>
                        <Border Classes="tile">
                            <StackPanel Spacing="4" VerticalAlignment="Bottom">
                                <Border Height="4" Width="40" HorizontalAlignment="Left" CornerRadius="2" Background="{x:Static showcase:Palette.Violet}" />
                                <TextBlock Text="Night market" FontWeight="SemiBold" />
                                <TextBlock Classes="caption" Text="Edited last week" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <showcase:CodePanel Grid.Row="1" Header="How it's built" IsExpanded="False"
                            Language="Xaml" Code="{x:Static showcase:Snippets.PopupsStyles}" />
    </Grid>
</showcase:ShowcasePage>
