<showcase:ShowcasePage xmlns="https://github.com/avaloniaui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:showcase="clr-namespace:PrestoGallery.Showcase"
                       mc:Ignorable="d" d:DesignWidth="712" d:DesignHeight="440"
                       x:Class="PrestoGallery.Showcase.Pages.SwipeDeckPage">
    <showcase:ShowcasePage.Styles>
        <Style Selector="Border.place">
            <Setter Property="Width" Value="240" />
            <Setter Property="Height" Value="300" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{x:Static showcase:Palette.Border}" />
            <Setter Property="Background" Value="{x:Static showcase:Palette.SurfaceHigh}" />
            <Setter Property="RenderTransformOrigin" Value="50%,100%" />
        </Style>
        <Style Selector="Border.place TextBlock">
            <Setter Property="Foreground" Value="{x:Static showcase:Palette.Ink}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="Border.place TextBlock.monogram">
            <Setter Property="FontSize" Value="72" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Opacity" Value="0.85" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.place TextBlock.caption">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{x:Static showcase:Palette.InkDim}" />
        </Style>
        <Style Selector="Border.stamp">
            <Setter Property="Margin" Value="14" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="BorderThickness" Value="3" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Border.stamp > TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Black" />
            <Setter Property="LetterSpacing" Value="2" />
        </Style>
        <Style Selector="Button.round">
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="52" />
            <Setter Property="CornerRadius" Value="26" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{x:Static showcase:Palette.SurfaceHigh}" />
            <Setter Property="BorderBrush" Value="{x:Static showcase:Palette.Border}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.round PathIcon">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
        </Style>
    </showcase:ShowcasePage.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="12">
            <Border MinHeight="440" CornerRadius="10" ClipToBounds="True" BorderThickness="1"
                    BorderBrush="{x:Static showcase:Palette.Border}" Background="{x:Static showcase:Palette.Surface}">
                <Panel>
                    <TextBlock Classes="eyebrow showcase" Margin="12" Text="SWIPE DECK" />
                    <StackPanel Spacing="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Panel x:Name="Deck" Width="240" Height="328" />
                        <StackPanel Orientation="Horizontal" Spacing="20" HorizontalAlignment="Center">
                            <Button x:Name="NopeButton" Classes="round" Click="NopeClicked">
                                <PathIcon Foreground="{x:Static showcase:Palette.Coral}"
                                          Data="M3,1.6 L8,6.6 L13,1.6 L14.4,3 L9.4,8 L14.4,13 L13,14.4 L8,9.4 L3,14.4 L1.6,13 L6.6,8 L1.6,3 Z" />
                            </Button>
                            <Button x:Name="UndoButton" Classes="round" IsEnabled="False" Click="UndoClicked">
                                <PathIcon Foreground="{x:Static showcase:Palette.Amber}"
                                          Data="M8,2 A6,6 0 1 1 2.3,10 L4.2,9.4 A4,4 0 1 0 8,4 L8,7 L3,3 L8,-1 Z" />
                            </Button>
                            <Button x:Name="LikeButton" Classes="round" Click="LikeClicked">
                                <PathIcon Foreground="{x:Static showcase:Palette.Aqua}" Data="{StaticResource HeartIcon}" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Panel>
            </Border>
            <showcase:CodePanel x:Name="GraphCode" Code="{x:Static showcase:Snippets.SwipeDeckBind}" />
        </StackPanel>
    </ScrollViewer>
</showcase:ShowcasePage>
