<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PrestoGallery.ViewModels"
             xmlns:presto="https://github.com/stevemonaco/MonacoLabs.Presto"
             xmlns:showcase="using:PrestoGallery.Showcase"
             xmlns:local="using:PrestoGallery.Views"
             mc:Ignorable="d" d:DesignWidth="240" d:DesignHeight="650"
             x:Class="PrestoGallery.Views.GalleryNav"
             x:DataType="vm:MainViewModel">
    <UserControl.Styles>
        <Style Selector="local|GalleryNav.compact TreeViewItem">
            <Setter Property="MinHeight" Value="44" />
        </Style>
        <Style Selector="local|GalleryNav.compact Button#CollapsePane">
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </UserControl.Styles>

    <Grid x:Name="Sidebar" RowDefinitions="*,Auto">
        <TreeView Name="Nav" Classes="nav showcase"
                  ItemsSource="{Binding VisibleSections}"
                  SelectedItem="{Binding NavSelectedPage, Mode=OneWay}"
                  SelectionChanged="NavSelectionChanged"
                  Tapped="NavTapped"
                  KeyDown="NavKeyDown"
                  presto:Animate.ItemLayout="{presto:Reflow}"
                  presto:Selection.Motion="{x:Static local:GalleryNav.Glide}">
            <TreeView.Styles>
                <Style Selector="TreeView > TreeViewItem" x:DataType="vm:NavSection">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    <Setter Property="presto:Presence.Exit" Value="{presto:Fade Direction=Left, Duration=180, Out=True}" />
                    <Setter Property="presto:Animate.ItemLayout" Value="{presto:Reflow}" />
                </Style>
                <Style Selector="TreeViewItem:not(:empty)">
                    <Setter Property="presto:Accordion.Enabled" Value="True" />
                </Style>
                <Style Selector="TreeViewItem /template/ Grid#PART_Header">
                    <Setter Property="presto:Presence.Initial" Value="{x:Static local:GalleryNav.RiseIn}" />
                </Style>
                <Style Selector="TreeViewItem /template/ Path#Chevron">
                    <Setter Property="presto:Accordion.Chevron" Value="90" />
                </Style>
                <Style Selector="TreeViewItem:empty">
                    <Setter Property="presto:Presence.Enter" Value="{x:Static local:GalleryNav.PageUnfolded}" />
                </Style>
                <!-- The selected page shows the selection pill instead of a hover. -->
                <Style Selector="TreeViewItem:empty:pointerover:not(:selected) /template/ Border#PART_LayoutRoot">
                    <Setter Property="presto:Motion.State" Value="hot" />
                </Style>
                <Style Selector="TreeViewItem /template/ Border#HoverFill">
                    <Setter Property="presto:Motion.States">
                        <presto:MotionStates>
                            <presto:MotionState When="hot" Motion="{x:Static local:GalleryNav.HoverFade}" />
                        </presto:MotionStates>
                    </Setter>
                </Style>
                <Style Selector="TreeViewItem:empty TextBlock">
                    <Setter Property="presto:Motion.States">
                        <presto:MotionStates>
                            <presto:MotionState When="hot" Motion="{x:Static local:GalleryNav.HoverNudge}" />
                        </presto:MotionStates>
                    </Setter>
                </Style>
            </TreeView.Styles>
            <TreeView.DataTemplates>
                <TreeDataTemplate x:DataType="vm:NavSection" ItemsSource="{Binding Pages}">
                    <TextBlock Classes="section" Text="{Binding Name}" />
                </TreeDataTemplate>
                <DataTemplate x:DataType="vm:GalleryPage">
                    <TextBlock Text="{Binding Title}" />
                </DataTemplate>
            </TreeView.DataTemplates>
        </TreeView>
        <TextBlock Classes="caption" Text="No samples match" Margin="18,16" IsVisible="{Binding HasNoMatches}" />

        <Border Grid.Row="1" Background="{x:Static showcase:Palette.Surface}" BorderBrush="{x:Static showcase:Palette.Border}"
                BorderThickness="0,1,1,0" Padding="16,10">
            <StackPanel Spacing="4">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4" Margin="0,0,0,8">
                    <TextBox x:Name="SearchBox" Classes="clearButton" PlaceholderText="Search samples"
                             Text="{Binding SearchText}" />
                    <Button x:Name="CollapsePane" Grid.Column="1" Background="Transparent" Padding="8" VerticalAlignment="Stretch"
                            Click="RequestCollapse" ToolTip.Tip="Hide sidebar (Ctrl+B)">
                        <Path Width="12" Height="12" Stretch="Uniform" Fill="{x:Static showcase:Palette.InkDim}"
                              Data="M9,0 L0,10 9,20 10,19 2,10 10,1 Z" />
                    </Button>
                </Grid>
                <TextBlock Classes="eyebrow showcase" Text="SETTINGS" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <ComboBox x:Name="MotionPicker" HorizontalAlignment="Stretch"
                              SelectedIndex="{Binding Motion}">
                        <ComboBoxItem Content="OS preference" />
                        <ComboBoxItem Content="Full motion" />
                        <ComboBoxItem Content="Reduced motion" />
                    </ComboBox>
                    <Border x:Name="MotionHelp" Grid.Column="1" Width="20" Height="20" CornerRadius="10"
                            VerticalAlignment="Center" Background="Transparent" BorderThickness="1"
                            BorderBrush="{x:Static showcase:Palette.InkDim}" ToolTip.ShowDelay="0">
                        <TextBlock Text="?" FontSize="12" FontWeight="SemiBold" Foreground="{x:Static showcase:Palette.InkDim}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <ToolTip.Tip>
                            <StackPanel MaxWidth="320" Spacing="6">
                                <TextBlock TextWrapping="Wrap" FontWeight="SemiBold"
                                           Text="Sets PrestoAvalonia.MotionPreference, bound as presto:Motion.Preference on the main view, which writes Presto.Defaults.ReducedMotion for every page. OS preference keeps the flag in step with the system's reduce-motion preference, re-read when the window is activated." />
                                <StackPanel Spacing="2">
                                    <TextBlock TextWrapping="Wrap" Text="• Recipes play a short fade with no travel" />
                                    <TextBlock TextWrapping="Wrap" Text="• Page transitions crossfade" />
                                    <TextBlock TextWrapping="Wrap" Text="• Text reveals fade the whole block" />
                                    <TextBlock TextWrapping="Wrap" Text="• Hover tilt stays flat" />
                                    <TextBlock TextWrapping="Wrap" Text="• Frame players hold their first frame" />
                                    <TextBlock TextWrapping="Wrap" Text="• Bindings, gesture releases and layout moves land at once" />
                                    <TextBlock TextWrapping="Wrap" Text="• Builder pages' loops, spins and shakes play calm WhenReduced forms" />
                                    <TextBlock TextWrapping="Wrap" Text="• Showcase pages stop their autoplay, parallax and endless loops" />
                                </StackPanel>
                                <TextBlock TextWrapping="Wrap" FontStyle="Italic"
                                           Text="Reference pages that link a Builder twin play in full on purpose: each shows one API's raw behavior, and its twin shows the reduced-motion-aware form. Other hand-written loops, such as Loaders, Particle field, Stress bench, DevTools, Compositor and Properties and keyframes, also play as normal. Animate.OnAttached loops and Motion states switch form at once; other animations pick up a change when the page is reopened or replayed." />
                            </StackPanel>
                        </ToolTip.Tip>
                    </Border>
                </Grid>
                <TextBlock Classes="caption" Text="{Binding SystemMotion}" />
                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Margin="0,4,0,0" Content="Presto DevTools" Click="ToggleDevTools"
                        ToolTip.Tip="Show or hide the Presto animation inspector (Ctrl+Shift+F12)" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
