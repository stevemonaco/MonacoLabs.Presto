<showcase:ShowcasePage xmlns="https://github.com/avaloniaui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:showcase="clr-namespace:PrestoSample.Showcase"
                       mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="1000"
                       x:Class="PrestoSample.Builder.WarpStudioPage">
    <showcase:ShowcasePage.Styles>
        <Style Selector="Grid#Controls TextBlock.caption">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="StackPanel#Lines TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="72" />
            <Setter Property="FontWeight" Value="Black" />
            <Setter Property="Foreground" Value="{x:Static showcase:Palette.AccentPale}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </showcase:ShowcasePage.Styles>

    <ScrollViewer>
        <StackPanel Spacing="16">
            <WrapPanel x:Name="PresetRow" ItemSpacing="8" LineSpacing="8" />

            <Border x:Name="Stage" Classes="stage" MinHeight="340">
                <StackPanel x:Name="Lines" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="MAKE" />
                    <TextBlock Text="TYPE" />
                    <TextBlock Text="MOVE" />
                </StackPanel>
            </Border>

            <Grid x:Name="Controls" ColumnDefinitions="Auto,*,32,Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="6">
                <TextBlock Classes="caption" Text="{Binding #WarpSlider.Value, StringFormat='Warp {0:0.00}'}" />
                <Slider x:Name="WarpSlider" Grid.Column="1" Minimum="-2" Maximum="2" Value="0.5" ValueChanged="SliderChanged" />
                <TextBlock Classes="caption" Grid.Row="1" Text="{Binding #PhaseSlider.Value, StringFormat='Phase {0:0.00}'}" />
                <Slider x:Name="PhaseSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="6.28" Value="0" ValueChanged="SliderChanged" />
                <TextBlock Classes="caption" Grid.Row="2" Text="{Binding #RadiusSlider.Value, StringFormat='Radius {0:0}'}" />
                <Slider x:Name="RadiusSlider" Grid.Row="2" Grid.Column="1" Minimum="20" Maximum="400" Value="160" ValueChanged="SliderChanged" />

                <TextBlock Classes="caption" Grid.Column="3" Text="Kind" />
                <ComboBox x:Name="KindBox" Grid.Column="4" MinWidth="160" SelectionChanged="SelectionChanged" />
                <TextBlock Classes="caption" Grid.Row="1" Grid.Column="3" Text="{Binding #StaggerSlider.Value, StringFormat='Stagger {0:0}'}" />
                <Slider x:Name="StaggerSlider" Grid.Row="1" Grid.Column="4" Minimum="0" Maximum="300" Value="120" ValueChanged="SliderChanged" />
                <StackPanel Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="16">
                    <CheckBox x:Name="FollowBox" Content="Follow pointer" IsCheckedChanged="CheckChanged" />
                    <CheckBox x:Name="AnimateBox" Content="Animate phase" IsChecked="True" IsCheckedChanged="CheckChanged" />
                </StackPanel>
            </Grid>

            <showcase:CodePanel x:Name="CodeText" />
        </StackPanel>
    </ScrollViewer>
</showcase:ShowcasePage>
