<showcase:ShowcasePage xmlns="https://github.com/avaloniaui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:showcase="clr-namespace:PrestoSample.Showcase"
                       xmlns:presto="using:Monaco.Presto.AvaloniaBridge"
                       xmlns:local="using:PrestoSample.Builder"
                       mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="1400"
                       x:Class="PrestoSample.Builder.XamlPage">
    <showcase:ShowcasePage.Styles>
        <Style Selector="TextBlock.row">
            <Setter Property="Background" Value="{x:Static showcase:Palette.SurfaceHigh}" />
            <Setter Property="Foreground" Value="{x:Static showcase:Palette.Ink}" />
            <Setter Property="Padding" Value="14,10" />
        </Style>
        <Style Selector="ListBox.reorder">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ItemTemplate">
                <DataTemplate x:DataType="x:String">
                    <TextBlock Classes="row" Text="{Binding}" />
                </DataTemplate>
            </Setter>
        </Style>
        <Style Selector="ListBox.reorder ListBoxItem">
            <Setter Property="Padding" Value="0,0,0,8" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
    </showcase:ShowcasePage.Styles>

    <ScrollViewer>
        <StackPanel Spacing="16">
            <Button Content="Replay" Click="Replay" HorizontalAlignment="Left" />
            <TextBlock Classes="caption" TextWrapping="Wrap" Text="Use Presence (Arrive, Initial, Enter, Exit) for entrances and exits, and Animate.OnAttached for loops and timers tied to being on screen, such as the looping star below." />
            <StackPanel x:Name="Demos" Spacing="32">
                <StackPanel Spacing="12">
                    <TextBlock Classes="caption" Text="{}{x:Static}: a fixed, named builder any view can reuse, written out in full" />
                    <Border Classes="stage" MinHeight="140">
                        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Classes="swatch" Width="64" Height="64" presto:Presence.Arrive="{x:Static local:XamlPage.FadeUp}" />
                            <Border Classes="swatch" Width="64" Height="64" presto:Presence.Arrive="{x:Static local:XamlPage.FadeUp}" />
                            <Border Classes="swatch" Width="64" Height="64" presto:Presence.Arrive="{x:Static local:XamlPage.FadeUp}" />
                            <Border Classes="swatch" Width="64" Height="64" presto:Presence.Arrive="{x:Static local:XamlPage.FadeUp}" />
                        </StackPanel>
                    </Border>
                    <Border Classes="codeblock">
                        <ScrollViewer>
                            <SelectableTextBlock Classes="code" Text="{x:Static local:XamlPage.StaticXaml}" />
                        </ScrollViewer>
                    </Border>
                    <Border Classes="codeblock">
                        <ScrollViewer>
                            <SelectableTextBlock x:Name="StaticCode" Classes="code" />
                        </ScrollViewer>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="12">
                    <TextBlock Classes="caption" Text="Recipe markup extension: {presto:Fade} provides a fresh Recipes.FadeUp builder per element, parameterised in the markup" />
                    <Border Classes="stage" MinHeight="0">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="row" Text="Inbox" presto:Presence.Arrive="{presto:Fade Direction=Up, Distance=48, Delay=0}" />
                            <TextBlock Classes="row" Text="Drafts" presto:Presence.Arrive="{presto:Fade Direction=Up, Distance=48, Delay=100}" />
                            <TextBlock Classes="row" Text="Sent" presto:Presence.Arrive="{presto:Fade Direction=Up, Distance=48, Delay=200}" />
                            <TextBlock Classes="row" Text="Archive" presto:Presence.Arrive="{presto:Fade Direction=Up, Distance=48, Delay=300}" />
                        </StackPanel>
                    </Border>
                    <Border Classes="codeblock">
                        <ScrollViewer>
                            <SelectableTextBlock Classes="code" Text="{x:Static local:XamlPage.ExtensionXaml}" />
                        </ScrollViewer>
                    </Border>
                    <Border Classes="codeblock">
                        <ScrollViewer>
                            <SelectableTextBlock x:Name="ExtensionCode" Classes="code" />
                        </ScrollViewer>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="12">
                    <TextBlock Classes="caption" Text="Binding: view state picks the animation, and the element re-animates when it changes" />
                    <Border Classes="stage" MinHeight="160">
                        <StackPanel Spacing="24" HorizontalAlignment="Center" VerticalAlignment="Center" x:DataType="local:EmphasisViewModel">
                            <StackPanel.DataContext>
                                <local:EmphasisViewModel />
                            </StackPanel.DataContext>
                            <ToggleSwitch IsChecked="{Binding IsAlert}" OffContent="Idle" OnContent="Alert" />
                            <PathIcon Data="{StaticResource StarIcon}" Width="48" Height="48" Foreground="{x:Static showcase:Palette.Amber}" presto:Animate.OnAttached="{Binding Emphasis}" />
                        </StackPanel>
                    </Border>
                    <Border Classes="codeblock">
                        <ScrollViewer>
                            <SelectableTextBlock Classes="code" Text="{x:Static local:XamlPage.BindingXaml}" />
                        </ScrollViewer>
                    </Border>
                    <Border Classes="codeblock">
                        <ScrollViewer>
                            <SelectableTextBlock x:Name="BindingCode" Classes="code" />
                        </ScrollViewer>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="12">
                    <TextBlock Classes="caption" TextWrapping="Wrap" Text="Reorder: drag a row to move it. {presto:Reorder} on the left is the default lift, and Intensity=2 on the right doubles its scale-up and shadow. Alt+Up/Down moves the focused row and Escape cancels a drag." />
                    <Border Classes="stage" MinHeight="0">
                        <UniformGrid Columns="2" ColumnSpacing="16">
                            <ListBox x:Name="DefaultLift" Classes="reorder" presto:Reorder.Enabled="True" presto:Reorder.Lift="{presto:Reorder}" presto:Animate.ItemLayout="{presto:Reflow}" />
                            <ListBox x:Name="StrongLift" Classes="reorder" presto:Reorder.Enabled="True" presto:Reorder.Lift="{presto:Reorder Intensity=2}" presto:Animate.ItemLayout="{presto:Reflow}" />
                        </UniformGrid>
                    </Border>
                    <Border Classes="codeblock">
                        <ScrollViewer>
                            <SelectableTextBlock Classes="code" Text="{x:Static local:XamlPage.ReorderXaml}" />
                        </ScrollViewer>
                    </Border>
                    <Border Classes="codeblock">
                        <ScrollViewer>
                            <SelectableTextBlock x:Name="ReorderCode" Classes="code" />
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</showcase:ShowcasePage>
