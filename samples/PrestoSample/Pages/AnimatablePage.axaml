<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="600"
             x:Class="PrestoSample.Pages.AnimatablePage">
    <UserControl.Styles>
        <!-- A circle would hide the Rotate the animatable writes. -->
        <Style Selector="Border.dot">
            <Setter Property="CornerRadius" Value="3" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Spacing="12">
            <Border x:Name="ParticleStage" Classes="stage" Height="330" PointerMoved="MoveParticles">
                <UniformGrid x:Name="Particles" Rows="11" Columns="11" Width="242" Height="242"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <TextBlock Classes="code" Text="var duration = Presto.Stagger(50, new() { Ease = &quot;in(1)&quot;, From = StaggerFrom.Center, Grid = [11, 11] });&#10;Presto.CreateAnimatable(dots, new AvaloniaAnimatableParams {&#10;    [&quot;X&quot;] = new() { Duration = duration },&#10;    [&quot;Y&quot;] = new() { Duration = duration },&#10;    [&quot;Rotate&quot;] = new() { Duration = 0 },&#10;    Ease = &quot;outElastic(.3, 1.4)&quot; });" />

            <TextBlock Classes="caption" TextWrapping="Wrap"
                       Text="Move the pointer over the grid. One animatable drives all 121 dots: their X and Y durations come from a centre-out stagger of 50 ms per grid step, so the middle dot is written straight through, the edges take 250 ms and the corners about 350 ms, each settling on outElastic(.3, 1.4). Rotate is registered with Duration = 0 and so is never animated — the bridge's Rotate shorthand is in degrees, so the angle to the cursor goes through Utils.RadToDeg." />

            <Border x:Name="FollowerStage" Classes="stage" MinHeight="0" Height="150" PointerMoved="MoveFollower">
                <Border x:Name="Follower" Classes="dot" Width="28" Height="28" CornerRadius="14"
                        HorizontalAlignment="Center" />
            </Border>

            <TextBlock Classes="code" Text="dot.CreateAnimatable(new() { [&quot;X&quot;] = 500, [&quot;Y&quot;] = 500, Ease = Eases.Out(3) })" />

            <TextBlock Classes="caption" TextWrapping="Wrap"
                       Text="The same API with one duration for both axes: every pointer move re-aims a 500 ms Out(3) tween from wherever the dot currently is. Set takes its own duration and ease when a single move should differ, and Revert drops the animation-priority values and leaves later Set calls as no-ops." />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Set(&quot;X&quot;, -140, 1200, &quot;inOutQuad&quot;)" Click="SetExplicit" />
                <Button Content="Fling()" Click="FlingFollower" />
                <Button Content="Revert()" Click="RevertFollower" />
            </StackPanel>

            <TextBlock Classes="code" Text="dot.Fling(&quot;X&quot;, new Inertia(0) { Min = -edge, Max = edge }).Fling(&quot;Y&quot;, …)" />

            <TextBlock Classes="caption" TextWrapping="Wrap"
                       Text="Press Set, then Fling while the dot moves: Fling measures the running tween's velocity and coasts from it, bouncing off the stage edge." />

            <Border x:Name="MomentumStage" Classes="stage" MinHeight="0" Height="150" PointerMoved="MoveMomentum">
                <Grid RowDefinitions="*,*">
                    <Border x:Name="MomentumDot" Classes="dot" Width="28" Height="28" CornerRadius="14"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Border x:Name="RestDot" Grid.Row="1" Classes="dot" Width="28" Height="28" CornerRadius="14" Opacity=".45"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <TextBlock Classes="code" Text="var spring = new Spring(stiffness: 90, damping: 9);&#10;momentumDot.CreateAnimatable(new() { [&quot;X&quot;] = new(), Ease = spring, PreserveVelocity = true });&#10;restDot.CreateAnimatable(new() { [&quot;X&quot;] = new(), Ease = spring });" />

            <TextBlock Classes="caption" TextWrapping="Wrap"
                       Text="Flick the pointer left and right across the stage. Both dots follow it on the same spring, but only the top one keeps its momentum: PreserveVelocity starts each retargeted spring with the velocity the dot already has, so it swings through the turn the way a thrown weight would. The faded dot starts every new spring from rest and stops dead each time the pointer changes direction. anime.js has no equivalent; it is opt-in here." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
