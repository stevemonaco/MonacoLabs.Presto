<showcase:ShowcasePage xmlns="https://github.com/avaloniaui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:presto="https://github.com/stevemonaco/MonacoLabs.Presto"
                       xmlns:showcase="clr-namespace:PrestoSample.Showcase"
                       xmlns:local="using:PrestoSample.Pages"
                       mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="800"
                       x:Class="PrestoSample.Pages.DerivedValuesPage"
                       x:DataType="local:DerivedValuesViewModel">
    <showcase:ShowcasePage.DataContext>
        <local:DerivedValuesViewModel />
    </showcase:ShowcasePage.DataContext>

    <ScrollViewer>
        <StackPanel Spacing="12">
            <Border x:Name="Stage" Classes="stage" Height="320">
                <Panel>
                    <!-- snippet: DerivedValuesHeader -->
                    <TextBlock x:Name="Header" Text="Sweep across the stage" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"
                               Opacity="{presto:Follow {Binding HeaderOpacity}, Duration=0}" />
                    <!-- /snippet -->
                    <Border x:Name="Card" Width="140" Height="180" CornerRadius="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Panel>
            </Border>
            <showcase:CodePanel x:Name="GraphCode" />


            <TextBlock Classes="caption" TextWrapping="Wrap"
                       Text="The header's opacity is derived in the view model from a Sweep the page feeds, and {presto:Follow} with Duration=0 writes each value straight through." />
            <showcase:CodeTabs x:Name="HeaderTabs" SelectedLanguage="Xaml" Xaml="{x:Static showcase:Snippets.DerivedValuesHeader}" CSharp="{Binding HeaderCode}" />
        </StackPanel>
    </ScrollViewer>
</showcase:ShowcasePage>