<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="700"
             x:Class="PrestoSample.Pages.LifecyclePage">
    <UserControl.Styles>
        <Style Selector="Border.view">
            <Setter Property="Width" Value="300" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Background" Value="#1e293b" />
        </Style>
        <Style Selector="Border.view TextBlock.title">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#f8fafc" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style Selector="Border.row">
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="TextElement.Foreground" Value="#0f172a" />
        </Style>
        <Style Selector="Border.row TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Border.moment">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Width" Value="58" />
        </Style>
        <Style Selector="Border.moment TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#0f172a" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Spacing="12">
            <Border Classes="stage" MinHeight="400">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="28" Margin="24" VerticalAlignment="Top">
                    <ContentControl x:Name="Host" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1" Spacing="8">
                        <TextBlock Classes="caption" Text="Moments, newest first" />
                        <ItemsControl x:Name="Moments" />
                    </StackPanel>
                </Grid>
            </Border>

            <WrapPanel Orientation="Horizontal">
                <Button Content="Navigate" Click="Navigate" Margin="0,0,8,8" />
                <Button Content="Show this view again" Click="ShowAgain" Margin="0,0,8,8" />
                <Button Content="Add row" Click="AddRow" Margin="0,0,8,8" />
                <Button Content="Remove row" Click="RemoveRow" Margin="0,0,8,8" />
            </WrapPanel>

            <TextBlock Classes="code" Text="&lt;Border Classes=&quot;row&quot;&#10;        presto:Presence.Initial=&quot;{x:Static local:Motions.RiseIn}&quot;&#10;        presto:Presence.Enter=&quot;{x:Static local:Motions.SlideIn}&quot;&#10;        presto:Presence.Exit=&quot;{x:Static local:Motions.SlideOut}&quot; /&gt;&#10;&#10;RiseIn   = Presto.Build().Opacity(from: 0, to: 1).Y(from: 18, to: 0).Delay(Presto.Stagger(70)).Duration(460).Ease(Eases.OutQuart);&#10;SlideIn  = Presto.Build().Opacity(from: 0, to: 1).X(from: -40, to: 0).Duration(380).Ease(Eases.OutBack(1.4));&#10;SlideOut = Presto.Build().Opacity(to: 0).X(to: 60).Duration(300).Ease(Eases.InQuad);" />

            <TextBlock Classes="caption" TextWrapping="Wrap"
                       Text="Every arrival and departure of a row is classified once, by one rule, and plays only its own builder. Initial: the row appears with its view, when you navigate here, navigate between the two views, or show a view again; rows arriving in one pass stagger by arrival order. Enter: a row arrives on its own into a view that has already loaded (Add row). Exit: a row leaves on its own while its list stays (Remove row), played on a ghost. Unload: the whole view leaves with Navigate, and nothing plays. The log is written by each builder's OnBegin, so it shows what Presence decided rather than what the button meant." />

            <TextBlock Classes="caption" TextWrapping="Wrap"
                       Text="The rule: an arriving element's ancestors are walked up past the new wrappers around it, such as its item container, and stop at the first panel or other host. A loaded host (Control.IsLoaded) means the element entered on its own; a host still in its first layout means it came with its view. Animate.OnAttached remains the raw trigger beside these, playing on every attach unclassified." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
