<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="700"
             x:Class="PrestoSample.Pages.LifecyclePage">
    <UserControl.Styles>
        <Style Selector="Border.view">
            <Setter Property="Width" Value="300" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Background" Value="#1e293b" />
        </Style>
        <Style Selector="Border.view TextBlock.title">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#f8fafc" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style Selector="Border.row">
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="TextElement.Foreground" Value="#0f172a" />
        </Style>
        <Style Selector="Border.row TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="ListBox.archive">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.archive ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="ListBox.archive ListBoxItem /template/ ContentPresenter#PART_ContentPresenter,
                         ListBox.archive ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                         ListBox.archive ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter,
                         ListBox.archive ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.moment">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Width" Value="58" />
        </Style>
        <Style Selector="Border.moment TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#0f172a" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.panel">
            <Setter Property="Width" Value="260" />
            <Setter Property="Height" Value="120" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="TextElement.Foreground" Value="#101010" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Spacing="12">
            <Border Classes="stage" MinHeight="400">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="28" Margin="24" VerticalAlignment="Top">
                    <ContentControl x:Name="Host" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1" Spacing="8">
                        <TextBlock Classes="caption" Text="Moments, newest first" />
                        <ItemsControl x:Name="Moments" />
                    </StackPanel>
                </Grid>
            </Border>

            <WrapPanel Orientation="Horizontal">
                <Button Content="Navigate" Click="Navigate" Margin="0,0,8,8" />
                <Button Content="Show this view again" Click="ShowAgain" Margin="0,0,8,8" />
                <Button Content="Add row" Click="AddRow" Margin="0,0,8,8" />
                <Button Content="Remove row" Click="RemoveRow" Margin="0,0,8,8" />
            </WrapPanel>

            <TextBlock x:Name="RowCode" Classes="code" />

            <TextBlock Classes="caption" TextWrapping="Wrap"
                       Text="Every arrival and departure of a row is classified once, by one rule, and plays only its own builder. Initial: the row appears with its view, when you navigate here, navigate between the views, or show a view again; rows arriving in one pass stagger by arrival order. Enter: a row arrives on its own into a view that has already loaded (Add row). Exit: a row leaves on its own while its list stays (Remove row), played on a ghost. Unload: the whole view leaves with Navigate, and nothing plays. The log is written by each builder's OnBegin, so it shows what Presence decided rather than what the button meant." />

            <TextBlock Classes="caption" TextWrapping="Wrap"
                       Text="Navigate to the third view, Archive, a ListBox of 300 rows that virtualizes: only the rows on screen exist, and scrolling recycles their controls for other items. Scroll it and the log stays quiet: a row realized or recycled by scrolling is neither an arrival nor a departure, because its item never left the list. Inside a list, Presence enters a row only when its item was just added and exits one only when its item was just removed, so Add row and Remove row still animate; they act on the rows currently on screen." />

            <TextBlock Classes="caption" TextWrapping="Wrap"
                       Text="The rule: an arriving element's ancestors are walked up past the new wrappers around it, such as its item container, and stop at the first panel or other host. A loaded host (Control.IsLoaded) means the element entered on its own; a host still in its first layout means it came with its view. In an item container, the list's own item changes decide instead. Animate.OnAttached remains the raw trigger beside these, playing on every attach unclassified. To ease the other rows into the gap an arrival or exit leaves, put Animate.ItemLayout on the list, or Animate.Layout on a wrapper: layout goes on the container and Presence on the content, because both drive the same composition Translation and Scale." />

            <Border Classes="stage" MinHeight="180">
                <StackPanel Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ContentControl x:Name="Swapper" Width="260" Height="120" />
                    <Button Content="Swap" Click="Swap" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <TextBlock Classes="code" Text="swapper.Content = next;   // both views carry Presence.Arrive and Presence.Exit" />

            <TextBlock Classes="caption" TextWrapping="Wrap"
                       Text="A ContentControl swapping its content: the old view's exit plays on its ghost while the new view enters in the same slot, so the two crossfade. A whole page navigated away is not ghosted: an element leaves on its own only when everything between it and what was removed wraps nothing else." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
