<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:presto="using:Monaco.Presto.AvaloniaBridge"
             xmlns:local="using:PrestoSample.Pages"
             mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="700"
             x:Class="PrestoSample.Pages.PresencePage">
    <UserControl.Styles>
        <Style Selector="Border.task">
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,0,4,0" />
            <Setter Property="Background" Value="{DynamicResource SystemAccentColorLight1}" />
            <Setter Property="TextElement.Foreground" Value="#101010" />
        </Style>
        <Style Selector="Border.task Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#101010" />
        </Style>
        <Style Selector="Border.panel">
            <Setter Property="Width" Value="260" />
            <Setter Property="Height" Value="120" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="TextElement.Foreground" Value="#101010" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Spacing="12">
            <Border Classes="stage" MinHeight="330">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24" Margin="24" VerticalAlignment="Top">
                    <ItemsControl x:Name="Tasks" Width="300" ClipToBounds="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border Classes="task"
                                        presto:Presence.Initial="{x:Static local:PresencePage.RiseIn}"
                                        presto:Presence.Enter="{x:Static local:PresencePage.SlideIn}"
                                        presto:Presence.Exit="{x:Static local:PresencePage.SlideOut}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{Binding}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                        <Button Grid.Column="1" Content="✕" Click="RemoveTask" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Grid.Column="1" Spacing="8">
                        <Button Content="Add" Click="AddTask" />
                        <Button Content="Remove random" Click="RemoveRandom" />
                        <Button Content="Clear" Click="ClearTasks" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Classes="code" Text="&lt;Border Classes=&quot;task&quot;&#10;        presto:Presence.Initial=&quot;{x:Static local:PresencePage.RiseIn}&quot;&#10;        presto:Presence.Enter=&quot;{x:Static local:PresencePage.SlideIn}&quot;&#10;        presto:Presence.Exit=&quot;{x:Static local:PresencePage.SlideOut}&quot;&gt;&#10;&#10;RiseIn = Presto.Build().Opacity(from: 0, to: 1).Y(from: 16, to: 0).Delay(Presto.Stagger(60)).Duration(420).Ease(Eases.OutQuart);&#10;SlideIn = Presto.Build().Opacity(from: 0, to: 1).X(from: -24, to: 0).Duration(320).Ease(Eases.OutQuart);&#10;SlideOut = Presto.Build().Opacity(to: 0).X(to: 80).Scale(to: .9).Duration(320).Ease(Eases.InQuad);&#10;tasks.ContainerPrepared += (_, e) =&gt; e.Container.AnimateLayout(320, Eases.OutQuint);" />

            <TextBlock Classes="caption" TextWrapping="Wrap"
                       Text="The list is bound to an ObservableCollection&lt;string&gt;; nothing in code-behind animates a removal. The rows the page opens with rise in a stagger (Presence.Initial), rows added later slide in (Presence.Enter), and rows removed leave with Presence.Exit: when an item goes, the ItemsControl drops its container in the same frame, and the exit plays on a ghost, a snapshot of the row in the window's overlay, placed and clipped where the row was drawn. AnimateLayout on each container closes the gap underneath it. Clear takes every row at once, and each still leaves on its own ghost." />

            <Border Classes="stage" MinHeight="180">
                <StackPanel Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ContentControl x:Name="Swapper" Width="260" Height="120" />
                    <Button Content="Swap" Click="Swap" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <TextBlock Classes="code" Text="swapper.Content = next;   // both views carry Presence.Enter and Presence.Exit" />

            <TextBlock Classes="caption" TextWrapping="Wrap"
                       Text="A ContentControl swapping its content: the old view's exit plays on its ghost while the new view enters in the same slot, so the two crossfade. A whole page navigated away is not ghosted: an element leaves on its own only when everything between it and what was removed wraps nothing else." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
