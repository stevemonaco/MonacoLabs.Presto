<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="600"
             x:Class="PrestoSample.Pages.ScrollPage">
    <UserControl.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#18808080" />
            <Setter Property="BorderBrush" Value="#40808080" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Height" Value="150" />
        </Style>

        <Style Selector="Border.spacer">
            <Setter Property="Height" Value="240" />
        </Style>

        <Style Selector="TextBlock.value">
            <Setter Property="FontFamily" Value="Consolas,Menlo,monospace" />
            <Setter Property="FontSize" Value="15" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">
        <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,10">
            <TextBlock Classes="code" Text="PrestoAvalonia.OnScroll(new() { Target = SyncCard, Sync = true }).Link(timeline)" />
            <Grid ColumnDefinitions="Auto,80,Auto,80,Auto,90,Auto,*" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Classes="code" Text="Progress" />
                <TextBlock Grid.Column="1" x:Name="ProgressText" Classes="value" />
                <TextBlock Grid.Column="2" Classes="code" Text="Velocity" />
                <TextBlock Grid.Column="3" x:Name="VelocityText" Classes="value" />
                <TextBlock Grid.Column="4" Classes="code" Text="Direction" />
                <TextBlock Grid.Column="5" x:Name="DirectionText" Classes="value" />
                <TextBlock Grid.Column="6" Classes="code" Text="Thresholds" />
                <TextBlock Grid.Column="7" x:Name="StateText" Classes="value" />
            </Grid>
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16" Margin="0,0,16,16">
                <TextBlock Classes="caption" TextWrapping="Wrap"
                           Text="Scroll this panel. The readout above follows the third card's observer; velocity and direction are shared by every observer of the same ScrollViewer." />

                <Border Classes="spacer" />

                <Border x:Name="RevealCard" Classes="card">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Default thresholds" FontSize="18" />
                        <TextBlock Classes="code" Text="enter: &quot;end start&quot;, leave: &quot;start end&quot;" />
                        <TextBlock Classes="caption" TextWrapping="Wrap"
                                   Text="A paused animation linked to the observer, played on enter and paused on leave by the default sync methods." />
                    </StackPanel>
                </Border>

                <Border Classes="spacer" />

                <Border x:Name="ThresholdCard" Classes="card">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Named thresholds" FontSize="18" />
                        <TextBlock Classes="code" Text="enter: &quot;bottom-=120 top&quot;, leave: &quot;top center&quot;" />
                        <TextBlock Classes="caption" TextWrapping="Wrap"
                                   Text="Enters 120 units before the bottom edge reaches its top, and leaves when the top edge reaches its centre." />
                    </StackPanel>
                </Border>

                <Border Classes="spacer" />

                <Border x:Name="SyncCard" Classes="card">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Scrubbed timeline" FontSize="18" />
                        <TextBlock Classes="code" Text="sync: true" />
                        <Canvas Height="44" ClipToBounds="True">
                            <Border x:Name="Rider" Width="32" Height="32" CornerRadius="6" Background="#f5c542" Canvas.Top="6" />
                        </Canvas>
                    </StackPanel>
                </Border>

                <Border Classes="spacer" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
