<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="600"
             x:Class="PrestoSample.Pages.TimelinePage">
    <UserControl.Styles>
        <Style Selector="Border.demo">
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="6" />
        </Style>
        <Style Selector="Border.demo > :is(Control)">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Spacing="12">
            <Grid ColumnDefinitions="230,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
                <TextBlock Grid.Row="0" Grid.Column="0" Classes="code" Text=".Add(a, …, 0)" />
                <Border Grid.Row="0" Grid.Column="1" Classes="demo">
                    <Button x:Name="AbsoluteButton" Classes="specimen" Content="Button" />
                </Border>

                <TextBlock Grid.Row="1" Grid.Column="0" Classes="code" Text=".Add(b, …)&#10;appended at the end" />
                <Border Grid.Row="1" Grid.Column="1" Classes="demo">
                    <ToggleSwitch x:Name="AppendToggle" IsChecked="True" />
                </Border>

                <TextBlock Grid.Row="2" Grid.Column="0" Classes="code" Text=".Add(c, …, &quot;-=400&quot;)" />
                <Border Grid.Row="2" Grid.Column="1" Classes="demo">
                    <Slider x:Name="RelativeSlider" Width="140" Maximum="100" Value="40" />
                </Border>

                <TextBlock Grid.Row="3" Grid.Column="0" Classes="code" Text=".Add(d, …, &quot;&lt;&quot;)&#10;previous child's end" />
                <Border Grid.Row="3" Grid.Column="1" Classes="demo">
                    <TextBox x:Name="PreviousEndTextBox" Width="140" Text="Type here" />
                </Border>

                <TextBlock Grid.Row="4" Grid.Column="0" Classes="code" Text=".Add(e, …, &quot;&lt;&lt;&quot;)&#10;previous child's start" />
                <Border Grid.Row="4" Grid.Column="1" Classes="demo">
                    <CheckBox x:Name="PreviousStartCheck" Content="CheckBox" IsChecked="True" />
                </Border>

                <TextBlock Grid.Row="5" Grid.Column="0" Classes="code" Text=".Label(&quot;flash&quot;, &quot;+=200&quot;)&#10;.Add(f, …, &quot;flash&quot;)" />
                <Border Grid.Row="5" Grid.Column="1" Classes="demo">
                    <Button x:Name="LabelButton" Classes="specimen" Background="#f5c542" Foreground="#101010">
                        <PathIcon Data="{StaticResource StarIcon}" />
                    </Button>
                </Border>

                <TextBlock Grid.Row="6" Grid.Column="0" Classes="code" Text=".Sync(animation, 0)" />
                <Border Grid.Row="6" Grid.Column="1" Classes="demo">
                    <Button x:Name="SyncedButton" Classes="specimen" Content="Synced" />
                </Border>

                <TextBlock Grid.Row="7" Grid.Column="0" Classes="code" Text=".Add(new TimerParams { … }, 20)" />
                <Border Grid.Row="7" Grid.Column="1" Classes="demo">
                    <TextBlock x:Name="TimerChildText" Classes="readout" FontSize="18" VerticalAlignment="Center" Text="0" />
                </Border>

                <TextBlock Grid.Row="8" Grid.Column="0" Classes="code" Text=".Call(…, &quot;flash&quot;)" />
                <Border Grid.Row="8" Grid.Column="1" Classes="demo">
                    <TextBlock x:Name="CallText" Classes="readout" FontSize="18" VerticalAlignment="Center" Text="0 hits" />
                </Border>
            </Grid>

            <StackPanel Spacing="2">
                <TextBlock Classes="caption" Text="Scrub — the slider is the timeline's Progress" />
                <Slider x:Name="ScrubSlider" Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1"
                        ValueChanged="Scrub" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Play" Click="Play" />
                <Button Content="Pause" Click="Pause" />
                <Button Content="Restart" Click="Restart" />
                <Button Content="Reverse" Click="Reverse" />
                <TextBlock x:Name="ReadoutText" Classes="code" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
