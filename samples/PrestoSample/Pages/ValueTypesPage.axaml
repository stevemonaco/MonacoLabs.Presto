<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="600"
             x:Class="PrestoSample.Pages.ValueTypesPage">
    <ScrollViewer>
        <StackPanel Spacing="8">
            <Grid ColumnDefinitions="300,*">
                <TextBlock Classes="code" Text="[&quot;X&quot;] = 220" />
                <Border Grid.Column="1" Classes="demo">
                    <Border x:Name="NumberSquare" Classes="swatch" />
                </Border>
            </Grid>

            <Grid ColumnDefinitions="300,*">
                <TextBlock Classes="code" Text="[&quot;Rotate&quot;] = &quot;1turn&quot;" />
                <Border Grid.Column="1" Classes="demo">
                    <Border x:Name="TurnBar" Classes="swatch" Width="64" Height="20" />
                </Border>
            </Grid>

            <Grid ColumnDefinitions="300,*">
                <TextBlock Classes="code" Text="[&quot;X&quot;] = &quot;+=140&quot;&#10;[&quot;Scale&quot;] = &quot;*=1.5&quot;" />
                <Border Grid.Column="1" Classes="demo">
                    <Border x:Name="RelativeSquare" Classes="swatch" Margin="60,0,0,0" />
                </Border>
            </Grid>

            <Grid ColumnDefinitions="300,*">
                <TextBlock Classes="code" Text="[&quot;X&quot;] = new double[] { 0, 220 }&#10;[&quot;Opacity&quot;] = new double[] { .2, 1 }" />
                <Border Grid.Column="1" Classes="demo">
                    <Border x:Name="FromToSquare" Classes="swatch" />
                </Border>
            </Grid>

            <Grid ColumnDefinitions="300,*">
                <TextBlock Classes="code" Text="[&quot;Value&quot;] = &quot;75%&quot;" />
                <Border Grid.Column="1" Classes="demo">
                    <ProgressBar x:Name="PercentBar" Width="260" Height="10"
                                 HorizontalAlignment="Left" VerticalAlignment="Center" />
                </Border>
            </Grid>

            <Grid ColumnDefinitions="300,*">
                <TextBlock Classes="code" Text="[&quot;Background&quot;] = &quot;#f5c542&quot;" />
                <Border Grid.Column="1" Classes="demo">
                    <Border x:Name="HexSquare" Classes="swatch" />
                </Border>
            </Grid>

            <Grid ColumnDefinitions="300,*">
                <TextBlock Classes="code" Text="[&quot;Background&quot;] = &quot;rgb(74, 222, 128)&quot;" />
                <Border Grid.Column="1" Classes="demo">
                    <Border x:Name="RgbSquare" Classes="swatch" />
                </Border>
            </Grid>

            <Grid ColumnDefinitions="300,*">
                <TextBlock Classes="code" Text="[&quot;Background&quot;] = &quot;hsl(280, 70%, 60%)&quot;" />
                <Border Grid.Column="1" Classes="demo">
                    <Border x:Name="HslSquare" Classes="swatch" />
                </Border>
            </Grid>

            <Grid ColumnDefinitions="300,*">
                <TextBlock Classes="code" Text="[SolidColorBrush.ColorProperty] =&#10;    TweenValue.Of(Colors.OrangeRed)" />
                <Border Grid.Column="1" Classes="demo">
                    <Border x:Name="TypedColorSquare" Classes="swatch">
                        <Border.Background>
                            <SolidColorBrush Color="#4c8dff" />
                        </Border.Background>
                    </Border>
                </Border>
            </Grid>

            <Grid ColumnDefinitions="300,*">
                <TextBlock Classes="code" Text="[&quot;BorderThickness&quot;] = new Thickness(10)&#10;[&quot;CornerRadius&quot;] = new CornerRadius(30)" />
                <Border Grid.Column="1" Classes="demo">
                    <Border x:Name="StructSquare" Width="60" Height="60" BorderThickness="1" BorderBrush="#f5c542"
                            Background="#4c8dff" HorizontalAlignment="Left" VerticalAlignment="Center" />
                </Border>
            </Grid>

            <Grid ColumnDefinitions="300,*">
                <TextBlock Classes="code" Text="[&quot;EndPoint&quot;] = new Point(240, 44)" />
                <Border Grid.Column="1" Classes="demo">
                    <Line x:Name="PointLine" StartPoint="0,0" EndPoint="40,0" Stroke="#4c8dff" StrokeThickness="4"
                          HorizontalAlignment="Left" VerticalAlignment="Center" />
                </Border>
            </Grid>

            <Grid ColumnDefinitions="300,*">
                <TextBlock Classes="code" Text="[&quot;Size&quot;] = new Size(100, 40)" />
                <Border Grid.Column="1" Classes="demo">
                    <Path x:Name="ArcPath" Stroke="#4c8dff" StrokeThickness="4"
                          HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Path.Data>
                            <PathGeometry>
                                <PathFigure StartPoint="0,0" IsClosed="False">
                                    <ArcSegment Point="200,0" Size="100,6" SweepDirection="Clockwise" />
                                </PathFigure>
                            </PathGeometry>
                        </Path.Data>
                    </Path>
                </Border>
            </Grid>

            <Grid ColumnDefinitions="300,*">
                <TextBlock Classes="code" Text="[&quot;Rect&quot;] = new Rect(184, 4, 56, 44)" />
                <Border Grid.Column="1" Classes="demo">
                    <Path x:Name="RectPath" Fill="#4c8dff" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Path.Data>
                            <RectangleGeometry Rect="0,12,28,28" />
                        </Path.Data>
                    </Path>
                </Border>
            </Grid>

            <Grid ColumnDefinitions="300,*">
                <TextBlock Classes="code" Text="[&quot;Offset&quot;] = new Vector(200, 0)" />
                <Border Grid.Column="1" Classes="demo">
                    <ScrollViewer x:Name="OffsetScroller" HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled" MaxWidth="260"
                                  HorizontalAlignment="Left" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Classes="chip"><TextBlock Text="1" /></Border>
                            <Border Classes="chip"><TextBlock Text="2" /></Border>
                            <Border Classes="chip"><TextBlock Text="3" /></Border>
                            <Border Classes="chip"><TextBlock Text="4" /></Border>
                            <Border Classes="chip"><TextBlock Text="5" /></Border>
                            <Border Classes="chip"><TextBlock Text="6" /></Border>
                            <Border Classes="chip"><TextBlock Text="7" /></Border>
                            <Border Classes="chip"><TextBlock Text="8" /></Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <Grid ColumnDefinitions="300,*">
                <TextBlock Classes="code" Text="[&quot;Y&quot;] = new FunctionValue((t, i, n) =&gt; -10 - i * 6)&#10;Delay = new FunctionValue((t, i, n) =&gt; i * 80)" />
                <Border Grid.Column="1" Classes="demo">
                    <StackPanel x:Name="DotsPanel" Orientation="Horizontal" Spacing="12"
                                HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Border Classes="dot" />
                        <Border Classes="dot" />
                        <Border Classes="dot" />
                        <Border Classes="dot" />
                        <Border Classes="dot" />
                        <Border Classes="dot" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
