<showcase:ShowcasePage xmlns="https://github.com/avaloniaui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:showcase="clr-namespace:PrestoSample.Showcase"
                       mc:Ignorable="d" d:DesignWidth="712" d:DesignHeight="440"
                       x:Class="PrestoSample.Showcase.Pages.BloomNavPage">
    <showcase:ShowcasePage.Styles>
        <Style Selector="Button.tab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.tab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.tab:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.tile">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="Padding" Value="14,10" />
        </Style>
        <Style Selector="Border.tile TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="Border.tile TextBlock.heading">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{x:Static showcase:Palette.Ink}" />
        </Style>
    </showcase:ShowcasePage.Styles>

    <Border CornerRadius="12" ClipToBounds="True" BorderThickness="1"
            BorderBrush="{x:Static showcase:Palette.Border}">
        <DockPanel>
            <Border x:Name="Header" DockPanel.Dock="Top" Padding="12,0">
                <StackPanel HorizontalAlignment="Left">
                    <StackPanel x:Name="Tabs" Orientation="Horizontal" />
                    <Canvas Height="3">
                        <Border x:Name="Underline" Height="3" CornerRadius="1.5"
                                Background="{x:Static showcase:Palette.Ink}" />
                    </Canvas>
                </StackPanel>
            </Border>
            <Panel x:Name="Stage" ClipToBounds="True">
                <Border x:Name="Screen" Padding="12" />
                <Canvas x:Name="Overlay" IsHitTestVisible="False" />
            </Panel>
        </DockPanel>
    </Border>
</showcase:ShowcasePage>
