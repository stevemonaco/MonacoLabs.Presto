<showcase:ShowcasePage xmlns="https://github.com/avaloniaui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:showcase="clr-namespace:PrestoSample.Showcase"
                       mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="860"
                       x:Class="PrestoSample.Showcase.Pages.DashboardPage">
    <showcase:ShowcasePage.Styles>
        <Style Selector="Border.stage">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="14" />
        </Style>
        <Style Selector="Border.card.showcase">
            <Setter Property="Width" Value="NaN" />
        </Style>
        <Style Selector="TextBlock.readout">
            <Setter Property="FontSize" Value="30" />
        </Style>
    </showcase:ShowcasePage.Styles>

    <ScrollViewer>
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
            <Border Grid.Row="0" Classes="rail showcase">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                    <Button Grid.Column="0" x:Name="NewData" Content="New data" Click="PushRound" />
                    <ToggleSwitch Grid.Column="2" x:Name="Live" VerticalAlignment="Center"
                                  OffContent="live off" OnContent="live · 800 ms" IsCheckedChanged="LiveChanged" />
                    <TextBlock Grid.Column="3" x:Name="FeedText" Classes="mono" Margin="0"
                               VerticalAlignment="Center" Text="round 0 · feed 0 ms" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" x:Name="Tiles" ColumnDefinitions="*,*,*,*" ColumnSpacing="10" />

            <Grid Grid.Row="2" ColumnDefinitions="*,250" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                <Border Grid.Row="0" Grid.Column="0" Classes="stage" Height="222">
                    <Grid RowDefinitions="Auto,*">
                        <TextBlock Grid.Row="0" Classes="eyebrow showcase" Text="THROUGHPUT BY CHANNEL" />
                        <StackPanel Grid.Row="1" x:Name="BarField" Orientation="Horizontal" Spacing="14"
                                    HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                    </Grid>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" Classes="stage" Height="148">
                    <Grid RowDefinitions="Auto,*">
                        <TextBlock Grid.Row="0" Classes="eyebrow showcase" Text="SESSIONS, LAST HOUR" />
                        <Canvas Grid.Row="1" x:Name="Plot" Width="600" Height="96" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                            <Path x:Name="Spark" Stretch="None" StrokeThickness="3"
                                  Stroke="{x:Static showcase:Palette.Aqua}"
                                  StrokeLineCap="Round" StrokeJoin="Round" />
                        </Canvas>
                    </Grid>
                </Border>

                <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Classes="stage">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="eyebrow showcase" Text="MIX" />
                        <Canvas x:Name="DonutStage" Width="180" Height="180" HorizontalAlignment="Center" />
                        <StackPanel x:Name="Legend" Spacing="6" />
                    </StackPanel>
                </Border>
            </Grid>

            <showcase:TransportBar Grid.Row="3" x:Name="Bar" />

            <showcase:CodePanel Grid.Row="4" x:Name="HowCode" Header="How it's built" IsExpanded="False" />
        </Grid>
    </ScrollViewer>
</showcase:ShowcasePage>
