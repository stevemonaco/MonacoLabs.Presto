<showcase:ShowcasePage xmlns="https://github.com/avaloniaui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:showcase="clr-namespace:PrestoSample.Showcase"
                       mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="760"
                       x:Class="PrestoSample.Showcase.Pages.KineticPoemPage">
    <showcase:ShowcasePage.Styles>
        <Style Selector="TextBlock.phrase">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="132" />
            <Setter Property="FontWeight" Value="Black" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
    </showcase:ShowcasePage.Styles>

    <ScrollViewer>
        <StackPanel Spacing="12">
            <Border Classes="stage" Padding="0">
                <!-- A fixed design size, so the phrases are split once and never re-split under the timeline. -->
                <Viewbox>
                    <Grid x:Name="Stage" Width="1200" Height="675" ClipToBounds="True">
                        <TextBlock x:Name="Feel" Classes="phrase" Text="FEEL THE BEAT" Foreground="{x:Static showcase:Palette.AccentPale}" />
                        <TextBlock x:Name="Stretch" Classes="phrase" Text="STRETCH" FontSize="160" Foreground="{x:Static showcase:Palette.Amber}" />
                        <TextBlock x:Name="Ride" Classes="phrase" Text="ride the wave" FontWeight="Light" Foreground="{x:Static showcase:Palette.Aqua}" />
                        <TextBlock x:Name="Fall" Classes="phrase" Text="let it all fall" FontWeight="Bold" Foreground="{x:Static showcase:Palette.Violet}" />
                        <TextBlock x:Name="Break" Classes="phrase" Text="BREAK" FontSize="200" Foreground="{x:Static showcase:Palette.Coral}" />
                        <Canvas x:Name="Shards" IsHitTestVisible="False" />
                        <TextBlock x:Name="Melt" Classes="phrase" Text="melt away" Foreground="{x:Static showcase:Palette.Rose}" />
                        <TextBlock x:Name="Again" Classes="phrase" Text="AND AGAIN" Foreground="{x:Static showcase:Palette.Lime}" />

                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="36"
                                    HorizontalAlignment="Left" VerticalAlignment="Bottom">
                            <Ellipse x:Name="BeatDot" Width="22" Height="22" Fill="{x:Static showcase:Palette.Coral}" />
                            <TextBlock Classes="mono" Text="120 BPM" FontSize="20" VerticalAlignment="Center"
                                       Foreground="{x:Static showcase:Palette.InkDim}" />
                        </StackPanel>
                    </Grid>
                </Viewbox>
            </Border>

            <Border Classes="rail showcase">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Classes="eyebrow showcase" Text="SEEK" VerticalAlignment="Center" Margin="2,0,6,0" />
                    <Button Content="feel" Tag="feel" Click="SeekLabel" />
                    <Button Content="stretch" Tag="stretch" Click="SeekLabel" />
                    <Button Content="ride" Tag="ride" Click="SeekLabel" />
                    <Button Content="fall" Tag="fall" Click="SeekLabel" />
                    <Button Content="break" Tag="break" Click="SeekLabel" />
                    <Button Content="melt" Tag="melt" Click="SeekLabel" />
                    <Button Content="again" Tag="again" Click="SeekLabel" />
                </StackPanel>
            </Border>

            <showcase:TransportBar x:Name="Bar" />

            <showcase:CodePanel Code="{x:Static showcase:Snippets.KineticPoemTimeline}" Header="How it's built" IsExpanded="False" />
        </StackPanel>
    </ScrollViewer>
</showcase:ShowcasePage>
