<showcase:ShowcasePage xmlns="https://github.com/avaloniaui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:showcase="clr-namespace:PrestoSample.Showcase"
                       xmlns:presto="using:Monaco.Presto.AvaloniaBridge"
                       xmlns:local="using:PrestoSample.Showcase.Pages"
                       xmlns:builder="using:PrestoSample.Builder"
                       mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="760"
                       x:Class="PrestoSample.Showcase.Pages.MicroInteractionsPage">
    <showcase:ShowcasePage.Styles>
        <Style Selector="Border.stage">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="290" />
            <Setter Property="Padding" Value="18" />
        </Style>
        <Style Selector="Border.toast">
            <Setter Property="Background" Value="{x:Static showcase:Palette.SurfaceHigh}" />
            <Setter Property="BorderBrush" Value="{x:Static showcase:Palette.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,10,12,8" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style Selector="Border.toast TextBlock.title">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{x:Static showcase:Palette.Ink}" />
        </Style>
        <Style Selector="Border.toast ProgressBar">
            <Setter Property="MinHeight" Value="3" />
            <Setter Property="Height" Value="3" />
            <Setter Property="Background" Value="{x:Static showcase:Palette.Border}" />
        </Style>
        <Style Selector="TabStripItem">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="presto:Motion.Hover" Value="{x:Static local:MicroInteractionsPage.TabLift}" />
        </Style>
        <!-- The Presto underline replaces Fluent's own selection pipe. -->
        <Style Selector="TabStripItem:selected /template/ Border#PART_SelectedPipe">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="StackPanel#Accordion > Expander">
            <Setter Property="presto:Animate.Layout" Value="{presto:Reflow 380, Ease=outQuint}" />
            <Setter Property="presto:Animate.LayoutMode" Value="PositionAndSize" />
        </Style>
        <Style Selector="TextBox.invalid /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{x:Static showcase:Palette.Coral}" />
        </Style>
        <Style Selector="TextBlock.error">
            <Setter Property="Foreground" Value="{x:Static showcase:Palette.Coral}" />
        </Style>
    </showcase:ShowcasePage.Styles>

    <ScrollViewer>
        <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="16">
            <StackPanel Spacing="8">
                <TextBlock Classes="eyebrow showcase" Text="SUBMIT" />
                <Border Classes="stage">
                    <Button x:Name="Submit" Classes="specimen" Width="168" Height="44" Padding="0"
                            HorizontalAlignment="Center" HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center" Click="SubmitClicked">
                        <Grid>
                            <TextBlock x:Name="SubmitLabel" Text="Place order" HorizontalAlignment="Center" />
                            <Path x:Name="Spinner" Width="20" Height="20" Stretch="None" Opacity="0"
                                  Stroke="{x:Static showcase:Palette.Ink}" StrokeThickness="2.5"
                                  StrokeLineCap="Round" StrokeJoin="Round" />
                        </Grid>
                    </Button>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="8">
                <TextBlock Classes="eyebrow showcase" Text="LIKE" />
                <Border Classes="stage">
                    <Button x:Name="Like" Classes="specimen" Background="{x:Static showcase:Palette.SurfaceHigh}"
                            BorderBrush="{x:Static showcase:Palette.Border}" Padding="16,10"
                            HorizontalAlignment="Center" Click="LikeClicked"
                            presto:Motion.Press="{x:Static local:MicroInteractionsPage.PressIn}"
                            presto:Animate.OnTapped="{x:Static local:MicroInteractionsPage.Pop}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon x:Name="Heart" Data="{StaticResource HeartIcon}" Width="22" Height="22"
                                      Foreground="{x:Static showcase:Palette.InkDim}" />
                            <TextBlock x:Name="LikeCount" VerticalAlignment="Center" FontSize="16" />
                        </StackPanel>
                    </Button>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2" Spacing="8">
                <TextBlock Classes="eyebrow showcase" Text="TAB INDICATOR" />
                <Border Classes="stage">
                    <StackPanel VerticalAlignment="Center">
                        <TabStrip x:Name="Tabs" SelectedIndex="0" SelectionChanged="TabChanged">
                            <TabStrip.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </TabStrip.ItemsPanel>
                            <TabStripItem Content="Overview" />
                            <TabStripItem Content="Activity" />
                            <TabStripItem Content="Settings" />
                            <TabStripItem Content="Billing" />
                        </TabStrip>
                        <Canvas x:Name="Rail" Height="3">
                            <Border x:Name="Underline" Height="3" CornerRadius="1.5"
                                    Background="{x:Static showcase:Palette.Accent}" />
                        </Canvas>
                        <Border Height="1" Background="{x:Static showcase:Palette.Border}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="1" Spacing="8">
                <TextBlock Classes="eyebrow showcase" Text="ACCORDION" />
                <Border Classes="stage">
                    <StackPanel x:Name="Accordion" Spacing="6">
                        <Expander Header="Shipping" HorizontalAlignment="Stretch" Expanding="Expanding">
                            <TextBlock TextWrapping="Wrap" Text="Orders leave the warehouse within one working day and arrive in two to four." />
                        </Expander>
                        <Expander Header="Returns" HorizontalAlignment="Stretch" Expanding="Expanding">
                            <TextBlock TextWrapping="Wrap" Text="Send anything back within 30 days, unworn and in its box, for a full refund." />
                        </Expander>
                        <Expander Header="Warranty" HorizontalAlignment="Stretch" Expanding="Expanding">
                            <TextBlock TextWrapping="Wrap" Text="Two years on parts and labour, extendable to five when you register the product." />
                        </Expander>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="8">
                <TextBlock Classes="eyebrow showcase" Text="TOASTS" />
                <Border Classes="stage" x:DataType="builder:ToastsViewModel">
                    <Border.DataContext>
                        <builder:ToastsViewModel />
                    </Border.DataContext>
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <Button x:Name="Notify" Classes="specimen" Content="Notify" Margin="0,0,12,0" Command="{Binding NotifyCommand}" />
                            <TextBlock Classes="caption" VerticalAlignment="Center" TextWrapping="Wrap" Text="Hover to hold one, swipe it away" />
                        </DockPanel>
                        <!-- snippet: MicroInteractionsToasts -->
                        <ItemsControl x:Name="Toasts" ItemsSource="{Binding Toasts}"
                                      presto:Animate.ItemLayout="{presto:Reflow 380, Ease=outQuint}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="builder:Toast">
                                    <!-- The swipe drags the toast and the entrance slides its slot, so the two never fight over X. -->
                                    <Panel presto:Presence.Arrive="{presto:Slide Edge=Right, Distance=320, Duration=420, Ease=outQuint}"
                                           presto:Presence.Exit="{presto:Slide Edge=Right, Distance=320, Duration=260, Ease=inQuad}">
                                        <Border Classes="toast" Loaded="ToastLoaded" PointerEntered="HoldToast" PointerExited="ReleaseToast">
                                            <StackPanel Spacing="6">
                                                <TextBlock Classes="title" Text="{Binding Title}" />
                                                <TextBlock Classes="caption" Text="{Binding Message}" TextWrapping="Wrap" />
                                                <ProgressBar Maximum="1" Foreground="{Binding Accent}" />
                                            </StackPanel>
                                        </Border>
                                    </Panel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- /snippet -->
                    </DockPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="2" Spacing="8">
                <TextBlock Classes="eyebrow showcase" Text="VALIDATION" />
                <Border Classes="stage">
                    <StackPanel Spacing="10" VerticalAlignment="Center">
                        <TextBox x:Name="Email" PlaceholderText="you@example.com" TextChanged="EmailChanged" />
                        <Button Classes="specimen" Content="Subscribe" Click="SubscribeClicked" />
                        <TextBlock x:Name="Hint" Classes="caption" Text="Try it without an @." />
                    </StackPanel>
                </Border>
            </StackPanel>

            <showcase:CodePanel Grid.Row="2" Grid.ColumnSpan="3" Header="How it's built" IsExpanded="False"
                                Language="Xaml" Code="{x:Static showcase:Snippets.MicroInteractionsToasts}" />
        </Grid>
    </ScrollViewer>
</showcase:ShowcasePage>
