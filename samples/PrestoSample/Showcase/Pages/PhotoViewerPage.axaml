<showcase:ShowcasePage xmlns="https://github.com/avaloniaui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:presto="https://github.com/stevemonaco/Monaco.Presto"
                       xmlns:showcase="clr-namespace:PrestoSample.Showcase"
                       mc:Ignorable="d" d:DesignWidth="712" d:DesignHeight="440"
                       x:Class="PrestoSample.Showcase.Pages.PhotoViewerPage">
    <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,60,Auto,60,Auto,60,*,Auto" ColumnSpacing="8" Margin="0,0,0,10">
            <TextBlock Classes="eyebrow showcase" Text="SCALE" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" x:Name="ScaleText" Classes="mono" Text="1.00" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Classes="eyebrow showcase" Text="ROTATION" VerticalAlignment="Center" />
            <TextBlock Grid.Column="3" x:Name="RotationText" Classes="mono" Text="0.0" VerticalAlignment="Center" />
            <TextBlock Grid.Column="4" Classes="eyebrow showcase" Text="RELEASE PX/MS" VerticalAlignment="Center" />
            <TextBlock Grid.Column="5" x:Name="VelocityText" Classes="mono" Text="0.00" VerticalAlignment="Center" />
            <Button Grid.Column="7" x:Name="ResetButton" Classes="specimen" Content="Reset" Click="ResetClicked" />
        </Grid>

        <showcase:CodePanel DockPanel.Dock="Bottom" Header="How it's built" IsExpanded="False" MaxHeight="280" Margin="0,12,0,0"
                            Code="{x:Static showcase:Snippets.PhotoViewerTransformable}" />

        <ListBox DockPanel.Dock="Bottom" x:Name="Filmstrip" Margin="0,10,0,0" HorizontalAlignment="Center"
                 Background="Transparent" SelectedIndex="{Binding #Photos.SelectedIndex, Mode=TwoWay}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="6" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>

        <Panel>
            <presto:FilteredImage x:Name="Backdrop" Stretch="UniformToFill" Brightness="0.35" SourceTransition="Dissolve 700" />
            <Carousel x:Name="Photos" ClipToBounds="True" IsSwipeEnabled="True" SelectionChanged="PhotoChanged"
                      PageTransition="{presto:PageSlide Edge=Right}" />
        </Panel>
    </DockPanel>
</showcase:ShowcasePage>
