<showcase:ShowcasePage xmlns="https://github.com/avaloniaui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:showcase="clr-namespace:PrestoSample.Showcase"
                       mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="720"
                       x:Class="PrestoSample.Showcase.Pages.ScrollStoryPage"
                       SizeChanged="Remeasure">
    <showcase:ShowcasePage.Styles>
        <Style Selector="Border.stage">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="20" />
        </Style>
        <Style Selector="Border.stage TextBlock.title">
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{x:Static showcase:Palette.Ink}" />
        </Style>
        <Style Selector="Border.card.showcase">
            <Setter Property="Width" Value="232" />
            <Setter Property="Height" Value="180" />
            <Setter Property="Padding" Value="16,14" />
        </Style>
        <Style Selector="Border.card TextBlock.readout">
            <Setter Property="FontSize" Value="40" />
            <Setter Property="Foreground" Value="{x:Static showcase:Palette.AccentBright}" />
        </Style>
    </showcase:ShowcasePage.Styles>

    <Panel>
        <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="Article" MaxWidth="700" Spacing="18" Margin="20,54,20,90">
                <Border x:Name="Hero" Height="520" CornerRadius="10" ClipToBounds="True">
                    <Panel>
                        <Border x:Name="HeroSky">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                    <GradientStop Color="#2B579F" Offset="0" />
                                    <GradientStop Color="#0B0E14" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border x:Name="HeroRidge" Height="220" Margin="-90,0,-90,-40" CornerRadius="400,400,0,0"
                                VerticalAlignment="Bottom" Background="{x:Static showcase:Palette.AccentDeep}" />
                        <StackPanel x:Name="HeroTitle" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Classes="eyebrow showcase" Text="SCROLL AS A PLAYHEAD" HorizontalAlignment="Center" />
                            <TextBlock Text="Scroll story" FontSize="46" FontWeight="SemiBold" />
                        </StackPanel>
                    </Panel>
                </Border>

                <TextBlock Classes="caption" TextWrapping="Wrap"
                           Text="Nothing on this page plays on its own. Every animation below is created paused and handed to an observer, which either seeks it to the scroll position or plays it at a threshold." />

                <Border x:Name="Chapter1" Classes="stage">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="eyebrow showcase" Text="ONE · THRESHOLDS" />
                        <TextBlock Classes="title" Text="Where a section counts as in view" />
                        <TextBlock Classes="caption" TextWrapping="Wrap"
                                   Text="This card enters at &quot;bottom-=120 top&quot; — the container's bottom, 120px early, reaching the card's top — and leaves at &quot;top+=40 bottom&quot;. The observer plays the reveal on the way in and pauses it on the way out, and every crossing is reported to the rail with the direction it happened in." />
                    </StackPanel>
                </Border>

                <Border x:Name="Chapter2" Classes="stage">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="eyebrow showcase" Text="TWO · SMOOTHING" />
                        <TextBlock Classes="title" Text="The hero trails the scrollbar" />
                        <TextBlock Classes="caption" TextWrapping="Wrap"
                                   Text="Scroll back to the top and the hero's three layers chase the scroll position rather than tracking it: Sync = 0.35 lerps the linked timeline's progress towards the scroll's a fraction at a time, and keeps the engine awake until it has caught up." />
                    </StackPanel>
                </Border>

                <Border x:Name="Quote" Classes="stage"
                        Background="{x:Static showcase:Palette.AccentDeep}"
                        BorderBrush="{x:Static showcase:Palette.Accent}">
                    <StackPanel Spacing="8">
                        <TextBlock FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Text="&quot;Sync takes an ease, so the crossing itself can be shaped.&quot;" />
                        <TextBlock Classes="caption"
                                   Text="Sync = Eases.InOutQuad — this block lingers at both ends of its crossing and hurries through the middle." />
                    </StackPanel>
                </Border>

                <Border x:Name="Chapter3" Classes="stage">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="eyebrow showcase" Text="THREE · REFRESH" />
                        <TextBlock Classes="title" Text="Re-measured on every resize" />
                        <TextBlock Classes="caption" TextWrapping="Wrap"
                                   Text="Every threshold here is a pixel offset measured once against this article and its viewport. Resize the window mid-scroll and the page calls Refresh() on all seven observers, so the pinned scrub below carries on from the scroll position it is actually at instead of the one the old measurement said it was." />
                    </StackPanel>
                </Border>

                <Border x:Name="PinTrack" Height="1600">
                    <TextBlock Classes="caption" VerticalAlignment="Top" HorizontalAlignment="Center"
                               Text="1600px of track — the pinned section stays put and is scrubbed across it" />
                </Border>

                <TextBlock Classes="caption" TextWrapping="Wrap"
                           Text="Seven observers over one ScrollViewer: the hero parallax and the pinned strip are timelines created with Autoplay = false and handed to Link(), which is how autoplay: onScroll() is spelled here; the quote is a single animation synced through an ease; the three chapters are played and paused by the default &quot;play pause&quot; sync at their own named thresholds; and the rail reads Progress, Velocity and Backward off an observer watching the whole article, feeding the vane through an Animatable so it eases rather than jumping. Only the pinned section is drawn outside the scroller — Avalonia has no sticky positioning, so the stage is an overlay the observer shows while its track is passing." />
            </StackPanel>
        </ScrollViewer>

        <Border x:Name="PinStage" Classes="stage" Width="640" Opacity="0"
                IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Grid RowDefinitions="Auto,*" RowSpacing="14">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                    <TextBlock Grid.Column="0" Classes="eyebrow showcase" Text="PINNED · SCRUBBED BY SCROLL" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" x:Name="PinNumber" Classes="readout" FontSize="20" Text="0" />
                    <TextBlock Grid.Column="2" Classes="caption" Text="%" VerticalAlignment="Bottom" Margin="0,0,0,3" />
                </Grid>
                <StackPanel Grid.Row="1" x:Name="PinStrip" Orientation="Horizontal" Spacing="14" HorizontalAlignment="Left" />
            </Grid>
        </Border>

        <Border Classes="rail showcase" VerticalAlignment="Top" IsHitTestVisible="False" CornerRadius="0,0,10,10">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="12">
                <Border Grid.Column="0" x:Name="RailTrack" Height="4" CornerRadius="2" VerticalAlignment="Center"
                        Background="{x:Static showcase:Palette.Border}">
                    <Border x:Name="RailFill" Width="0" CornerRadius="2" HorizontalAlignment="Left"
                            Background="{x:Static showcase:Palette.Accent}" />
                </Border>
                <TextBlock Grid.Column="1" x:Name="RailText" Classes="code" Margin="0" Text="0% · 0.000 px/ms · forward" />
                <TextBlock Grid.Column="2" x:Name="CrossingText" Classes="caption" VerticalAlignment="Center" Text="no crossing yet" />
                <Path Grid.Column="3" x:Name="Vane" Data="M 0,0 L 14,0 L 7,11 Z" VerticalAlignment="Center"
                      Fill="{x:Static showcase:Palette.AccentBright}" />
            </Grid>
        </Border>
    </Panel>
</showcase:ShowcasePage>
