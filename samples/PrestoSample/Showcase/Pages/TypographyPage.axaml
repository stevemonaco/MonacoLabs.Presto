<showcase:ShowcasePage xmlns="https://github.com/avaloniaui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:showcase="clr-namespace:PrestoSample.Showcase"
                       mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="760"
                       x:Class="PrestoSample.Showcase.Pages.TypographyPage">
    <showcase:ShowcasePage.Styles>
        <Style Selector="Border.stage">
            <Setter Property="MinHeight" Value="0" />
        </Style>

        <Style Selector="TextBlock.headline">
            <Setter Property="FontSize" Value="44" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </showcase:ShowcasePage.Styles>

    <ScrollViewer>
        <StackPanel Spacing="12">
            <Border Classes="stage">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="eyebrow showcase" Text="LINES · MASKED REVEAL THAT SURVIVES A REFLOW"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Replay" Click="ReplayReveal" />
                    </Grid>
                    <TextBlock x:Name="Paragraph" FontSize="26" TextWrapping="Wrap" HorizontalAlignment="Left"
                               Width="{Binding #WidthSlider.Value}"
                               Foreground="{x:Static showcase:Palette.Ink}"
                               Text="Every line of this paragraph is its own mask, and each word rises into it one line after another. Drag the width while it plays: the text re-wraps under the reveal and carries on from where it was." />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Classes="code" Text="{Binding #WidthSlider.Value, StringFormat='width {0:0}px'}" />
                        <Slider x:Name="WidthSlider" Width="320" Minimum="280" Maximum="640" Value="600" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Classes="stage">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="eyebrow showcase" Text="CHARS · WORD ROTATOR"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Replay" Click="ReplayRotator" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="14" Margin="0,12">
                        <TextBlock Classes="headline" Text="Animate" Foreground="{x:Static showcase:Palette.Ink}" />
                        <Canvas x:Name="Slot" Height="60">
                            <TextBlock x:Name="Word" Classes="headline" Width="400"
                                       Foreground="{x:Static showcase:Palette.Accent}" />
                        </Canvas>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border x:Name="WordmarkStage" Classes="stage" PointerMoved="LeanWordmark" PointerExited="RelaxWordmark">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="eyebrow showcase" Text="CHARS · POINTER-REACTIVE WORDMARK"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Replay" Click="ReplayWordmark" />
                    </Grid>
                    <TextBlock x:Name="Wordmark" Text="MOTION" FontSize="104" FontWeight="Black" LetterSpacing="6"
                               HorizontalAlignment="Center" Margin="0,24,0,8"
                               Foreground="{x:Static showcase:Palette.AccentDim}" />
                </StackPanel>
            </Border>

            <Border Classes="stage">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="eyebrow showcase" Text="SCRAMBLE · DECODE TERMINAL"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Replay" Click="ReplayTerminal" />
                    </Grid>
                    <Border Background="{x:Static showcase:Palette.Background}" CornerRadius="8" Padding="18,14">
                        <StackPanel Spacing="8">
                            <StackPanel x:Name="TerminalLines" Spacing="6" />
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,8,0,0">
                                <TextBlock Classes="code" Text="status" />
                                <TextBlock x:Name="Status" Grid.Column="1" Classes="code"
                                           Foreground="{x:Static showcase:Palette.Aqua}" />
                                <TextBlock x:Name="Percent" Grid.Column="2" Classes="code" Margin="0"
                                           Foreground="{x:Static showcase:Palette.Ink}" />
                                <TextBlock Grid.Column="3" Classes="code" Text="%" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock Classes="caption" TextWrapping="Wrap"
                       Text="Watch each line of the paragraph rise out of its own mask, then drag the width slider mid-reveal: the text re-wraps into new lines and the reveal carries on instead of starting over. Below it, the last word of the headline drops out letter by letter and the next one rises in while the gap it sits in eases to the new word's width, so the headline never jumps. Sweep the pointer across MOTION to lift and brighten the letters nearest it, then leave and watch them spring back, while the terminal types, decodes and counts to 100 on a loop." />
        </StackPanel>
    </ScrollViewer>
</showcase:ShowcasePage>
