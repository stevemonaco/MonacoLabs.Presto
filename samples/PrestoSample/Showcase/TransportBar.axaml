<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="720"
             x:Class="PrestoSample.Showcase.TransportBar">
    <Border Classes="rail showcase">
        <StackPanel Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="Play" Click="Play" />
                <Button Content="Pause" Click="Pause" />
                <Button Content="Restart" Click="Restart" />
                <Button Content="Reverse" Click="Reverse" />
                <Button Content="Alternate" Click="Alternate" />
                <ToggleButton x:Name="LoopToggle" Content="Loop" IsCheckedChanged="LoopChanged" />
                <TextBlock x:Name="TimeText" Classes="mono" Margin="8,0,0,0" Text="0 ms · 0%" />
            </StackPanel>

            <Slider x:Name="Scrubber" Minimum="0" Maximum="1" ValueChanged="Scrub" />

            <StackPanel Orientation="Horizontal" Spacing="16">
                <StackPanel Spacing="2">
                    <TextBlock Classes="caption" Text="{Binding #SpeedSlider.Value, StringFormat='Speed {0:0.00}x'}" />
                    <Slider x:Name="SpeedSlider" Width="180" Minimum="0.1" Maximum="3" Value="1" ValueChanged="SpeedChanged" />
                </StackPanel>
                <StackPanel Spacing="2">
                    <TextBlock Classes="caption" Text="{Binding #StretchSlider.Value, StringFormat='Duration {0:0.00}x'}" />
                    <Slider x:Name="StretchSlider" Width="180" Minimum="0.25" Maximum="3" Value="1" ValueChanged="StretchChanged" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
