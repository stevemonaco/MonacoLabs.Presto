<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="using:Avalonia.Controls.Converters"
        xmlns:pages="clr-namespace:PrestoSample.Pages"
        xmlns:showcase="clr-namespace:PrestoSample.Showcase"
        xmlns:presto="https://github.com/stevemonaco/MonacoLabs.Presto">
    <Styles.Resources>
        <!-- Archivo's width faces ship as separate families; their typographic family name was set to Archivo so FontStretch reaches them. -->
        <FontFamily x:Key="DisplayFont">avares://PrestoSample/Assets/Fonts/Archivo#Archivo</FontFamily>
        <FontFamily x:Key="SerifDisplayFont">avares://PrestoSample/Assets/Fonts/PlayfairDisplay#Playfair Display</FontFamily>
        <FontFamily x:Key="ScriptDisplayFont">avares://PrestoSample/Assets/Fonts/DancingScript#Dancing Script</FontFamily>
        <StreamGeometry x:Key="HeartIcon">M8,14 L2.3,8.3 A3.5,3.5 0 0 1 8,3.6 A3.5,3.5 0 0 1 13.7,8.3 Z</StreamGeometry>
        <StreamGeometry x:Key="StarIcon">M8,1 L10,6 L15,6 L11,9.5 L12.5,15 L8,11.8 L3.5,15 L5,9.5 L1,6 L6,6 Z</StreamGeometry>
        <StreamGeometry x:Key="PlayIcon">M4,2 L14,8 L4,14 Z</StreamGeometry>
        <StreamGeometry x:Key="GearIcon">M6.51,2.81 L6.81,0.49 L9.19,0.49 L9.49,2.81 L10.62,3.28 L12.47,1.85 L14.15,3.53 L12.72,5.38 L13.19,6.51 L15.51,6.81 L15.51,9.19 L13.19,9.49 L12.72,10.62 L14.15,12.47 L12.47,14.15 L10.62,12.72 L9.49,13.19 L9.19,15.51 L6.81,15.51 L6.51,13.19 L5.38,12.72 L3.53,14.15 L1.85,12.47 L3.28,10.62 L2.81,9.49 L0.49,9.19 L0.49,6.81 L2.81,6.51 L3.28,5.38 L1.85,3.53 L3.53,1.85 L5.38,3.28 Z M10.4,8 A2.4,2.4 0 1 0 5.6,8 A2.4,2.4 0 1 0 10.4,8 Z</StreamGeometry>

        <ControlTheme x:Key="{x:Type showcase:CodePanel}" TargetType="showcase:CodePanel">
            <Setter Property="Background" Value="{x:Static showcase:Palette.SurfaceHigh}" />
            <Setter Property="BorderBrush" Value="{x:Static showcase:Palette.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="FontFamily" Value="Consolas,Menlo,monospace" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{x:Static showcase:Palette.Ink}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <Grid RowDefinitions="Auto,*" ColumnDefinitions="*,Auto">
                            <ToggleButton Name="PART_Toggle" Margin="0,0,0,8" Cursor="Hand"
                                          IsVisible="{TemplateBinding Header, Converter={x:Static ObjectConverters.IsNotNull}}"
                                          IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate>
                                        <ContentPresenter Background="Transparent" Content="{TemplateBinding Content}" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Path Name="PART_Chevron" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center"
                                          Data="M0,1 L10,10 20,1 19,0 10,8 1,0 Z" Fill="{x:Static showcase:Palette.InkDim}" />
                                    <TextBlock Text="{TemplateBinding Header}" FontFamily="{x:Static FontFamily.Default}"
                                               FontWeight="SemiBold" Foreground="{x:Static showcase:Palette.InkDim}" />
                                </StackPanel>
                            </ToggleButton>
                            <!-- A bare icon at rest; CodePanel peels its back sheet on hover and morphs the front one into a check on copy. -->
                            <Button Name="PART_Copy" Grid.Column="1" Grid.RowSpan="2" VerticalAlignment="Top" Margin="12,-4,-6,0"
                                    Padding="6,4" Cursor="Hand" ToolTip.Tip="Copy" Background="Transparent" BorderBrush="Transparent"
                                    presto:Motion.Press="{x:Static showcase:CodePanel.PressIn}">
                                <Button.Template>
                                    <ControlTemplate>
                                        <ContentPresenter Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                          BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}"
                                                          Content="{TemplateBinding Content}" />
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal">
                                    <Border Name="PART_CopiedClip" Width="0" ClipToBounds="True">
                                        <TextBlock Name="PART_Copied" Text="Copied" FontSize="11" FontWeight="SemiBold"
                                                   FontFamily="{x:Static FontFamily.Default}" Margin="0,0,6,0"
                                                   VerticalAlignment="Center" Opacity="0"
                                                   Foreground="{x:Static showcase:Palette.Aqua}" />
                                    </Border>
                                    <Panel Width="16" Height="16">
                                        <Path Name="PART_CopyBack" Data="{x:Static showcase:CodePanel.BackSheet}"
                                              Stroke="{x:Static showcase:Palette.InkDim}" StrokeThickness="1.4"
                                              StrokeLineCap="Round" StrokeJoin="Round" />
                                        <Path Name="PART_CopyFront" Data="{x:Static showcase:CodePanel.FrontSheet}"
                                              Stroke="{x:Static showcase:Palette.InkDim}" StrokeThickness="1.4"
                                              StrokeLineCap="Round" StrokeJoin="Round" />
                                    </Panel>
                                </StackPanel>
                            </Button>
                            <!-- The padding, taken back from the border's, gives the overlay scrollbar a band below the last line. -->
                            <ScrollViewer Name="PART_ScrollViewer" Grid.Row="1" IsVisible="{TemplateBinding IsExpanded}"
                                          Margin="0,0,0,-10" Padding="0,0,0,10"
                                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <!-- Without a background only the glyphs hit-test, so a drag starting beside them selects nothing. -->
                                <SelectableTextBlock Name="PART_Text" TextWrapping="NoWrap" Background="Transparent" />
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>

            <Style Selector="^[IsExpanded=False] /template/ ToggleButton#PART_Toggle">
                <Setter Property="Margin" Value="0" />
            </Style>
            <Style Selector="^[IsExpanded=False] /template/ Path#PART_Chevron">
                <Setter Property="RenderTransform" Value="rotate(-90deg)" />
            </Style>

            <!-- A tile's code: no chrome, header or Copy, trimmed rather than scrolled, and whole in its tooltip. -->
            <Style Selector="^.compact">
                <Setter Property="ToolTip.Tip" Value="{Binding Code, RelativeSource={RelativeSource Self}}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Style Selector="^ /template/ ToggleButton#PART_Toggle">
                    <Setter Property="IsVisible" Value="False" />
                </Style>
                <Style Selector="^ /template/ Button#PART_Copy">
                    <Setter Property="IsVisible" Value="False" />
                </Style>
                <Style Selector="^ /template/ ScrollViewer#PART_ScrollViewer">
                    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="Padding" Value="0" />
                </Style>
                <Style Selector="^ /template/ SelectableTextBlock#PART_Text">
                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                </Style>
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="{x:Type showcase:CodeTabs}" TargetType="showcase:CodeTabs">
            <Setter Property="Template">
                <ControlTemplate>
                    <StackPanel Spacing="6">
                        <StackPanel Name="PART_Tabs" Orientation="Horizontal" Spacing="4">
                            <ToggleButton Name="PART_CSharpTab" Content="C#" Padding="10,2" FontSize="12" />
                            <ToggleButton Name="PART_XamlTab" Content="XAML" Padding="10,2" FontSize="12" />
                        </StackPanel>
                        <showcase:CodePanel Name="PART_Panel" Header="{TemplateBinding Header}" IsExpanded="{TemplateBinding IsExpanded, Mode=TwoWay}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </Styles.Resources>

    <Style Selector="Window">
        <Setter Property="Background" Value="{x:Static showcase:Palette.Background}" />
    </Style>

    <Style Selector="Border.stage">
        <Setter Property="Background" Value="{x:Static showcase:Palette.Surface}" />
        <Setter Property="BorderBrush" Value="{x:Static showcase:Palette.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="MinHeight" Value="260" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <Style Selector="Border.stage.compact">
        <Setter Property="Padding" Value="12" />
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <Style Selector="Border.stage.short">
        <Setter Property="MinHeight" Value="150" />
    </Style>

    <Style Selector="TextBlock.readout">
        <Setter Property="FontFamily" Value="Consolas,Menlo,monospace" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="Foreground" Value="{x:Static showcase:Palette.Ink}" />
    </Style>

    <Style Selector="TextBlock.readout.small">
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{x:Static showcase:Palette.InkDim}" />
    </Style>

    <Style Selector="TextBlock.mono">
        <Setter Property="FontFamily" Value="Consolas,Menlo,monospace" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="Foreground" Value="{x:Static showcase:Palette.InkDim}" />
    </Style>

    <Style Selector="showcase|MomentLog Border.moment">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="Width" Value="58" />
    </Style>

    <Style Selector="showcase|MomentLog Border.moment TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#0f172a" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.demo">
        <Setter Property="Background" Value="{x:Static showcase:Palette.SurfaceHigh}" />
        <Setter Property="BorderBrush" Value="{x:Static showcase:Palette.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="Height" Value="76" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <Style Selector="Border.demo.lane">
        <Setter Property="Height" Value="48" />
        <Setter Property="Padding" Value="6" />
    </Style>

    <Style Selector="Border.demo.lane > :is(Control)">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.swatch">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{x:Static showcase:Palette.Accent}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Real controls the reference pages animate; hover and press keep the animated Background instead of Fluent's own. -->
    <Style Selector="Button.specimen">
        <Setter Property="Background" Value="{x:Static showcase:Palette.Accent}" />
        <Setter Property="Foreground" Value="{x:Static showcase:Palette.Ink}" />
        <Setter Property="BorderBrush" Value="{x:Static showcase:Palette.AccentBright}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.specimen:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{TemplateBinding Background}" />
        <Setter Property="Foreground" Value="{TemplateBinding Foreground}" />
        <Setter Property="BorderBrush" Value="{x:Static showcase:Palette.AccentPale}" />
    </Style>

    <Style Selector="Button.specimen:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{TemplateBinding Background}" />
        <Setter Property="Foreground" Value="{TemplateBinding Foreground}" />
        <Setter Property="BorderBrush" Value="{x:Static showcase:Palette.Ink}" />
    </Style>

    <Style Selector="Button.specimen PathIcon">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
    </Style>

    <Style Selector="Border.specimen">
        <Setter Property="Background" Value="{x:Static showcase:Palette.Surface}" />
        <Setter Property="BorderBrush" Value="{x:Static showcase:Palette.AccentDim}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.dot">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Background" Value="{x:Static showcase:Palette.AccentBright}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.chip">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{x:Static showcase:Palette.AccentDeep}" />
        <Setter Property="BorderBrush" Value="{x:Static showcase:Palette.AccentDim}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Border.chip > TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{x:Static showcase:Palette.AccentPale}" />
    </Style>

    <!--
        LayoutPage's cards keep SystemAccentColorLight1, which is light on the dark variant, so the inherited ink
        would land white on it. Scoped by page type so no other Border.card is reached.
    -->
    <Style Selector="pages|LayoutPage Border.card > TextBlock">
        <Setter Property="Foreground" Value="{x:Static showcase:Palette.Background}" />
    </Style>

    <Style Selector="Button.bare">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.bare:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button.bare:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- Fluent clips Buttons and ItemsControls, which would hide a photo flying into its card. -->
    <Style Selector="Button.place">
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Classes="place showcase">
                    <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="Border.photo">
        <Setter Property="Width" Value="144" />
        <Setter Property="Height" Value="94" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <Style Selector="Border.photo.hero">
        <Setter Property="Width" Value="330" />
        <Setter Property="Height" Value="215" />
        <Setter Property="CornerRadius" Value="18" />
    </Style>

    <!-- Showcase-only classes; the extra `showcase` class keeps them off reference pages that define the same class names locally. -->
    <Style Selector="Border.panel.showcase">
        <Setter Property="Background" Value="{x:Static showcase:Palette.Surface}" />
        <Setter Property="BorderBrush" Value="{x:Static showcase:Palette.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <Style Selector="Border.place.showcase">
        <Setter Property="Background" Value="{x:Static showcase:Palette.SurfaceHigh}" />
        <Setter Property="BorderBrush" Value="{x:Static showcase:Palette.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Margin" Value="5" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Border.rail.showcase">
        <Setter Property="Background" Value="{x:Static showcase:Palette.Surface}" />
        <Setter Property="BorderBrush" Value="{x:Static showcase:Palette.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12,10" />
    </Style>

    <Style Selector="Border.card.showcase">
        <Setter Property="Background" Value="{x:Static showcase:Palette.SurfaceHigh}" />
        <Setter Property="BorderBrush" Value="{x:Static showcase:Palette.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="Width" Value="196" />
    </Style>

    <Style Selector="Border.card.showcase TextBlock.title">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Foreground" Value="{x:Static showcase:Palette.Ink}" />
    </Style>

    <Style Selector="Border.badge.showcase">
        <Setter Property="MinWidth" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="Background" Value="{x:Static showcase:Palette.Coral}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.badge.showcase > TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{x:Static showcase:Palette.Background}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.eyebrow.showcase">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="1.4" />
        <Setter Property="Foreground" Value="{x:Static showcase:Palette.Accent}" />
    </Style>

    <Style Selector="TreeView.nav.showcase">
        <Setter Property="Background" Value="{x:Static showcase:Palette.Surface}" />
        <Setter Property="BorderBrush" Value="{x:Static showcase:Palette.Border}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="Padding" Value="6,12" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="presto:Selection.Indicator">
            <Template>
                <Border Name="SelectionPill" CornerRadius="6" BorderThickness="3,0,0,0"
                        Background="{x:Static showcase:Palette.AccentDeep}"
                        BorderBrush="{x:Static showcase:Palette.Accent}" />
            </Template>
        </Setter>
    </Style>

    <!-- Fluent's TreeViewItem template: hit-testable root, hover fill, and a chevron the accordion turns. -->

    <Style Selector="TreeView.nav.showcase TreeViewItem">
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Background="Transparent">
                    <Border Name="PART_LayoutRoot"
                            Classes="TreeViewItemLayoutRoot"
                            Focusable="True"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            MinHeight="{TemplateBinding MinHeight}"
                            TemplatedControl.IsTemplateFocusTarget="True">
                        <Panel>
                            <Border Name="HoverFill" CornerRadius="6" Opacity="0" IsHitTestVisible="False"
                                    Background="{x:Static showcase:Palette.SurfaceHigh}" />
                            <Grid Name="PART_Header" ColumnDefinitions="Auto, *">
                                <Grid.Margin>
                                    <MultiBinding Converter="{x:Static converters:TreeViewItemIndentConverter.Instance}">
                                        <Binding Path="Level" RelativeSource="{RelativeSource TemplatedParent}" />
                                        <DynamicResource ResourceKey="TreeViewItemIndent" />
                                    </MultiBinding>
                                </Grid.Margin>
                                <Panel Name="PART_ExpandCollapseChevronContainer" Margin="12,0">
                                    <Path Name="Chevron" Width="12" Height="12" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Data="M1,0 L10,10 1,20 0,19 8,10 0,1 Z" Fill="{x:Static showcase:Palette.InkDim}" />
                                </Panel>
                                <ContentPresenter Name="PART_HeaderPresenter"
                                                  IsHitTestVisible="False"
                                                  Grid.Column="1"
                                                  Focusable="False"
                                                  Background="Transparent"
                                                  Content="{TemplateBinding Header}"
                                                  ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalAlignment}"
                                                  Margin="{TemplateBinding Padding}" />
                            </Grid>
                        </Panel>
                    </Border>
                    <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="TreeView.nav.showcase TreeViewItem:empty /template/ Path#Chevron">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="TreeView.nav.showcase TreeViewItem[IsExpanded=False] /template/ ItemsPresenter#PART_ItemsPresenter">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="TreeView.nav.showcase TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{x:Static showcase:Palette.InkDim}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style Selector="TreeView.nav.showcase TextBlock.section">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="1.4" />
    </Style>

    <Style Selector="TreeView.nav.showcase TreeViewItem:selected TextBlock">
        <Setter Property="Foreground" Value="{x:Static showcase:Palette.AccentPale}" />
    </Style>

    <Style Selector="TreeView.nav.showcase TreeViewItem /template/ Border#PART_LayoutRoot">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Margin" Value="0,1" />
    </Style>

    <!-- A page's hover fades in through GalleryNav's motion states; a section header only reacts to its own border, since :pointerover holds on ancestors. -->
    <Style Selector="TreeView.nav.showcase TreeViewItem:not(:empty) /template/ Border#PART_LayoutRoot:pointerover">
        <Setter Property="Background" Value="{x:Static showcase:Palette.SurfaceHigh}" />
    </Style>

    <!-- After the hover rule, so the selected item shows the selection pill beneath it rather than a hover or Fluent's selected background. -->
    <Style Selector="TreeView.nav.showcase TreeViewItem:selected /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

</Styles>
