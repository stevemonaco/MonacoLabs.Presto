<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pages="clr-namespace:PrestoSample.Pages"
        xmlns:showcase="clr-namespace:PrestoSample.Showcase">
    <Style Selector="Window">
        <Setter Property="Background" Value="{x:Static showcase:Palette.Background}" />
    </Style>

    <Style Selector="Border.stage">
        <Setter Property="Background" Value="{x:Static showcase:Palette.Surface}" />
        <Setter Property="BorderBrush" Value="{x:Static showcase:Palette.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="MinHeight" Value="260" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <Style Selector="TextBlock.readout">
        <Setter Property="FontFamily" Value="Consolas,Menlo,monospace" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="Foreground" Value="{x:Static showcase:Palette.Ink}" />
    </Style>

    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{x:Static showcase:Palette.InkDim}" />
    </Style>

    <Style Selector="TextBlock.code">
        <Setter Property="FontFamily" Value="Consolas,Menlo,monospace" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="Foreground" Value="{x:Static showcase:Palette.InkDim}" />
    </Style>

    <Style Selector="Border.demo">
        <Setter Property="Background" Value="{x:Static showcase:Palette.SurfaceHigh}" />
        <Setter Property="BorderBrush" Value="{x:Static showcase:Palette.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="Height" Value="76" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <Style Selector="Border.swatch">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{x:Static showcase:Palette.Accent}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.dot">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Background" Value="{x:Static showcase:Palette.AccentBright}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.chip">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{x:Static showcase:Palette.AccentDeep}" />
        <Setter Property="BorderBrush" Value="{x:Static showcase:Palette.AccentDim}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Border.chip > TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{x:Static showcase:Palette.AccentPale}" />
    </Style>

    <!--
        LayoutPage's cards keep SystemAccentColorLight1, which is light on the dark variant, so the inherited ink
        would land white on it. Scoped by page type so no other Border.card is reached.
    -->
    <Style Selector="pages|LayoutPage Border.card > TextBlock">
        <Setter Property="Foreground" Value="{x:Static showcase:Palette.Background}" />
    </Style>

    <!-- Showcase-only classes; the extra `showcase` class keeps them off reference pages that define the same class names locally. -->
    <Style Selector="Border.rail.showcase">
        <Setter Property="Background" Value="{x:Static showcase:Palette.Surface}" />
        <Setter Property="BorderBrush" Value="{x:Static showcase:Palette.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12,10" />
    </Style>

    <Style Selector="Border.card.showcase">
        <Setter Property="Background" Value="{x:Static showcase:Palette.SurfaceHigh}" />
        <Setter Property="BorderBrush" Value="{x:Static showcase:Palette.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="Width" Value="196" />
    </Style>

    <Style Selector="Border.card.showcase TextBlock.title">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Foreground" Value="{x:Static showcase:Palette.Ink}" />
    </Style>

    <Style Selector="TextBlock.eyebrow.showcase">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="1.4" />
        <Setter Property="Foreground" Value="{x:Static showcase:Palette.Accent}" />
    </Style>

    <Style Selector="TreeView.nav.showcase">
        <Setter Property="Background" Value="{x:Static showcase:Palette.Surface}" />
        <Setter Property="BorderBrush" Value="{x:Static showcase:Palette.Border}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="Padding" Value="6,12" />
    </Style>

    <Style Selector="TreeView.nav.showcase TreeViewItem">
        <Setter Property="IsExpanded" Value="True" />
    </Style>

    <Style Selector="TreeView.nav.showcase TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{x:Static showcase:Palette.InkDim}" />
    </Style>

    <Style Selector="TreeView.nav.showcase TextBlock.section">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="1.4" />
    </Style>

    <Style Selector="TreeView.nav.showcase TreeViewItem:selected TextBlock">
        <Setter Property="Foreground" Value="{x:Static showcase:Palette.AccentPale}" />
    </Style>

    <Style Selector="TreeView.nav.showcase TreeViewItem /template/ Border#PART_LayoutRoot">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Margin" Value="0,1" />
    </Style>

    <Style Selector="TreeView.nav.showcase TreeViewItem:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{x:Static showcase:Palette.SurfaceHigh}" />
    </Style>

    <Style Selector="TreeView.nav.showcase TreeViewItem:selected /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{x:Static showcase:Palette.AccentDeep}" />
        <Setter Property="BorderBrush" Value="{x:Static showcase:Palette.Accent}" />
        <Setter Property="BorderThickness" Value="3,0,0,0" />
    </Style>

</Styles>
