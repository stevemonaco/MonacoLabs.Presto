<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PrestoSample.ViewModels"
             xmlns:presto="https://github.com/stevemonaco/Monaco.Presto"
             xmlns:showcase="using:PrestoSample.Showcase"
             xmlns:local="using:PrestoSample.Views"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="650"
             x:Class="PrestoSample.Views.MainView"
             x:DataType="vm:MainViewModel">
    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <Style Selector="Grid#PageColumn">
            <Setter Property="Margin" Value="24" />
        </Style>
        <Style Selector="Grid#PageColumn.compact">
            <Setter Property="Margin" Value="12" />
        </Style>
        <Style Selector="Grid#PageColumn:not(.compact) :is(Control).compactOnly">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="StackPanel#TwinLine">
            <Setter Property="Orientation" Value="Horizontal" />
        </Style>
        <Style Selector="Grid#PageColumn.compact StackPanel#TwinLine">
            <Setter Property="Orientation" Value="Vertical" />
        </Style>
        <Style Selector="Grid#PageColumn.compact StackPanel#Details:not(.open)">
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <Grid x:Name="Shell">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="180" MaxWidth="420" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="SidebarSlot" Grid.Column="0" ClipToBounds="True">
                <local:GalleryNav x:Name="Navigation" CollapseRequested="TogglePane" />
            </Border>

            <Border x:Name="PageSlot" Grid.Column="1">
                <Grid x:Name="PageColumn" RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,0,0,16">
                        <Button x:Name="ExpandPane" IsVisible="False" Background="Transparent" Padding="8" Margin="0,0,12,0"
                                VerticalAlignment="Top" Click="TogglePane" ToolTip.Tip="Show sidebar (Ctrl+B)">
                            <Path Width="12" Height="12" Stretch="Uniform" Fill="{x:Static showcase:Palette.InkDim}"
                                  Data="M1,0 L10,10 1,20 0,19 8,10 0,1 Z" />
                        </Button>
                        <Button x:Name="Back" Grid.Column="1" Classes="compactOnly" Background="Transparent" Padding="12"
                                Margin="0,0,8,0" VerticalAlignment="Top" Command="{Binding GoBackCommand}" ToolTip.Tip="Back">
                            <Path Width="12" Height="12" Stretch="Uniform" Fill="{x:Static showcase:Palette.InkDim}"
                                  Data="M9,0 L0,10 9,20 10,19 2,10 10,1 Z" />
                        </Button>
                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock Text="{Binding SelectedPage.Section}" Classes="eyebrow showcase" />
                            <TextBlock Text="{Binding SelectedPage.Title}" FontSize="22" FontWeight="SemiBold" />
                            <StackPanel x:Name="Details" Spacing="4" Classes.open="{Binding #About.IsChecked}">
                                <TextBlock Text="{Binding SelectedPage.Description}" Classes="caption" TextWrapping="Wrap" />
                                <StackPanel x:Name="TwinLine" Spacing="4"
                                            IsVisible="{Binding SelectedPage.Twin, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}">
                                    <TextBlock Classes="caption" VerticalAlignment="Center" TextWrapping="Wrap"
                                               Text="Ignores Reduced motion, as anime.js does. Builder version:" />
                                    <HyperlinkButton Padding="0" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                     Content="{Binding SelectedPage.Twin}" Command="{Binding OpenCommand}"
                                                     CommandParameter="{Binding SelectedPage.Twin}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                        <ToggleButton x:Name="About" Grid.Column="3" Classes="compactOnly" Content="About"
                                      Margin="8,0,0,0" VerticalAlignment="Top" />
                    </Grid>
                    <TransitioningContentControl x:Name="PageHost" Grid.Row="1" ClipToBounds="True" Content="{Binding CurrentPage}"
                                                 IsTransitionReversed="{Binding IsBack}" />
                </Grid>
            </Border>

            <GridSplitter x:Name="Splitter" Grid.Column="1" HorizontalAlignment="Left" Width="6" Background="Transparent"
                          DoubleTapped="TogglePane" />
        </Grid>

        <!-- Both levels stay attached, so Home keeps its search, expansion and scroll offset under a page. -->
        <Panel x:Name="Levels" IsVisible="False" ClipToBounds="True">
            <Border x:Name="Home" Background="{x:Static showcase:Palette.Surface}" />
            <Border x:Name="PageLevel" Background="{x:Static showcase:Palette.Background}" />
        </Panel>
    </Panel>
</UserControl>
