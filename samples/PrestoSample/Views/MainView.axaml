<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PrestoSample.ViewModels"
             xmlns:presto="using:Monaco.Presto.AvaloniaBridge"
             xmlns:showcase="using:PrestoSample.Showcase"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="650"
             x:Class="PrestoSample.Views.MainView"
             x:DataType="vm:MainViewModel">
    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid ColumnDefinitions="240,*">
        <Grid Grid.Column="0" RowDefinitions="*,Auto">
            <TreeView Name="Nav" Classes="nav showcase"
                      ItemsSource="{Binding Sections}"
                      SelectedItem="{Binding SelectedPage, Mode=OneWay}"
                      SelectionChanged="NavSelectionChanged">
                <TreeView.DataTemplates>
                    <TreeDataTemplate x:DataType="vm:GallerySection" ItemsSource="{Binding Pages}">
                        <TextBlock Classes="section" Text="{Binding Name}" />
                    </TreeDataTemplate>
                    <DataTemplate x:DataType="vm:GalleryPage">
                        <TextBlock Text="{Binding Title}" />
                    </DataTemplate>
                </TreeView.DataTemplates>
            </TreeView>

            <Border Grid.Row="1" Background="{x:Static showcase:Palette.Surface}" BorderBrush="{x:Static showcase:Palette.Border}"
                    BorderThickness="0,1,1,0" Padding="16,10">
                <StackPanel Spacing="4">
                    <TextBlock Classes="eyebrow showcase" Text="SETTINGS" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <ComboBox x:Name="MotionPicker" HorizontalAlignment="Stretch"
                                  SelectedIndex="{Binding Motion}">
                            <ComboBoxItem Content="Full motion" />
                            <ComboBoxItem Content="Reduced motion" />
                            <ComboBoxItem Content="OS preference" />
                        </ComboBox>
                        <Border x:Name="MotionHelp" Grid.Column="1" Width="20" Height="20" CornerRadius="10"
                                VerticalAlignment="Center" Background="Transparent" BorderThickness="1"
                                BorderBrush="{x:Static showcase:Palette.InkDim}" ToolTip.ShowDelay="0">
                            <TextBlock Text="?" FontSize="12" FontWeight="SemiBold" Foreground="{x:Static showcase:Palette.InkDim}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <ToolTip.Tip>
                                <StackPanel MaxWidth="320" Spacing="6">
                                    <TextBlock TextWrapping="Wrap" FontWeight="SemiBold"
                                               Text="Sets Presto.Defaults.ReducedMotion for every page. OS preference keeps it in step with the system's reduce-motion preference through PrestoAvalonia.FollowSystemReducedMotion, re-read when the window is activated." />
                                    <StackPanel Spacing="2">
                                        <TextBlock TextWrapping="Wrap" Text="• Recipes play a short fade with no travel" />
                                        <TextBlock TextWrapping="Wrap" Text="• Page transitions crossfade" />
                                        <TextBlock TextWrapping="Wrap" Text="• Text reveals fade the whole block" />
                                        <TextBlock TextWrapping="Wrap" Text="• Hover tilt stays flat" />
                                        <TextBlock TextWrapping="Wrap" Text="• Bindings, gesture releases and layout moves land at once" />
                                    </StackPanel>
                                    <TextBlock TextWrapping="Wrap" FontStyle="Italic"
                                               Text="Hand-written animations without a WhenReduced form, such as the Particles and Loaders pages, play as normal. Pages already playing pick it up on their next replay." />
                                </StackPanel>
                            </ToolTip.Tip>
                        </Border>
                    </Grid>
                    <TextBlock Classes="caption" Text="{Binding SystemMotion}" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="24">
            <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
                <TextBlock Text="{Binding SelectedPage.Section}" Classes="eyebrow showcase" />
                <TextBlock Text="{Binding SelectedPage.Title}" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="{Binding SelectedPage.Description}" Classes="caption" TextWrapping="Wrap" />
            </StackPanel>
            <TransitioningContentControl Grid.Row="1" ClipToBounds="True" Content="{Binding CurrentPage}"
                                         IsTransitionReversed="{Binding IsBack}"
                                         PageTransition="{presto:PageFadeThrough}" />
        </Grid>
    </Grid>
</UserControl>
