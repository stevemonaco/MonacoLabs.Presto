<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PrestoSample.ViewModels"
             xmlns:presto="using:Monaco.Presto.AvaloniaBridge"
             xmlns:showcase="using:PrestoSample.Showcase"
             xmlns:local="using:PrestoSample.Views"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="650"
             x:Class="PrestoSample.Views.MainView"
             x:DataType="vm:MainViewModel">
    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid x:Name="Shell">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" MinWidth="180" MaxWidth="420" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" ClipToBounds="True">
            <Grid x:Name="Sidebar" RowDefinitions="*,Auto">
                <TreeView Name="Nav" Classes="nav showcase"
                          ItemsSource="{Binding VisibleSections}"
                          SelectedItem="{Binding NavSelectedPage, Mode=OneWay}"
                          SelectionChanged="NavSelectionChanged"
                          Tapped="NavTapped"
                          Classes.searching="{Binding SearchText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                          presto:Animate.ItemLayout="{presto:Reflow}">
                    <TreeView.Styles>
                        <Style Selector="TreeView > TreeViewItem" x:DataType="vm:NavSection">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="presto:Presence.Exit" Value="{presto:Fade Direction=Left, Duration=180, Out=True}" />
                        </Style>
                        <!-- Reflow only while searching, ContentSize otherwise (PLAN.md §7). -->

                        <Style Selector="TreeView.searching > TreeViewItem">
                            <Setter Property="presto:Animate.ItemLayout" Value="{presto:Reflow}" />
                        </Style>
                        <Style Selector="TreeView:not(.searching) TreeViewItem:not(:empty) /template/ Border#ItemsHost">
                            <Setter Property="presto:Animate.ContentSize" Value="{x:Static local:MainView.Fold}" />
                        </Style>
                        <Style Selector="TreeViewItem /template/ Grid#PART_Header">
                            <Setter Property="presto:Presence.Initial" Value="{x:Static local:MainView.RiseIn}" />
                        </Style>
                        <Style Selector="TreeViewItem[IsExpanded=False]:not(:empty)">
                            <Setter Property="presto:Motion.State" Value="collapsed" />
                        </Style>
                        <Style Selector="TreeViewItem /template/ Path#Chevron">
                            <Setter Property="presto:Motion.States">
                                <presto:MotionStates>
                                    <presto:MotionState When="collapsed" Motion="{x:Static local:MainView.ChevronFolded}" />
                                </presto:MotionStates>
                            </Setter>
                        </Style>
                        <Style Selector="TreeViewItem:empty">
                            <Setter Property="presto:Motion.States">
                                <presto:MotionStates>
                                    <presto:MotionState When="collapsed" Motion="{x:Static local:MainView.PageFolded}"
                                                        Leave="{x:Static local:MainView.PageUnfolded}" />
                                </presto:MotionStates>
                            </Setter>
                        </Style>
                        <!-- The selected page shows the selection pill instead of a hover. -->
                        <Style Selector="TreeViewItem:empty:pointerover:not(:selected) /template/ Border#PART_LayoutRoot">
                            <Setter Property="presto:Motion.State" Value="hot" />
                        </Style>
                        <Style Selector="TreeViewItem /template/ Border#HoverFill">
                            <Setter Property="presto:Motion.States">
                                <presto:MotionStates>
                                    <presto:MotionState When="hot" Motion="{x:Static local:MainView.HoverFade}" />
                                </presto:MotionStates>
                            </Setter>
                        </Style>
                        <Style Selector="TreeViewItem:empty TextBlock">
                            <Setter Property="presto:Motion.States">
                                <presto:MotionStates>
                                    <presto:MotionState When="hot" Motion="{x:Static local:MainView.HoverNudge}" />
                                </presto:MotionStates>
                            </Setter>
                        </Style>
                    </TreeView.Styles>
                    <TreeView.DataTemplates>
                        <TreeDataTemplate x:DataType="vm:NavSection" ItemsSource="{Binding Pages}">
                            <TextBlock Classes="section" Text="{Binding Name}" />
                        </TreeDataTemplate>
                        <DataTemplate x:DataType="vm:GalleryPage">
                            <TextBlock Text="{Binding Title}" />
                        </DataTemplate>
                    </TreeView.DataTemplates>
                </TreeView>
                <TextBlock Classes="caption" Text="No samples match" Margin="18,16" IsVisible="{Binding HasNoMatches}" />

                <Border Grid.Row="1" Background="{x:Static showcase:Palette.Surface}" BorderBrush="{x:Static showcase:Palette.Border}"
                        BorderThickness="0,1,1,0" Padding="16,10">
                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4" Margin="0,0,0,8">
                            <TextBox x:Name="SearchBox" Classes="clearButton" PlaceholderText="Search samples"
                                     Text="{Binding SearchText}" />
                            <Button Grid.Column="1" Background="Transparent" Padding="8" VerticalAlignment="Stretch"
                                    Click="TogglePane" ToolTip.Tip="Hide sidebar (Ctrl+B)">
                                <Path Width="12" Height="12" Stretch="Uniform" Fill="{x:Static showcase:Palette.InkDim}"
                                      Data="M9,0 L0,10 9,20 10,19 2,10 10,1 Z" />
                            </Button>
                        </Grid>
                        <TextBlock Classes="eyebrow showcase" Text="SETTINGS" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <ComboBox x:Name="MotionPicker" HorizontalAlignment="Stretch"
                                      SelectedIndex="{Binding Motion}">
                                <ComboBoxItem Content="Full motion" />
                                <ComboBoxItem Content="Reduced motion" />
                                <ComboBoxItem Content="OS preference" />
                            </ComboBox>
                            <Border x:Name="MotionHelp" Grid.Column="1" Width="20" Height="20" CornerRadius="10"
                                    VerticalAlignment="Center" Background="Transparent" BorderThickness="1"
                                    BorderBrush="{x:Static showcase:Palette.InkDim}" ToolTip.ShowDelay="0">
                                <TextBlock Text="?" FontSize="12" FontWeight="SemiBold" Foreground="{x:Static showcase:Palette.InkDim}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <ToolTip.Tip>
                                    <StackPanel MaxWidth="320" Spacing="6">
                                        <TextBlock TextWrapping="Wrap" FontWeight="SemiBold"
                                                   Text="Sets Presto.Defaults.ReducedMotion for every page. OS preference keeps it in step with the system's reduce-motion preference through PrestoAvalonia.FollowSystemReducedMotion, re-read when the window is activated." />
                                        <StackPanel Spacing="2">
                                            <TextBlock TextWrapping="Wrap" Text="• Recipes play a short fade with no travel" />
                                            <TextBlock TextWrapping="Wrap" Text="• Page transitions crossfade" />
                                            <TextBlock TextWrapping="Wrap" Text="• Text reveals fade the whole block" />
                                            <TextBlock TextWrapping="Wrap" Text="• Hover tilt stays flat" />
                                            <TextBlock TextWrapping="Wrap" Text="• Bindings, gesture releases and layout moves land at once" />
                                        </StackPanel>
                                        <TextBlock TextWrapping="Wrap" FontStyle="Italic"
                                                   Text="Hand-written animations without a WhenReduced form, such as the Particles and Loaders pages, play as normal. Pages already playing pick it up on their next replay." />
                                    </StackPanel>
                                </ToolTip.Tip>
                            </Border>
                        </Grid>
                        <TextBlock Classes="caption" Text="{Binding SystemMotion}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="24">
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,16">
                <Button x:Name="ExpandPane" IsVisible="False" Background="Transparent" Padding="8" Margin="0,0,12,0"
                        VerticalAlignment="Top" Click="TogglePane" ToolTip.Tip="Show sidebar (Ctrl+B)">
                    <Path Width="12" Height="12" Stretch="Uniform" Fill="{x:Static showcase:Palette.InkDim}"
                          Data="M1,0 L10,10 1,20 0,19 8,10 0,1 Z" />
                </Button>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="{Binding SelectedPage.Section}" Classes="eyebrow showcase" />
                    <TextBlock Text="{Binding SelectedPage.Title}" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SelectedPage.Description}" Classes="caption" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
            <TransitioningContentControl Grid.Row="1" ClipToBounds="True" Content="{Binding CurrentPage}"
                                         IsTransitionReversed="{Binding IsBack}"
                                         PageTransition="{presto:PageFadeThrough}" />
        </Grid>

        <GridSplitter x:Name="Splitter" Grid.Column="1" HorizontalAlignment="Left" Width="6" Background="Transparent"
                      DoubleTapped="TogglePane" />
    </Grid>
</UserControl>
