<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:presto="https://github.com/stevemonaco/MonacoLabs.Presto"
             xmlns:m="using:Tempo.Motion"
             xmlns:vm="using:Tempo.ViewModels"
             x:Class="Tempo.Views.FocusView"
             x:DataType="vm:FocusViewModel">
    <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="20" Margin="0,16">
        <!-- Full width, each label centered: sized to its content, it took the wider label's width mid-swap and left-aligned the other. -->
        <TransitioningContentControl Classes="mode accent-fg handoff" Content="{Binding ModeLabel}"
                                     PageTransition="{presto:PageSharedAxis Axis=Y}" HorizontalContentAlignment="Center" />

        <Panel x:Name="Dial" Grid.Row="1" Width="300" Height="300">
            <Panel>
                <presto:Motion.States>
                    <presto:MotionStates>
                        <presto:MotionState When="Running" Motion="{x:Static m:TempoMotion.RingBreathe}" />
                    </presto:MotionStates>
                </presto:Motion.States>
                <presto:ProgressRing x:Name="Ring" Classes="accent" Classes.final="{Binding IsFinalCountdown}" Thickness="10" Track="{DynamicResource TempoLine}"
                                     presto:Animate.Watch="{Binding RemainingText}"
                                     Value="{presto:Follow {Binding Progress}, Duration=250, Ease=linear}"
                                     presto:Connected.Key="{Binding RingKey}" presto:Connected.Motion="{x:Static m:TempoMotion.IntroFlight}" />
            </Panel>
            <!-- Laid out at the full 300 and scaled with the dial, so the digits keep their place in the ring. -->
            <Viewbox>
                <Panel Width="300" Height="300">
                    <!-- The digits hold the ring's center, with or without a task. Centered under a top margin, the title sits half that margin lower: 10 below the 68 DIP digits. -->
                    <Panel Classes="handoff">
                        <!-- TextAlignment, not HorizontalAlignment: a rounded block width would shift the text a pixel. -->
                        <TextBlock x:Name="Remaining" Classes="remaining" FontFeatures="+tnum" TextAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock Classes="caption" Text="{Binding ActiveTask.Title, FallbackValue=''}" MaxWidth="200"
                                   TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,103,0,0" />
                    </Panel>
                </Panel>
            </Viewbox>
        </Panel>

        <StackPanel Grid.Row="2" Classes="controls handoff" Orientation="Horizontal" HorizontalAlignment="Center">
            <Panel Classes="skip" VerticalAlignment="Center">
                <Ellipse Classes="disc" />
                <Ellipse Classes="track" />
                <Path x:Name="SkipSweep" Classes="sweep" Data="M20,1.5 A18.5,18.5 0 0 1 20,38.5 A18.5,18.5 0 0 1 20,1.5" />
                <Button Classes="icon skip-face" Command="{Binding SkipCommand}" Click="SkipClicked" ToolTip.Tip="{Binding SkipLabel}">
                    <PathIcon x:Name="SkipGlyph" Data="{x:Static m:TempoMotion.SkipIcon}" />
                </Button>
            </Panel>
            <Panel VerticalAlignment="Center">
                <!-- The halo pings while Running enters; its rest is invisible, so leaving shows nothing. Sized with the pill. -->
                <Panel x:Name="StartHalo" Opacity="0" IsHitTestVisible="False">
                    <presto:Motion.States>
                        <presto:MotionStates>
                            <presto:MotionState When="Running" Motion="{x:Static m:TempoMotion.StartPing}" />
                        </presto:MotionStates>
                    </presto:Motion.States>
                    <Border Classes="halo accent-bg" />
                </Panel>
                <!-- The pill draws the accent so it eases with the resize; the button inside is laid out at its final size. -->
                <Border x:Name="StartPause" Classes="hero accent-bg" presto:Animate.ContentSize="{x:Static m:TempoMotion.PillResize}">
                    <Button Classes="hero-face" Command="{Binding StartPauseCommand}" ToolTip.Tip="Start or pause (Space)"
                            presto:Ripple.Enabled="True">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Path x:Name="PlayPause" Classes="play" Data="{StaticResource PlayIcon}">
                                <presto:Motion.States>
                                    <presto:MotionStates>
                                        <presto:MotionState When="Running" Motion="{x:Static m:TempoMotion.IconToPause}" />
                                    </presto:MotionStates>
                                </presto:Motion.States>
                            </Path>
                            <TextBlock x:Name="StartLabel" Classes="start-label" IsVisible="{Binding StartPauseLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                    </Button>
                </Border>
            </Panel>
            <Panel x:Name="AbandonHold" Width="40" Height="40" VerticalAlignment="Center" ToolTip.Tip="Hold to abandon">
                <Ellipse Classes="disc" />
                <presto:ProgressRing x:Name="AbandonRing" Thickness="3" HoldDuration="900"
                                     Fill="{DynamicResource SemiColorDanger}" Track="{DynamicResource TempoLine}"
                                     Command="{Binding AbandonCommand}" Confirmed="AbandonConfirmed" HoldCanceled="AbandonLetGo" />
                <PathIcon x:Name="StopGlyph" Classes="stop" Data="{x:Static m:TempoMotion.StopIcon}" IsHitTestVisible="False" />
            </Panel>
        </StackPanel>

        <StackPanel Grid.Row="3" Classes="handoff" Spacing="12" MinHeight="64" HorizontalAlignment="Center">
            <ContentControl x:Name="Summary">
                <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Classes="summary" Text="{Binding}" presto:Presence.Enter="{presto:LineRise}" />
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
            <TextBlock Classes="breathe" Text="In… Out…" IsVisible="{Binding IsBreak}" />
        </StackPanel>
    </Grid>
</UserControl>
