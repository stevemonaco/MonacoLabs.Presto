<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:presto="https://github.com/stevemonaco/MonacoLabs.Presto"
             xmlns:m="using:Tempo.Motion"
             xmlns:vm="using:Tempo.ViewModels"
             x:Class="Tempo.Views.FocusView"
             x:DataType="vm:FocusViewModel">
    <UserControl.Resources>
        <presto:MotionStates x:Key="IconStates">
            <presto:MotionState When="Running" Motion="{x:Static m:TempoMotion.IconToPause}" />
        </presto:MotionStates>
    </UserControl.Resources>
    <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="20" Margin="8,16">
        <TransitioningContentControl Classes="mode accent-fg handoff" Content="{Binding ModeLabel}"
                                     PageTransition="{presto:PageSharedAxis Axis=Y}" HorizontalAlignment="Center" />

        <Panel x:Name="Dial" Grid.Row="1" Width="300" Height="300">
            <Panel>
                <presto:Motion.States>
                    <presto:MotionStates>
                        <presto:MotionState When="Running" Motion="{x:Static m:TempoMotion.RingBreathe}" />
                    </presto:MotionStates>
                </presto:Motion.States>
                <presto:ProgressRing x:Name="Ring" Classes="accent" Classes.final="{Binding IsFinalCountdown}" Thickness="10" Track="{DynamicResource TempoLine}"
                                     presto:Animate.Watch="{Binding RemainingText}"
                                     Value="{presto:Follow {Binding Progress}, Duration=250, Ease=linear}"
                                     presto:Connected.Key="{Binding RingKey}" presto:Connected.Motion="{x:Static m:TempoMotion.IntroFlight}" />
            </Panel>
            <!-- Laid out at the full 300 and scaled with the dial, so the digits keep their place in the ring. -->
            <Viewbox>
                <Panel Width="300" Height="300">
                    <StackPanel Classes="handoff" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel x:Name="Digits" Classes="digits" Orientation="Horizontal" HorizontalAlignment="Center" />
                        <TextBlock Classes="caption" Text="{Binding ActiveTask.Title, FallbackValue=''}" MaxWidth="200"
                                   TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
                    </StackPanel>
                </Panel>
            </Viewbox>
        </Panel>

        <StackPanel Grid.Row="2" Classes="controls handoff" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Classes="icon" Command="{Binding SkipCommand}" VerticalAlignment="Center" ToolTip.Tip="Skip"
                    presto:Motion.Hover="{x:Static m:TempoMotion.SkipNudge}">
                <PathIcon Data="{StaticResource SkipIcon}" />
            </Button>
            <!-- The pill draws the accent so it eases with the resize; the button inside is laid out at its final size. -->
            <Border x:Name="StartPause" Classes="hero accent-bg" presto:Animate.ContentSize="{x:Static m:TempoMotion.PillResize}"
                    presto:Magnetic.Enabled="True">
                <Button Classes="hero-face" Command="{Binding StartPauseCommand}" ToolTip.Tip="Start or pause (Space)"
                        presto:Ripple.Enabled="True">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Path x:Name="PlayPause" Classes="play" Data="{StaticResource PlayIcon}" />
                        <TextBlock x:Name="StartLabel" Classes="start-label" IsVisible="{Binding StartPauseLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                </Button>
            </Border>
            <Panel x:Name="AbandonHold" Width="40" Height="40" VerticalAlignment="Center" ToolTip.Tip="Hold to abandon">
                <presto:ProgressRing Thickness="3" HoldDuration="900"
                                     Fill="{DynamicResource SemiColorDanger}" Track="{DynamicResource TempoLine}"
                                     Confirmed="AbandonConfirmed" PointerCaptureLost="AbandonReleased" KeyUp="AbandonReleased" />
                <PathIcon Classes="stop" Data="{StaticResource StopIcon}" IsHitTestVisible="False" />
            </Panel>
        </StackPanel>

        <StackPanel Grid.Row="3" Classes="handoff" Spacing="12" MinHeight="64" HorizontalAlignment="Center">
            <ContentControl x:Name="Summary">
                <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Classes="summary" Text="{Binding}" presto:Presence.Enter="{presto:LineRise}" />
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
            <TextBlock Classes="breathe" Classes.breathing="{Binding IsBreak}" Text="In… Out…" IsVisible="{Binding IsBreak}" />
        </StackPanel>
    </Grid>
</UserControl>
