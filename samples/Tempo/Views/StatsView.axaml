<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:presto="https://github.com/stevemonaco/MonacoLabs.Presto"
             xmlns:m="using:Tempo.Motion"
             xmlns:v="using:Tempo.Views"
             xmlns:vm="using:Tempo.ViewModels"
             x:Class="Tempo.Views.StatsView"
             x:DataType="vm:StatsViewModel">
    <UserControl.Resources>
        <ItemsPanelTemplate x:Key="WeekPanel">
            <UniformGrid Rows="1" />
        </ItemsPanelTemplate>
    </UserControl.Resources>
    <ScrollViewer x:Name="Scroll">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="16" Margin="8">
            <TextBlock Classes="heading" Text="Stats" />

            <UniformGrid Grid.Row="1" Classes="totals" ColumnSpacing="12">
                <Border Classes="card">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="caption" Text="Focused today" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <presto:SplitFlap Classes="total" Text="{Binding TodayMinutesText}" Cells="3" Charset=" 0123456789" />
                            <TextBlock Classes="caption" Text="min" VerticalAlignment="Bottom" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Classes="card">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="caption" Text="Sessions" />
                        <presto:SplitFlap Classes="total" Text="{Binding TodaySessionsText}" Cells="2" Charset=" 0123456789"
                                          HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
                <Border Classes="card">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="caption" Text="Streak" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="total" Text="{Binding Streak}" />
                            <TextBlock Classes="caption" Text="days" VerticalAlignment="Bottom" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- The cards' and the legend's places are in the styles, which compact restacks. -->
            <Grid Grid.Row="2" Classes="charts" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12">
                <Border Classes="card bars-card">
                    <StackPanel Spacing="12">
                        <TextBlock Classes="caption" Text="Last 7 days" />
                        <!-- No Panel inside a bar's template, so the bars share the grid's arrival batch and stagger. -->
                        <ItemsControl x:Name="Bars" ItemsSource="{Binding Days}" ItemsPanel="{StaticResource WeekPanel}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:StatsDay">
                                    <Border Height="{x:Static v:StatsView.ChartHeight}" Background="Transparent"
                                            ToolTip.Tip="{Binding Minutes, StringFormat='{}{0} min'}">
                                        <Border Classes="bar accent-bg" Height="{Binding Height, Converter={x:Static v:StatsView.BarHeight}}"
                                                presto:Presence.Arrive="{x:Static m:TempoMotion.BarGrow}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding Days}" ItemsPanel="{StaticResource WeekPanel}" Margin="0,-6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:StatsDay">
                                    <TextBlock Classes="caption" Text="{Binding Label}" HorizontalAlignment="Center" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Classes="card donut-card">
                    <Grid RowDefinitions="Auto,Auto,*">
                        <TextBlock Classes="caption" Text="Time by tag" VerticalAlignment="Center" />
                        <ListBox x:Name="RangeSwitch" Grid.Row="1" Classes="segmented range" HorizontalAlignment="Left" Margin="0,10,0,0"
                                 SelectedItem="{Binding Range}">
                            <x:Static Member="vm:StatsRange.Today" />
                            <x:Static Member="vm:StatsRange.Week" />
                            <x:Static Member="vm:StatsRange.All" />
                        </ListBox>
                        <Grid Grid.Row="2" Classes="donut-row" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" Margin="0,12,0,0"
                              VerticalAlignment="Center">
                            <Panel Classes="donut">
                                <Ellipse Classes="donut-track" />
                                <!-- Stacked, each segment drawn from the top over the ones before it: Follow.Draw only follows a "0 p" slice. -->
                                <ItemsControl ItemsSource="{Binding Segments}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Panel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DonutSegment">
                                            <Ellipse Classes="donut-segment" Stroke="{Binding Tag, Converter={x:Static m:TempoMotion.TagBrush}}"
                                                     presto:Follow.Timing="{x:Static m:TempoMotion.DonutMorph}" presto:Follow.Draw="{Binding End}"
                                                     presto:Presence.Arrive="{x:Static m:TempoMotion.DonutDraw}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Panel>
                            <ItemsControl Classes="legend" ItemsSource="{Binding Segments}" VerticalAlignment="Center">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DonutSegment">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="4" Margin="0,1">
                                            <Ellipse Classes="tag-dot" Fill="{Binding Tag, Converter={x:Static m:TempoMotion.TagBrush}}" />
                                            <TextBlock Grid.Column="1" Classes="caption" Text="{Binding Label}" />
                                            <TextBlock Grid.Column="2" Classes="caption" Text="{Binding MinutesText}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="3" Classes="card">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
                    <TextBlock Classes="caption" Text="Last 12 weeks" Margin="0,0,0,10" />
                    <!-- Scales the weeks down only once compact spans it over the card's width. -->
                    <Viewbox Grid.Row="1" Classes="heatmap" StretchDirection="DownOnly" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Grid RowDefinitions="17,17,17,17,17,17,17">
                                <TextBlock Classes="weekday" Text="Mon" />
                                <TextBlock Grid.Row="2" Classes="weekday" Text="Wed" />
                                <TextBlock Grid.Row="4" Classes="weekday" Text="Fri" />
                            </Grid>
                            <!-- A column per week; the cells reveal outward from today by their own Distance, not by arrival order. -->
                            <ItemsControl ItemsSource="{Binding Heatmap}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Vertical" ItemWidth="17" ItemHeight="17" Height="119" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:HeatmapCell">
                                        <Border Classes="heat" Background="{Binding Level, Converter={x:Static v:StatsView.HeatBrush}}"
                                                ToolTip.Tip="{Binding Minutes, StringFormat='{}{0} min'}"
                                                presto:Presence.Arrive="{x:Static m:TempoMotion.HeatCellArrive}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Viewbox>
                    <TextBlock x:Name="BestDay" Classes="best-day" Text="{Binding BestDayText}"
                               IsVisible="{Binding BestDayText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               presto:Presence.Arrive="{presto:WordFade Delay=400}" />
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
