<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:presto="using:Monaco.Presto.AvaloniaBridge"
             xmlns:local="using:Monaco.Presto.AvaloniaBridge.Tests"
             x:Class="Monaco.Presto.AvaloniaBridge.Tests.AttachedXamlView"
             x:DataType="local:AttachedXamlViewModel">
  <StackPanel>
    <Border x:Name="StaticBorder" presto:Animate.OnAttached="{x:Static local:AttachedRecipes.SlideTo100}" />
    <Border x:Name="ExtensionBorder" presto:Animate.OnAttached="{local:SlideTo Distance=40}" />
    <Border x:Name="BindingBorder" presto:Animate.OnAttached="{Binding Motion}" />
  </StackPanel>
</UserControl>
