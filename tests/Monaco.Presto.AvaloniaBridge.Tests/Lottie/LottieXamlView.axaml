<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:presto="https://github.com/stevemonaco/Monaco.Presto"
             x:Class="Monaco.Presto.AvaloniaBridge.Tests.Lottie.LottieXamlView">
  <presto:LottieView x:Name="Toggle" Width="50" Height="50"
                     Composition="avares://Monaco.Presto.AvaloniaBridge.Tests/Lottie/toggle.json"
                     presto:Animate.OnAttached="{presto:PlayLottie Segment=on, Loop=False, Speed=2}" />
</UserControl>
