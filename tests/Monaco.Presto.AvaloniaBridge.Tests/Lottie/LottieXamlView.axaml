<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:presto="using:Monaco.Presto.AvaloniaBridge"
             xmlns:lottie="using:Monaco.Presto.AvaloniaBridge.Lottie"
             x:Class="Monaco.Presto.AvaloniaBridge.Tests.Lottie.LottieXamlView">
  <lottie:LottieView x:Name="Toggle" Width="50" Height="50"
                     Composition="avares://Monaco.Presto.AvaloniaBridge.Tests/Lottie/toggle.json"
                     presto:Animate.OnAttached="{lottie:PlayLottie Segment=on, Loop=False, Speed=2}" />
</UserControl>
