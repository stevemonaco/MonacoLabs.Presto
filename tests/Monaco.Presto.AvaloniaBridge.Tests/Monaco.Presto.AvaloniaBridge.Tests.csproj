<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Monaco.Presto.AvaloniaBridge.Tests</RootNamespace>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <!-- Real geometry measurement: the headless drawing stub reports a ContourLength of 0. -->
    <PackageReference Include="Avalonia.Skia" />
    <!-- ScrollViewer needs a real template for its Extent and Viewport to be measured. -->
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.Headless.XUnit" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Monaco.Presto.AvaloniaBridge\Monaco.Presto.AvaloniaBridge.csproj" />
    <ProjectReference Include="..\..\Monaco.Presto.AvaloniaBridge.DevTools\Monaco.Presto.AvaloniaBridge.DevTools.csproj" />
    <ProjectReference Include="..\..\Monaco.Presto.AvaloniaBridge.Lottie\Monaco.Presto.AvaloniaBridge.Lottie.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Monaco.Presto.Tests\EngineTestBase.cs" Link="EngineTestBase.cs" />
    <Compile Include="..\Monaco.Presto.Tests\TestHelpers.cs" Link="TestHelpers.cs" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="..\..\samples\PrestoSample\Assets\Lottie\toggle.json" Link="Lottie\toggle.json" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
