<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:presto="https://github.com/stevemonaco/MonacoLabs.Presto"
             xmlns:local="using:MonacoLabs.Presto.Tests"
             x:Class="MonacoLabs.Presto.Tests.ConnectedXamlView"
             x:DataType="local:ConnectedXamlViewModel">
  <Panel>
    <Border x:Name="Photo" Background="Red" Width="40" Height="20" HorizontalAlignment="Left" VerticalAlignment="Top"
            Margin="{Binding PhotoMargin}"
            presto:Connected.Key="{Binding Id, StringFormat=photo-{0}}"
            presto:Connected.Motion="{x:Static local:ConnectedRecipes.Held}" />
    <Border x:Name="Caption" Background="Lime" Width="40" Height="20" HorizontalAlignment="Left" VerticalAlignment="Top"
            Margin="100,20,0,0"
            presto:Connected.Anchor="{Binding Id, StringFormat=photo-{0}}" />
  </Panel>
</UserControl>
