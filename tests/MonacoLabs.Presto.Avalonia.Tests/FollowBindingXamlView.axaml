<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:MonacoLabs.Presto.Tests"
             x:Class="MonacoLabs.Presto.Tests.FollowBindingXamlView"
             x:DataType="local:LevelViewModel"
             MinWidth="33">
  <UserControl.Resources>
    <DataTemplate x:Key="Row" x:DataType="local:LevelViewModel">
      <Border Height="20" Width="{local:Probe {Binding Level}}" />
    </DataTemplate>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="Border.styled">
      <Setter Property="Width" Value="7" />
    </Style>
    <Style Selector="Border.setter" x:DataType="local:LevelViewModel">
      <Setter Property="Height" Value="{local:Probe {Binding Level}}" />
    </Style>
  </UserControl.Styles>
  <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top">
    <Slider x:Name="Source" Minimum="0" Maximum="100" Value="30" />
    <Border x:Name="Plain" Classes="styled" Height="4" Width="{local:Probe {Binding Level}}" />
    <Border x:Name="Reflected" Height="4" Width="{local:Probe {ReflectionBinding Level}}" />
    <Border x:Name="Converted" Height="4" Width="{local:Probe {Binding Level, Converter={x:Static local:Doubler.Instance}}}" />
    <Border x:Name="Fallback" Height="4" Width="{local:Probe {Binding Child.Level, FallbackValue=12}}" />
    <Border x:Name="Named" Height="4" Width="{local:Probe {Binding #Source.Value}}" />
    <Border x:Name="Ancestor" Height="4" Width="{local:Probe {Binding MinWidth, RelativeSource={RelativeSource AncestorType=UserControl}}}" />
    <Border x:Name="Setter" Classes="setter" Width="4" />
    <Border x:Name="Outer" Height="4">
      <Border x:Name="Inner" Height="4" Width="{local:Probe {Binding Level}}" />
    </Border>
    <ContentControl x:Name="Templated" MinHeight="44">
      <ContentControl.Template>
        <ControlTemplate TargetType="ContentControl">
          <StackPanel>
            <Border x:Name="PART_Bare" Height="4" Width="{Binding MinHeight, RelativeSource={RelativeSource TemplatedParent}}" />
            <Border x:Name="PART_Relative" Height="4" Width="{local:Probe {Binding MinHeight, RelativeSource={RelativeSource TemplatedParent}}}" />
            <Border x:Name="PART_TemplateBinding" Height="4" Width="{local:Probe {TemplateBinding MinHeight}}" />
          </StackPanel>
        </ControlTemplate>
      </ContentControl.Template>
    </ContentControl>
  </StackPanel>
</UserControl>
